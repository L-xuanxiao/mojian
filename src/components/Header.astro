---
/*
 * 导航图标取自 Lucide（项目既有图标库，React 岛屿同款视觉源）。
 * Header 为纯静态展示，按 AGENTS.md 不引入 React，故将图标路径内联为构建期 SVG。
 */
import { navItems, withBase } from '../site.config';

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
const homePath = withBase('/');
const isHome = pathname === homePath || pathname === homePath.replace(/\/$/, '');
const navigation = navItems.map((item) => {
  const href = withBase(item.href);
  return { ...item, href, active: item.href === '/' ? isHome : isActive(href) };
});
const currentItem = navigation.find((item) => item.active) ?? { ...navigation[0], label: '卷目' };
---

<header class="site-header sticky top-0 z-40" data-site-header data-home={isHome || undefined}>
  <div
    class="site-header__bar mx-auto flex max-w-stage items-center gap-4 px-5 py-4 md:px-8 lg:px-10"
  >
    <a
      href={withBase('/')}
      class="brand group shrink-0 text-ink no-underline"
      aria-label="墨笺首页"
    >
      <span class="brand__seal" aria-hidden="true">墨</span>
      <span class="brand__name font-display">墨笺</span>
      <span class="brand__edition" aria-hidden="true">
        <span class="brand__latin">MOJIAN</span>
        {
          isHome && (
            <span class="chapter-readout" data-chapter-readout>
              <span class="chapter-readout__index" data-chapter-index>
                序
              </span>
              <span class="chapter-readout__title" data-chapter-title>
                卷首
              </span>
            </span>
          )
        }
      </span>
    </a>

    <div class="nav-rail nav-rail--desktop ml-auto min-w-0">
      <span class="nav-rail__track" aria-hidden="true">
        {isHome && <span class="nav-rail__marker" data-chapter-marker />}
      </span>
      <nav aria-label="主导航">
        <ul class="m-0 flex list-none items-center gap-5 overflow-x-auto p-0 md:gap-8">
          {
            navigation.map((item) => (
              <li class="shrink-0">
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={['nav-link', item.active && 'nav-link--active']}
                >
                  <svg
                    class="nav-link__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={item.icon}
                  />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <details class="mobile-nav ml-auto min-w-0" data-mobile-nav>
      <summary class="mobile-nav__summary" aria-label={`当前栏目：${currentItem.label}；主导航`}>
        <svg
          class="mobile-nav__current-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={currentItem.icon}
        />
        <span>{currentItem.label}</span>
        <svg
          class="mobile-nav__chevron"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>

      <nav class="mobile-nav__panel" aria-label="移动端主导航">
        <ul class="mobile-nav__grid">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={['mobile-nav__link', item.active && 'mobile-nav__link--active']}
                >
                  <svg
                    class="mobile-nav__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={item.icon}
                  />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <button
      id="theme-toggle"
      type="button"
      aria-label="切换昼夜主题"
      aria-pressed="false"
      class="theme-toggle inline-flex shrink-0 items-center justify-center p-2 text-ink-soft"
    >
      <span class="theme-toggle__box relative block">
        <span class="theme-glyph theme-glyph--day" aria-hidden="true">昼</span>
        <span class="theme-glyph theme-glyph--night" aria-hidden="true">夜</span>
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    border-top: 3px solid var(--ink);
    background: color-mix(in oklab, var(--paper-glass) 28%, transparent);
    backdrop-filter: blur(10px);
    transition:
      background-color 150ms var(--ease-ink),
      backdrop-filter 250ms var(--ease-ink);
  }

  /* 卷头副线：顶线之下 2px 的 1px 细线，合成书脊双线 */
  .site-header::before {
    content: '';
    position: absolute;
    top: 5px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--ink);
  }

  /* 卷头底线：常驻 1px 墨线，与顶部双线合抱成刊头框 */
  .site-header::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--ink) 0 18%,
      var(--cinnabar) 18% 21%,
      var(--line) 21% 100%
    );
  }

  .site-header.is-scrolled {
    background: var(--paper-glass);
    backdrop-filter: blur(18px) saturate(0.9);
  }

  .site-header.is-scrolled .brand__seal {
    background: var(--cinnabar);
    color: var(--paper);
    transform: rotate(0deg);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    view-transition-name: site-brand;
  }

  .brand__seal {
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cinnabar);
    color: var(--cinnabar);
    font-family: var(--font-ma-shan-zheng);
    font-size: 0.78rem;
    line-height: 1;
    transform: rotate(-3deg);
    transition: transform 250ms var(--ease-seal);
  }

  /* 触屏无真正悬停，位移类 hover 仅桌面细指针启用 */
  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand__seal {
      transform: rotate(0deg) scale(0.96);
    }

    .nav-link:hover {
      transform: translateY(-1px);
    }

    .nav-link:hover::after {
      transform: scaleX(1);
    }

    .theme-toggle:hover {
      transform: rotate(4deg);
    }
  }

  .brand__name {
    font-size: 1.3rem;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  /* 刊名侧栏固定占位；首页滚动后仅由英文刊名接棒为卷中坐标。 */
  .brand__edition {
    position: relative;
    overflow: hidden;
    width: 7.5rem;
    height: 1.15rem;
    margin-left: 0.1rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--line);
    line-height: 1;
  }

  .brand__latin,
  .chapter-readout {
    position: absolute;
    inset: 50% auto auto 0.7rem;
    white-space: nowrap;
    transform: translateY(-50%);
    transition:
      transform 250ms var(--ease-ink),
      opacity 150ms var(--ease-ink);
  }

  .brand__latin {
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.32em;
  }

  .chapter-readout {
    display: inline-flex;
    max-width: 6.8rem;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    opacity: 0;
    transform: translate(0.7rem, -50%);
  }

  .chapter-readout__index {
    color: var(--cinnabar);
    font-family: var(--font-ma-shan-zheng);
    font-size: 0.88rem;
  }

  .chapter-readout__title {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-header[data-home].is-scrolled .brand__latin {
    opacity: 0;
    transform: translate(-0.7rem, -50%);
  }

  .site-header[data-home].is-scrolled .chapter-readout {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .nav-rail {
    position: relative;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 1rem,
      black calc(100% - 1rem),
      transparent
    );
    padding-inline: 1rem;
  }

  /* 卷尺墨线横贯全部导航；首页朱砂目按整卷阅读进度连续行走。 */
  .nav-rail__track {
    position: absolute;
    right: 1rem;
    bottom: 0.1rem;
    left: 1rem;
    height: 1px;
    background: var(--line);
    pointer-events: none;
  }

  .nav-rail__track::before,
  .nav-rail__track::after {
    content: '';
    position: absolute;
    bottom: -0.18rem;
    width: 1px;
    height: 0.38rem;
    background: var(--ink-soft);
  }

  .nav-rail__track::before {
    left: 0;
  }

  .nav-rail__track::after {
    right: 0;
  }

  .nav-rail__marker {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--cinnabar);
    box-shadow: 0 0.16rem 0.45rem color-mix(in oklab, var(--cinnabar) 34%, transparent);
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
  }

  .nav-rail ul {
    scrollbar-width: none;
  }

  /* 导航分隔收成卷尺刻线，朱砂只留给沿线移动的当前位置。 */
  .nav-rail li {
    position: relative;
  }

  .nav-rail li + li::before {
    content: '';
    position: absolute;
    bottom: 0.1rem;
    left: calc(-0.625rem - 0.5px);
    width: 1px;
    height: 0.38rem;
    background: var(--ink-soft);
    opacity: 0.55;
  }

  @media (min-width: 768px) {
    .nav-rail li + li::before {
      left: calc(-1rem - 0.5px);
    }
  }

  .nav-rail ul::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition:
      transform 150ms var(--ease-ink),
      color 150ms var(--ease-ink);
  }

  .nav-link__icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    transition:
      color 150ms var(--ease-ink),
      transform 250ms var(--ease-seal);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.15rem;
    left: 0;
    height: 1px;
    background: var(--cinnabar);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 250ms var(--ease-ink);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--ink);
  }

  /* 当前页：图标落朱砂，即「当前位置」标记，不再常驻下划线 */
  .nav-link--active .nav-link__icon {
    color: var(--cinnabar);
    transform: scale(1.16) rotate(-3deg);
  }

  .nav-link--active::after {
    height: 2px;
    transform: scaleX(1);
  }

  .mobile-nav {
    display: none;
  }

  .theme-toggle {
    border: none;
    background: transparent;
    cursor: pointer;
    transition: transform 160ms var(--ease-ink);
  }

  /* 昼夜印钮：一方小印，内嵌「昼 / 夜」单字交叉淡入 */
  .theme-toggle__box {
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line);
    transition: border-color 150ms var(--ease-ink);
  }

  .theme-toggle:hover .theme-toggle__box {
    border-color: var(--ink-soft);
  }

  .theme-toggle:active {
    transform: scale(0.97);
  }

  .theme-glyph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cinnabar);
    font-family: var(--font-ma-shan-zheng);
    font-size: 0.95rem;
    line-height: 1;
    transition:
      transform 250ms var(--ease-seal),
      opacity 250ms var(--ease-seal);
  }

  /* View Transition 截取新主题终态，避免字形自身过渡被截在中间帧。 */
  :global(:root.is-theme-transitioning) .theme-glyph {
    transition: none;
  }

  .theme-glyph--night {
    opacity: 0;
    transform: rotate(180deg) scale(0.5);
  }

  :global(html[data-theme='dark']) .theme-glyph--day {
    opacity: 0;
    transform: rotate(180deg) scale(0.5);
  }

  :global(html[data-theme='dark']) .theme-glyph--night {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .theme-glyph--day {
      opacity: 0;
      transform: rotate(180deg) scale(0.5);
    }

    :global(html:not([data-theme='light'])) .theme-glyph--night {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  @media (max-width: 639px) {
    .site-header__bar {
      gap: 0.75rem;
    }

    .brand__seal,
    .brand__latin,
    .site-header:not([data-home]) .brand__edition {
      display: none;
    }

    .brand {
      position: relative;
      width: 3rem;
      min-height: 2.75rem;
      justify-content: center;
    }

    .brand__name {
      font-size: 1rem;
      transform: translateY(-0.28rem);
    }

    .site-header[data-home] .brand__edition {
      position: absolute;
      /* 左向外扩：0.62rem 档位下「序号+章名」约 54px，超出 3rem 刊名区，借页缘内边距容纳 */
      inset: auto -0.75rem 0.32rem;
      width: auto;
      height: 0.65rem;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .chapter-readout {
      inset: 50% auto auto 50%;
      max-width: min(4rem, 22vw);
      gap: 0.18rem;
      font-size: 0.62rem;
      letter-spacing: 0;
      transform: translate(0.35rem, -50%);
    }

    .chapter-readout__index {
      font-size: 0.68rem;
    }

    .site-header[data-home].is-scrolled .chapter-readout {
      transform: translate(-50%, -50%);
    }

    .nav-rail--desktop {
      display: none;
    }

    .mobile-nav {
      display: block;
      width: min(9rem, 100%);
      max-width: 9rem;
      flex: 1 1 auto;
    }

    .mobile-nav__summary {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      gap: 0.45rem;
      padding-inline: 0.65rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      cursor: pointer;
      font-family: var(--font-noto-sans);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      list-style: none;
      transition:
        border-color 150ms var(--ease-ink),
        color 150ms var(--ease-ink);
    }

    .mobile-nav__summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav[open] .mobile-nav__summary {
      border-color: var(--ink-soft);
    }

    .mobile-nav__current-icon,
    .mobile-nav__icon,
    .mobile-nav__chevron {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
    }

    .mobile-nav__current-icon {
      color: var(--cinnabar);
      transform: rotate(-3deg);
    }

    .mobile-nav__chevron {
      margin-inline-start: auto;
      color: var(--ink-soft);
      transition: transform 160ms var(--ease-ink);
    }

    .mobile-nav[open] .mobile-nav__chevron {
      transform: rotate(180deg);
    }

    /* 卷目纸笺悬于页眉之下，覆盖正文而不改变页面流。 */
    .mobile-nav__panel {
      position: absolute;
      z-index: 1;
      top: calc(100% - 1px);
      right: 0;
      left: 0;
      padding: 0.55rem 1.25rem 0.75rem;
      border-block: 1px solid var(--line);
      background: var(--paper-glass);
      box-shadow: 0 18px 48px color-mix(in oklab, var(--ink) 8%, transparent);
      backdrop-filter: blur(18px) saturate(0.9);
    }

    .mobile-nav[open] .mobile-nav__panel {
      animation: mobile-nav-open 160ms var(--ease-ink) both;
    }

    .mobile-nav[data-closing] .mobile-nav__panel {
      animation: mobile-nav-close 110ms var(--ease-ink) both;
    }

    .mobile-nav__grid {
      display: grid;
      margin: 0;
      padding: 0;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      list-style: none;
    }

    .mobile-nav__grid > li {
      min-width: 0;
    }

    .mobile-nav__grid > li:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }

    .mobile-nav__grid > li:not(:nth-child(3n + 1)) {
      border-left: 1px solid var(--line);
    }

    .mobile-nav__link {
      position: relative;
      display: flex;
      min-height: 3rem;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.5rem 0.35rem;
      color: var(--ink-soft);
      font-family: var(--font-noto-sans);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-decoration: none;
      transition:
        color 150ms var(--ease-ink),
        background-color 150ms var(--ease-ink);
    }

    .mobile-nav__link::after {
      content: '';
      position: absolute;
      right: 28%;
      bottom: 0.32rem;
      left: 28%;
      height: 1px;
      background: var(--cinnabar);
      opacity: 0;
      transform: scaleX(0.5);
      transition:
        transform 160ms var(--ease-ink),
        opacity 150ms var(--ease-ink);
    }

    .mobile-nav__link--active {
      color: var(--ink);
    }

    .mobile-nav__link--active .mobile-nav__icon {
      color: var(--cinnabar);
      transform: scale(1.12) rotate(-3deg);
    }

    .mobile-nav__link--active::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
    }
  }

  @keyframes mobile-nav-open {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mobile-nav-close {
    from {
      opacity: 1;
      transform: translateY(0);
    }

    to {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__seal,
    .brand__edition,
    .brand__latin,
    .chapter-readout,
    .nav-link,
    .nav-link::after,
    .nav-link__icon,
    .mobile-nav__summary,
    .mobile-nav__chevron,
    .mobile-nav__link,
    .mobile-nav__link::after,
    .site-header::after,
    .nav-rail__marker,
    .theme-toggle,
    .theme-toggle__box,
    .theme-glyph {
      transition: none;
    }

    .mobile-nav[open] .mobile-nav__panel,
    .mobile-nav[data-closing] .mobile-nav__panel {
      animation: none;
    }

    .site-header {
      transition: background-color 150ms var(--ease-ink);
    }

    .brand:hover .brand__seal {
      transform: rotate(-3deg);
    }

    .nav-link:hover,
    .theme-toggle:hover,
    .theme-toggle:active {
      transform: none;
    }

    .nav-link::after {
      opacity: 0;
      transform: scaleX(1);
      transition: opacity 150ms var(--ease-ink);
    }

    .nav-link:hover::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .nav-rail__marker {
      display: none;
    }
  }
</style>

<script>
  import { resolveTheme } from '../scripts/theme';

  (() => {
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!button) return;

    let transitionId = 0;

    let requestedTheme = resolveTheme();

    const sync = () => button.setAttribute('aria-pressed', String(resolveTheme() === 'dark'));

    const applyTheme = (next: 'dark' | 'light') => {
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // 隐私模式等环境可能禁用存储；主题本身仍应即时生效。
      }
      sync();
    };

    const clearTransition = (id: number) => {
      if (id !== transitionId) return;
      root.classList.remove('is-theme-transitioning');
      root.style.removeProperty('--theme-x');
      root.style.removeProperty('--theme-y');
      root.style.removeProperty('--theme-radius');
    };

    const requestTheme = (instant: boolean) => {
      const next = requestedTheme === 'dark' ? 'light' : 'dark';
      requestedTheme = next;
      const id = ++transitionId;
      const startViewTransition = document.startViewTransition?.bind(document);

      if (reducedMotion.matches || instant || !startViewTransition) {
        clearTransition(id);
        applyTheme(next);
        return;
      }

      const bounds = button.getBoundingClientRect();
      const x = bounds.left + bounds.width / 2;
      const y = bounds.top + bounds.height / 2;
      const radius =
        Math.ceil(
          Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y)),
        ) + 1;

      root.style.setProperty('--theme-x', `${x}px`);
      root.style.setProperty('--theme-y', `${y}px`);
      root.style.setProperty('--theme-radius', `${radius}px`);
      root.classList.add('is-theme-transitioning');

      try {
        const transition = startViewTransition(() => {
          if (id === transitionId) applyTheme(next);
        });
        transition.finished.then(
          () => clearTransition(id),
          () => {
            // 浏览器中止或更新回调异常时，确保最终主题仍与最后一次点击一致。
            if (id === transitionId) applyTheme(next);
            clearTransition(id);
          },
        );
      } catch {
        clearTransition(id);
        applyTheme(next);
      }
    };

    button.addEventListener('click', (event) => {
      requestTheme(event.detail === 0);
    });

    root.addEventListener('click', (event) => {
      if (!root.classList.contains('is-theme-transitioning') || event.target !== root) return;
      const bounds = button.getBoundingClientRect();
      const hitButton =
        event.clientX >= bounds.left &&
        event.clientX <= bounds.right &&
        event.clientY >= bounds.top &&
        event.clientY <= bounds.bottom;

      // Chromium 的换纸快照会把连点重定向到 html；仅在印钮原坐标补接该次指针输入。
      if (hitButton) requestTheme(false);
    });

    media.addEventListener('change', () => {
      if (!localStorage.getItem('theme')) {
        requestedTheme = resolveTheme();
        sync();
      }
    });

    sync();
  })();
</script>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const mobileNav = header.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
    if (mobileNav) {
      const summary = mobileNav.querySelector<HTMLElement>('summary');
      const desktopViewport = window.matchMedia('(min-width: 640px)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer !== undefined) window.clearTimeout(closeTimer);
        closeTimer = undefined;
        mobileNav.removeAttribute('data-closing');
      };

      const finishClose = (restoreFocus: boolean) => {
        cancelClose();
        mobileNav.open = false;
        if (restoreFocus) summary?.focus();
      };

      const closeMenu = (restoreFocus = false, instant = reducedMotion.matches) => {
        if (!mobileNav.open) return;
        if (instant) {
          finishClose(restoreFocus);
          return;
        }
        if (mobileNav.hasAttribute('data-closing')) return;

        mobileNav.setAttribute('data-closing', '');
        closeTimer = window.setTimeout(() => finishClose(restoreFocus), 110);
      };

      summary?.addEventListener('click', (event) => {
        if (!mobileNav.open) return;
        event.preventDefault();
        if (mobileNav.hasAttribute('data-closing')) {
          // 收卷途中再次点击视为撤销关闭，避免快速操作留下半透明面板。
          cancelClose();
          return;
        }
        closeMenu();
      });

      document.addEventListener('pointerdown', (event) => {
        if (mobileNav.open && event.target instanceof Node && !mobileNav.contains(event.target)) {
          closeMenu();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !mobileNav.open) return;
        event.preventDefault();
        closeMenu(true);
      });

      desktopViewport.addEventListener('change', (event) => {
        if (event.matches) closeMenu(false, true);
      });
    }

    const track = header.querySelector<HTMLElement>('.nav-rail__track');
    const marker = header.querySelector<HTMLElement>('[data-chapter-marker]');
    const indexLabel = header.querySelector<HTMLElement>('[data-chapter-index]');
    const titleLabel = header.querySelector<HTMLElement>('[data-chapter-title]');
    let frame = 0;
    let layoutFrame = 0;
    let chapterAnchors: number[] = [];
    let trackWidth = 0;
    const fallbackTitles: Record<string, string> = {
      卷: '卷首',
      壹: '此间近况',
      贰: '器作',
      叁: '山水长卷',
      肆: '近来所记',
      伍: '光影集',
      陆: '卷尾年谱',
    };

    // 首页章节由各 section 的 data-home-chapter 声明；标题优先复用 aria-labelledby 的真实文本。
    const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-home-chapter]')).map(
      (section) => {
        const labelledBy = section.getAttribute('aria-labelledby');
        const labelledElement = labelledBy ? document.getElementById(labelledBy) : null;
        return {
          element: section,
          index: section.dataset.homeChapter ?? '',
          title:
            section.dataset.homeChapterTitle ??
            labelledElement?.textContent?.trim() ??
            fallbackTitles[section.dataset.homeChapter ?? ''] ??
            '',
        };
      },
    );

    const syncHeader = () => {
      frame = 0;
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      if (!marker || chapterAnchors.length === 0) return;

      const readingLine = window.scrollY + Math.min(window.innerHeight * 0.36, 320);
      const lastIndex = chapters.length - 1;
      let active = -1;

      for (let index = 0; index <= lastIndex; index += 1) {
        if (readingLine >= chapterAnchors[index]) active = index;
      }

      let progress = 0;
      if (active >= 0 && lastIndex > 0) {
        if (active >= lastIndex) {
          progress = 1;
        } else {
          const start = chapterAnchors[active];
          const end = chapterAnchors[active + 1];
          const localProgress = end > start ? (readingLine - start) / (end - start) : 0;
          progress = (active + Math.min(Math.max(localProgress, 0), 1)) / lastIndex;
        }
      }

      marker.style.transform = `translate3d(calc(${progress * trackWidth}px - 50%), -50%, 0)`;
      const chapter = active >= 0 ? chapters[active] : null;
      if (indexLabel) indexLabel.textContent = chapter?.index || '序';
      if (titleLabel) titleLabel.textContent = chapter?.title || '卷首';
    };

    const requestSync = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(syncHeader);
    };

    // 章节坐标只在版式发生变化时测量；滚动帧只消费缓存，避免连续强制布局。
    const measureLayout = () => {
      layoutFrame = 0;
      const scrollY = window.scrollY;
      chapterAnchors = chapters.map(
        (chapter) => chapter.element.getBoundingClientRect().top + scrollY,
      );
      trackWidth = track?.getBoundingClientRect().width ?? 0;
      requestSync();
    };

    const requestMeasure = () => {
      if (layoutFrame) return;
      layoutFrame = window.requestAnimationFrame(measureLayout);
    };

    window.addEventListener('scroll', requestSync, { passive: true });
    window.addEventListener('resize', requestMeasure, { passive: true });
    window.addEventListener('load', requestMeasure, { once: true });
    document.fonts?.ready.then(requestMeasure);

    if ('ResizeObserver' in window) {
      const layoutObserver = new ResizeObserver(requestMeasure);
      layoutObserver.observe(document.body);
    }

    measureLayout();
  }
</script>
