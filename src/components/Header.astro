---
// 主导航：路由依据规划文档固定，全线静态页面
const navItems = [
  { href: '/journal/', label: '笺录' },
  { href: '/projects/', label: '器作' },
  { href: '/gallery/', label: '光影' },
  { href: '/about/', label: '此间' },
  { href: '/guestbook/', label: '留墨' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <!-- 底边中央山形微饰：与 Divider 同源，半压墨线；bg-paper 衬底遮出线的中断，取装裱绫边之意 -->
  <svg
    class="absolute bottom-0 left-1/2 h-[10px] w-[24px] -translate-x-1/2 translate-y-1/2 bg-paper px-[3px]"
    viewBox="0 0 48 20"
    fill="none"
    stroke="var(--bronze)"
    stroke-width="1.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2 16 L12 5 L19 13 L27 3 L36 14 L46 6"></path>
    <circle cx="41" cy="15" r="1" fill="var(--bronze)" stroke="none"></circle>
  </svg>
  <div class="mx-auto flex max-w-content items-center gap-4 px-5 py-4 md:px-8">
    <a href="/" class="font-display text-xl leading-none text-ink no-underline">墨笺</a>

    <nav aria-label="主导航" class="ml-auto min-w-0">
      <!-- 移动端允许横向滚动，避免挤压站点名与切换钮 -->
      <ul
        class="m-0 flex list-none items-center justify-end gap-5 overflow-x-auto p-0 text-sm whitespace-nowrap md:gap-7"
      >
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink-soft no-underline transition-colors duration-150 hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="theme-toggle"
      type="button"
      aria-label="切换昼夜主题"
      aria-pressed="false"
      class="theme-toggle inline-flex shrink-0 items-center justify-center rounded-sm p-1.5 text-ink-soft transition-colors duration-150 hover:text-ink"
    >
      <!-- display 无法过渡，双图标改为绝对定位叠放，用 opacity + rotate/scale 形变切换 -->
      <span class="relative block h-[18px] w-[18px]">
        <!-- 日：当前为昼 -->
        <svg
          class="icon-sun absolute inset-0"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.5"></circle>
          <path
            d="M12 2.5v2.5M12 19v2.5M2.5 12h2.5M19 12h2.5M5 5l1.8 1.8M17.2 17.2 19 19M19 5l-1.8 1.8M6.8 17.2 5 19"
          ></path>
        </svg>
        <!-- 月：当前为夜 -->
        <svg
          class="icon-moon absolute inset-0"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5Z"></path>
        </svg>
      </span>
    </button>
  </div>
</header>

<style>
  /* 图标随主题切换：昼示日、夜示月。隐藏图标退到 rotate(180°) + scale(0.5)，
     与显隐同步过渡；由 CSS 驱动，无 JS 时也能直达最终态 */
  .theme-toggle svg {
    transition:
      transform 0.4s var(--ease-seal),
      opacity 0.4s var(--ease-seal);
  }

  .theme-toggle .icon-moon {
    opacity: 0;
    transform: rotate(180deg) scale(0.5);
  }

  :global(html[data-theme='dark']) .theme-toggle .icon-sun {
    opacity: 0;
    transform: rotate(180deg) scale(0.5);
  }

  :global(html[data-theme='dark']) .theme-toggle .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .theme-toggle .icon-sun {
      opacity: 0;
      transform: rotate(180deg) scale(0.5);
    }

    :global(html:not([data-theme='light'])) .theme-toggle .icon-moon {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }
</style>

<script is:inline>
  // 昼夜切换：localStorage('theme') 优先；无存储时跟随系统，并监听系统主题变化
  (() => {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    if (!btn) return;

    const current = () => {
      const t = root.dataset.theme;
      return t === 'dark' || t === 'light' ? t : media.matches ? 'dark' : 'light';
    };

    const sync = () => btn.setAttribute('aria-pressed', String(current() === 'dark'));

    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
      sync();
    });

    // 仅在未手动选择时跟随系统：视觉由媒体查询自动处理，此处同步按钮状态
    media.addEventListener('change', () => {
      if (!localStorage.getItem('theme')) sync();
    });

    sync();
  })();
</script>

<script>
  // 头栏动效：① 载入自上方滑入；② 滚动方向隐现。reduced-motion 时不创建任何动画，头栏常驻
  import { gsap, lenis, prefersReducedMotion } from '../scripts/scroll';
  import { CustomEase } from 'gsap/CustomEase';

  if (!prefersReducedMotion) {
    // GSAP 核心不解析 cubic-bezier 字符串，注册内置的 CustomEase 以复用设计令牌 ease-ink
    gsap.registerPlugin(CustomEase);
    const easeInk = CustomEase.create('ease-ink', '0.22, 1, 0.36, 1');

    const header = document.querySelector('header');
    if (header) {
      // 初始隐藏态只由 JS 设置（from 立即渲染），无 JS 时头栏完整可见
      gsap.from(header, { yPercent: -100, duration: 0.6, ease: easeInk });

      // 向下滚动超过 100px 隐藏，向上回滚即显示；overwrite 防止与载入滑入打架
      let hidden = false;
      let lastY = window.scrollY;
      const setHidden = (next: boolean) => {
        if (next === hidden) return;
        hidden = next;
        gsap.to(header, {
          yPercent: next ? -100 : 0,
          duration: 0.3,
          ease: easeInk,
          overwrite: 'auto',
        });
      };
      const onScroll = (y: number) => {
        if (y > lastY && y > 100) setHidden(true);
        else if (y < lastY) setHidden(false);
        lastY = y;
      };

      // 优先挂 Lenis 滚动帧（此时 lenis 恒存在）；window scroll 仅作 null 兜底
      if (lenis) {
        lenis.on('scroll', ({ scroll }: { scroll: number }) => onScroll(scroll));
      } else {
        window.addEventListener('scroll', () => onScroll(window.scrollY), { passive: true });
      }
    }
  }
</script>
