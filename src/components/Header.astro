---
/*
 * 导航图标取自 Lucide（项目既有图标库，React 岛屿同款视觉源）。
 * Header 为纯静态展示，按 AGENTS.md 不引入 React，故将图标路径内联为构建期 SVG。
 */
import { withBase } from '../site.config';

const navItems = [
  {
    href: withBase('/journal/'),
    label: '笺录',
    icon: '<path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/>',
  },
  {
    href: withBase('/projects/'),
    label: '器作',
    icon: '<path d="m12.99 6.74l1.93 3.44M19.136 12a10 10 0 0 1-14.271 0M21 21l-2.16-3.84M3 21l8.02-14.26"/><circle cx="12" cy="5" r="2"/>',
  },
  {
    href: withBase('/gallery/'),
    label: '光影',
    icon: '<circle cx="12" cy="12" r="10"/><path d="m14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83m13.79-4l-5.74 9.94"/>',
  },
  {
    href: withBase('/about/'),
    label: '此间',
    icon: '<path d="m8 3l4 8l5-5l5 15H2z"/>',
  },
  {
    href: withBase('/guestbook/'),
    label: '留墨',
    icon: '<path d="M14.086 18.412A2 2 0 0 1 12.67 19H5v-7.672a2 2 0 0 1 .586-1.414L11.75 3.75a6 6 0 1 1 8.49 8.49zM16 8L2 22m15.488-7H9"/>',
  },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<header class="site-header sticky top-0 z-40" data-site-header>
  <div class="mx-auto flex max-w-stage items-center gap-4 px-5 py-4 md:px-8 lg:px-10">
    <a
      href={withBase('/')}
      class="brand group shrink-0 text-ink no-underline"
      aria-label="墨笺首页"
    >
      <span class="brand__seal" aria-hidden="true">墨</span>
      <span class="brand__name font-display">墨笺</span>
      <span class="brand__latin" aria-hidden="true">MOJIAN</span>
    </a>

    <div class="nav-rail ml-auto min-w-0">
      <nav aria-label="主导航">
        <ul class="m-0 flex list-none items-center gap-5 overflow-x-auto p-0 md:gap-8">
          {
            navItems.map((item) => {
              const active = isActive(item.href);
              return (
                <li class="shrink-0">
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={['nav-link', active && 'nav-link--active']}
                  >
                    <svg
                      class="nav-link__icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={item.icon}
                    />
                    <span>{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <button
      id="theme-toggle"
      type="button"
      aria-label="切换昼夜主题"
      aria-pressed="false"
      class="theme-toggle inline-flex shrink-0 items-center justify-center p-2 text-ink-soft"
    >
      <span class="theme-toggle__box relative block">
        <span class="theme-glyph theme-glyph--day" aria-hidden="true">昼</span>
        <span class="theme-glyph theme-glyph--night" aria-hidden="true">夜</span>
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    border-top: 3px solid var(--ink);
    background: color-mix(in oklab, var(--paper-glass) 20%, transparent);
    backdrop-filter: blur(10px);
  }

  /* 卷头副线：顶线之下 2px 的 1px 细线，合成书脊双线 */
  .site-header::before {
    content: '';
    position: absolute;
    top: 5px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--ink);
  }

  /* 卷头底线：常驻 1px 墨线，与顶部双线合抱成刊头框 */
  .site-header::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  .site-header.is-scrolled {
    background: var(--paper-glass);
    backdrop-filter: blur(18px) saturate(0.9);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    view-transition-name: site-brand;
  }

  .brand__seal {
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cinnabar);
    color: var(--cinnabar);
    font-family: var(--font-ma-shan-zheng);
    font-size: 0.78rem;
    line-height: 1;
    transform: rotate(-3deg);
    transition: transform 250ms var(--ease-seal);
  }

  /* 触屏无真正悬停，位移类 hover 仅桌面细指针启用 */
  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand__seal {
      transform: rotate(0deg) scale(0.96);
    }

    .nav-link:hover {
      transform: translateY(-1px);
    }

    .nav-link:hover::after {
      transform: scaleX(1);
    }

    .theme-toggle:hover {
      transform: rotate(4deg);
    }
  }

  .brand__name {
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  /* 刊名拉丁小字：细线隔开，呼应 Hero 与卷尾的 folio 行 */
  .brand__latin {
    margin-left: 0.1rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--line);
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    line-height: 1;
  }

  .nav-rail {
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 1rem,
      black calc(100% - 1rem),
      transparent
    );
    padding-inline: 1rem;
  }

  .nav-rail ul {
    scrollbar-width: none;
  }

  /* 目录砂目：导航项之间落 4px 朱砂圆点，取卷中句读之意 */
  .nav-rail li {
    position: relative;
  }

  .nav-rail li + li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(-0.625rem - 2px);
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--cinnabar);
  }

  @media (min-width: 768px) {
    .nav-rail li + li::before {
      left: calc(-1rem - 2px);
    }
  }

  .nav-rail ul::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition:
      transform 150ms var(--ease-ink),
      color 150ms var(--ease-ink);
  }

  .nav-link__icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    transition: color 150ms var(--ease-ink);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.15rem;
    left: 0;
    height: 1px;
    background: var(--cinnabar);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 250ms var(--ease-ink);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--ink);
  }

  /* 当前页：图标落朱砂，即「当前位置」标记，不再常驻下划线 */
  .nav-link--active .nav-link__icon {
    color: var(--cinnabar);
  }

  .theme-toggle {
    border: none;
    background: transparent;
    cursor: pointer;
    transition: transform 160ms var(--ease-ink);
  }

  /* 昼夜印钮：一方小印，内嵌「昼 / 夜」单字交叉淡入 */
  .theme-toggle__box {
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line);
    transition: border-color 150ms var(--ease-ink);
  }

  .theme-toggle:hover .theme-toggle__box {
    border-color: var(--ink-soft);
  }

  .theme-toggle:active {
    transform: scale(0.97);
  }

  .theme-glyph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cinnabar);
    font-family: var(--font-ma-shan-zheng);
    font-size: 0.95rem;
    line-height: 1;
    transition:
      transform 250ms var(--ease-seal),
      opacity 250ms var(--ease-seal);
  }

  /* View Transition 截取新主题终态，避免字形自身过渡被截在中间帧。 */
  :global(:root.is-theme-transitioning) .theme-glyph {
    transition: none;
  }

  .theme-glyph--night {
    opacity: 0;
    transform: rotate(180deg) scale(0.5);
  }

  :global(html[data-theme='dark']) .theme-glyph--day {
    opacity: 0;
    transform: rotate(180deg) scale(0.5);
  }

  :global(html[data-theme='dark']) .theme-glyph--night {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .theme-glyph--day {
      opacity: 0;
      transform: rotate(180deg) scale(0.5);
    }

    :global(html:not([data-theme='light'])) .theme-glyph--night {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  @media (max-width: 639px) {
    .brand__seal,
    .brand__latin {
      display: none;
    }

    .brand__name {
      font-size: 1rem;
    }

    .nav-rail {
      margin-inline-start: 0.25rem;
      padding-inline: 0.5rem;
      /* 窄屏 mask 渐隐收窄，让末项半隐可见，作为可横滑提示 */
      mask-image: linear-gradient(
        90deg,
        transparent,
        black 0.5rem,
        black calc(100% - 0.5rem),
        transparent
      );
    }

    /* 窄屏压缩间距：五项尽量完整入视口（390 下末项半隐），余量由横滑兜底 */
    .nav-rail ul {
      gap: 0.55rem;
    }

    .nav-rail li + li::before {
      left: calc(-0.275rem - 1.5px);
      width: 3px;
      height: 3px;
      margin-top: -1.5px;
    }

    .nav-link {
      min-height: 2.75rem;
      gap: 0.3rem;
      padding-block: 0;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
    }

    .nav-link__icon {
      width: 14px;
      height: 14px;
    }

    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__seal,
    .nav-link,
    .nav-link::after,
    .nav-link__icon,
    .site-header::after,
    .theme-toggle,
    .theme-toggle__box,
    .theme-glyph {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!button) return;

    let transitionId = 0;

    const current = () => {
      const theme = root.dataset.theme;
      return theme === 'dark' || theme === 'light' ? theme : media.matches ? 'dark' : 'light';
    };

    let requestedTheme = current();

    const sync = () => button.setAttribute('aria-pressed', String(current() === 'dark'));

    const applyTheme = (next) => {
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // 隐私模式等环境可能禁用存储；主题本身仍应即时生效。
      }
      sync();
    };

    const clearTransition = (id) => {
      if (id !== transitionId) return;
      root.classList.remove('is-theme-transitioning');
      root.style.removeProperty('--theme-x');
      root.style.removeProperty('--theme-y');
      root.style.removeProperty('--theme-radius');
    };

    button.addEventListener('click', () => {
      const next = requestedTheme === 'dark' ? 'light' : 'dark';
      requestedTheme = next;
      const id = ++transitionId;
      const startViewTransition = document.startViewTransition?.bind(document);

      if (reducedMotion.matches || !startViewTransition) {
        clearTransition(id);
        applyTheme(next);
        return;
      }

      const bounds = button.getBoundingClientRect();
      const x = bounds.left + bounds.width / 2;
      const y = bounds.top + bounds.height / 2;
      const radius =
        Math.ceil(
          Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y)),
        ) + 1;

      root.style.setProperty('--theme-x', `${x}px`);
      root.style.setProperty('--theme-y', `${y}px`);
      root.style.setProperty('--theme-radius', `${radius}px`);
      root.classList.add('is-theme-transitioning');

      try {
        const transition = startViewTransition(() => {
          if (id === transitionId) applyTheme(next);
        });
        transition.finished.then(
          () => clearTransition(id),
          () => {
            // 浏览器中止或更新回调异常时，确保最终主题仍与最后一次点击一致。
            if (id === transitionId) applyTheme(next);
            clearTransition(id);
          },
        );
      } catch {
        clearTransition(id);
        applyTheme(next);
      }
    });

    media.addEventListener('change', () => {
      if (!localStorage.getItem('theme')) {
        requestedTheme = current();
        sync();
      }
    });

    sync();
  })();
</script>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const syncScrolled = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    window.addEventListener('scroll', syncScrolled, { passive: true });
    syncScrolled();
  }
</script>
