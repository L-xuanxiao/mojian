---
// 首页「书斋目录」：分类索引 + 小景画 + 笔意分隔线。样式自 index.astro 平移（scoped）。
import { Image } from 'astro:assets';
import { homeContent } from '../../config/homeContent';
import studyLotus from '../../assets/study-lotus.png';

const { study } = homeContent;

interface CategoryItem {
  key: string;
  slug: string;
  number: string;
  description: string;
}

interface Props {
  categories: readonly CategoryItem[];
  /** 分类 key → 已发布篇数 */
  counts: Map<string, number>;
}

const { categories, counts } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---

<section class="section study-index" aria-labelledby="study-title">
  <div class="shell study-grid">
    <div class="study-intro reveal">
      <div>
        <p class="section-kicker" data-font-role="hand">{study.kicker}</p>
        <h2 class="study-title" id="study-title" data-font-role="cal">{study.title}</h2>
        <p>{study.note}</p>
      </div>
      <div class="study-mini-painting" aria-hidden="true">
        <Image
          src={studyLotus}
          alt=""
          widths={[480, 720, 960]}
          sizes="(max-width: 620px) 100vw, (max-width: 820px) 260px, 330px"
          loading="lazy"
        />
      </div>
    </div>

    <nav class="index-list reveal" aria-label="内容分类">
      {categories.map((cat) => (
        <a class="index-item" href={`${BASE}category/${cat.slug}/`}>
          <span class="index-number">{cat.number}</span>
          <span class="index-name" data-font-role="cal">{cat.key}</span>
          <span class="index-desc">{cat.description}</span>
          <span class="index-count">{String(counts.get(cat.key) ?? 0).padStart(2, '0')} 篇</span>
        </a>
      ))}
    </nav>
  </div>
  <svg class="brush-divider" viewBox="0 0 960 42" preserveAspectRatio="none" aria-hidden="true">
    <path d="M10 23C132 19 228 26 346 21C470 15 592 28 726 20C814 15 888 20 950 17" fill="none" stroke="#485149" stroke-width="4" stroke-linecap="round" opacity=".42" />
    <path d="M75 27C222 25 344 31 486 25C620 20 733 27 861 23" fill="none" stroke="#485149" stroke-width="1" opacity=".35" />
  </svg>
</section>

<style>
  .study-index {
    background:
      linear-gradient(90deg, rgba(73, 81, 74, 0.025), transparent 30%, transparent 70%, rgba(73, 81, 74, 0.025)),
      rgba(250, 248, 242, 0.45);
    border-top: 1px solid rgba(82, 78, 69, 0.08);
    border-bottom: 1px solid rgba(82, 78, 69, 0.08);
  }

  .study-grid {
    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    gap: clamp(56px, 8vw, 112px);
    align-items: start;
  }

  .study-intro {
    position: sticky;
    top: 118px;
    padding-top: 12px;
  }

  .study-title {
    margin: 0;
    font-size: clamp(2.35rem, 4.7vw, 4rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.1em;
  }

  .study-intro > p:last-of-type {
    margin: 26px 0 0;
    color: var(--ink-soft);
    line-height: 2;
  }

  .study-mini-painting {
    position: relative;
    width: 100%;
    height: 190px;
    margin-top: 34px;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .study-mini-painting img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .index-list {
    border-top: 1px solid var(--line-strong);
  }

  .index-item {
    position: relative;
    display: grid;
    grid-template-columns: 60px minmax(150px, 0.48fr) minmax(220px, 1fr) 70px;
    align-items: center;
    gap: 24px;
    min-height: 118px;
    border-bottom: 1px solid var(--line);
    transition: color 240ms ease, transform 260ms var(--ease), background-color 240ms ease;
  }

  .index-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 28px;
    height: 1px;
    background: var(--cinnabar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease);
  }

  /* 触屏无假 hover：位移类 hover 仅在精确指针下启用 */
  @media (hover: hover) and (pointer: fine) {
    .index-item:hover {
      color: var(--moss-deep);
      background: linear-gradient(90deg, rgba(164, 68, 52, 0.035), transparent 42%);
      transform: translateX(6px);
    }

    .index-item:hover::before {
      transform: scaleX(1);
    }

    .index-item:hover .index-number {
      transform: translateX(32px);
    }
  }

  .index-number {
    color: var(--cinnabar);
    font-size: 0.88rem;
    letter-spacing: 0.12em;
    transition: transform 260ms var(--ease);
  }

  .index-name {
    font-size: clamp(1.28rem, 2vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .index-desc,
  .index-count {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .index-count {
    text-align: right;
  }

  .brush-divider {
    position: absolute;
    left: 50%;
    bottom: -14px;
    width: min(74vw, 960px);
    height: 42px;
    transform: translateX(-50%);
    opacity: 0.26;
    pointer-events: none;
  }

  /* ≥821px：home-layout 网格语境下的归属与覆盖 */
  @media (min-width: 821px) {
    :global(.home-layout) > .study-index {
      grid-area: study;
    }

    :global(.home-layout) .study-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    :global(.home-layout) .study-intro {
      position: static;
      padding-top: 0;
    }

    :global(.home-layout) .index-item {
      grid-template-columns: 30px minmax(0, 1fr) auto;
      gap: 8px 12px;
      min-height: 94px;
      padding: 16px 0;
    }

    :global(.home-layout) .index-desc {
      grid-column: 1 / -1;
      padding-left: 42px;
    }

    :global(.home-layout) .index-count {
      grid-column: 3;
      grid-row: 1;
    }

    :global(.home-layout) .brush-divider {
      width: 100%;
    }
  }

  /* ============ 夜色覆盖 ============ */
  :global(html[data-theme='night']) .study-index {
    background:
      linear-gradient(90deg, rgba(233, 226, 208, 0.02), transparent 30%, transparent 70%, rgba(233, 226, 208, 0.02)),
      rgba(33, 34, 29, 0.5);
    border-top-color: rgba(233, 226, 208, 0.09);
    border-bottom-color: rgba(233, 226, 208, 0.09);
  }

  :global(html[data-theme='night']) .study-mini-painting img {
    filter: brightness(0.82) saturate(0.85);
  }

  :global(html[data-theme='night']) .brush-divider path {
    stroke: #7d8577;
  }

  /* ============ 响应式 ============ */
  @media (max-width: 1080px) {
    .study-grid {
      grid-template-columns: 270px minmax(0, 1fr);
      gap: 56px;
    }

    .index-item {
      grid-template-columns: 46px minmax(130px, 0.55fr) minmax(170px, 1fr) 60px;
      gap: 18px;
    }
  }

  @media (max-width: 820px) {
    .study-grid {
      grid-template-columns: 1fr;
    }

    .study-intro {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 36px;
    }

    .study-mini-painting {
      height: 180px;
      margin-top: 0;
    }

    .index-item {
      grid-template-columns: 42px minmax(150px, 0.7fr) minmax(180px, 1fr) 58px;
    }
  }

  @media (max-width: 620px) {
    .study-intro {
      display: block;
    }

    .study-mini-painting {
      height: 150px;
      margin-top: 30px;
    }

    .index-item {
      grid-template-columns: 30px 1fr auto;
      gap: 10px 14px;
      min-height: 102px;
      padding: 18px 0;
    }

    .index-name {
      font-size: 1.28rem;
    }

    .index-desc {
      grid-column: 2 / 4;
      font-size: 0.8rem;
    }

    .index-count {
      grid-column: 3;
      grid-row: 1;
    }

    .index-item:hover {
      transform: none;
    }

    .index-item:hover .index-number {
      transform: none;
    }
  }
</style>
