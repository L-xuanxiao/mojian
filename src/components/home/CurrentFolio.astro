---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import { site } from '../../site.config';

// 演示数据：案头三事待主人按近况更新，条目即改即生效
const statusItems = [
  { text: '重构 mojian 站点', meta: '进行中' },
  { text: '读《天文之书》', meta: '案头' },
  { text: '整理去年的胶片照片', meta: '缓慢推进' },
];

const [journalEntries, projectEntries, galleryEntries] = await Promise.all([
  getCollection('journal', ({ data }) => !data.draft),
  getCollection('projects', ({ data }) => !data.draft),
  getCollection('gallery', ({ data }) => !data.draft),
]);

// 最近更新：自动取笺录最新文章的月份；无文章时不渲染该行
const latestPost = journalEntries.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)[0];
const latestUpdate = latestPost
  ? `${latestPost.data.pubDate.getFullYear()} 年 ${latestPost.data.pubDate.getMonth() + 1} 月`
  : '';

// 身份资料未填写时不臆造姓名或职业，改用构建期真实内容数量证明作者正在做什么
const identityName = site.profile.displayName || '墨笺作者';
const identityRole = site.profile.role;
const identityProof = site.profile.focus.length
  ? site.profile.focus.join(' · ')
  : `${journalEntries.length} 篇笺录 · ${projectEntries.length} 件器作 · ${galleryEntries.length} 帧光影`;
---

<section
  class="current-folio"
  aria-labelledby="current-folio"
  data-home-chapter="壹"
  data-ink-scene="paper"
>
  <div class="current-folio__inner mx-auto max-w-stage px-5 py-12 md:px-8 lg:px-10">
    <SectionHeading
      id="current-folio"
      title="此间近况"
      index="壹"
      note="PORTRAIT / NOW"
      mode="chapter"
    />

    <div class="current-folio__grid">
      <div class="current-folio__portrait">
        <p class="current-folio__lead" data-reveal-title>
          写字、写代码、拍照片。<br />在这里安放文章、作品与光影。
        </p>
        <p
          class="current-folio__identity"
          aria-label="作者身份与创作概况"
          data-reveal-group
          data-reveal-variant="spread"
        >
          <span class="current-folio__identity-name">{identityName}</span>
          {identityRole && <span>{identityRole}</span>}
          <span>{identityProof}</span>
        </p>
        <p class="current-folio__note">
          相信克制不是减少，而是让每一处存在都有缘由。如今正在把旧站重新装订成一册可以慢慢翻阅的数字书卷。
        </p>
        <span class="current-folio__inscription" aria-hidden="true">写字 · 造物 · 观照</span>
      </div>

      <aside class="current-folio__status" aria-label="正在做什么">
        <div class="current-folio__status-head">
          <p class="folio-label">案头三事</p>
          {/* 季节标记：手动维护，随案头三事一并更新 */}
          <span>2026 · 夏</span>
        </div>
        <ol class="m-0 list-none p-0" data-reveal-group data-reveal-variant="stagger">
          {
            statusItems.map((item, index) => (
              <li>
                <span class="current-folio__number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <p>{item.text}</p>
                  <span>{item.meta}</span>
                </div>
              </li>
            ))
          }
        </ol>
        {latestUpdate && <p class="current-folio__updated">最近更新：{latestUpdate}</p>}
      </aside>
    </div>
  </div>
</section>

<style>
  .current-folio {
    position: relative;
    overflow: clip;
  }

  .current-folio::before {
    content: '';
    position: absolute;
    top: 20%;
    right: -8%;
    bottom: 9%;
    left: 48%;
    background: color-mix(in oklab, var(--paper-deep) 62%, transparent);
    clip-path: polygon(7% 0, 100% 4%, 94% 100%, 0 94%);
    pointer-events: none;
  }

  .current-folio__inner {
    position: relative;
    isolation: isolate;
  }

  .current-folio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    min-height: clamp(22rem, 32vw, 26rem);
  }

  .current-folio__portrait {
    position: relative;
    z-index: 1;
    grid-column: 1 / span 9;
    grid-row: 1;
    min-height: clamp(20rem, 28vw, 24rem);
    padding: clamp(2.25rem, 3.5vw, 3rem) clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 4vw, 3.5rem)
      clamp(2.2rem, 6vw, 5rem);
    border-top: 2px solid var(--ink);
    background:
      linear-gradient(90deg, color-mix(in oklab, var(--ink) 8%, transparent) 1px, transparent 1px)
        clamp(1rem, 3vw, 2.5rem) 0 / 1px 100% no-repeat,
      color-mix(in oklab, var(--paper) 92%, var(--paper-deep));
    box-shadow: var(--shadow-lg);
    clip-path: polygon(0.5% 0, 99.5% 1.2%, 100% 96%, 97% 100%, 0 98.5%);
    transform: rotate(-0.55deg);
  }

  .current-folio__portrait::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(1rem, 3vw, 2.5rem);
    width: 0.35rem;
    border-inline: 1px solid color-mix(in oklab, var(--ink) 12%, transparent);
    opacity: 0.72;
    pointer-events: none;
  }

  .current-folio__lead {
    max-width: 14em;
    margin: 0;
    font-size: var(--type-title-section);
    line-height: 1.3;
    letter-spacing: 0.015em;
  }

  .current-folio__note {
    max-width: 34rem;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0 clamp(0rem, 5vw, 4rem);
    color: var(--ink-soft);
  }

  .current-folio__identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .current-folio__identity > span + span {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .current-folio__identity-name {
    color: var(--ink);
    font-family: var(--font-noto-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .current-folio__inscription {
    position: absolute;
    right: clamp(1rem, 4vw, 4rem);
    bottom: clamp(1rem, 2vw, 2rem);
    color: color-mix(in oklab, var(--ink) 20%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-title-section);
    letter-spacing: 0.14em;
  }

  .current-folio__status {
    position: relative;
    z-index: 2;
    grid-column: 8 / -1;
    grid-row: 1;
    margin-top: clamp(3rem, 5vw, 5rem);
    margin-left: clamp(-5rem, -5vw, -2rem);
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 2px solid var(--ink);
    border-left: 0.3rem solid var(--cinnabar);
    background: color-mix(in oklab, var(--paper-deep) 86%, var(--paper));
    box-shadow: var(--shadow-md);
    transform: rotate(1.8deg);
  }

  .current-folio__status::after {
    content: '';
    position: absolute;
    right: -1.5rem;
    bottom: 1.4rem;
    width: 5.5rem;
    height: 1px;
    background: var(--cinnabar);
    transform: rotate(-7deg);
  }

  .current-folio__status-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .current-folio__status-head p,
  .current-folio__status-head span {
    margin: 0;
  }

  .current-folio__status-head span,
  .current-folio__updated {
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
  }

  .current-folio__status li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .current-folio__number {
    color: var(--bronze);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.1rem;
  }

  .current-folio__status li p {
    margin: 0;
  }

  .current-folio__status li div > span {
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
  }

  .current-folio__updated {
    margin: 1rem 0 0;
  }

  @media (max-width: 900px) {
    .current-folio::before {
      top: 42%;
      bottom: 2rem;
      left: 16%;
    }

    .current-folio__grid {
      display: block;
      min-height: 0;
    }

    .current-folio__portrait {
      min-height: 0;
      padding: 2.5rem clamp(1.5rem, 7vw, 3rem) 4.5rem;
      clip-path: polygon(0 0, 100% 0.8%, 99% 100%, 1% 98.5%);
      transform: none;
    }

    .current-folio__note {
      margin-left: 0;
    }

    .current-folio__identity {
      align-items: flex-start;
    }

    /* 移动端收窄题字并禁折行，避免与上方 note 正文交叠 */
    .current-folio__inscription {
      font-size: 1.6rem;
      white-space: nowrap;
    }

    .current-folio__status {
      width: min(88%, 28rem);
      margin: -1.5rem 0 0 auto;
      padding: 1.25rem;
      transform: rotate(1deg);
    }
  }

  @media (max-width: 479px) {
    .current-folio__portrait {
      padding-inline: 1.5rem;
    }

    .current-folio__lead {
      font-size: var(--type-title-section);
    }

    .current-folio__identity > span + span {
      padding-left: 0.65rem;
    }

    .current-folio__status {
      width: calc(100% - 1rem);
    }
  }
</style>
