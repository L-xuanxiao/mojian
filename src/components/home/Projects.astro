---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import { withBase } from '../../site.config';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section
  class="home-projects mx-auto max-w-stage px-5 py-12 md:px-8 lg:px-10"
  aria-labelledby="projects"
  data-home-chapter="贰"
  data-ink-scene="exhibition"
>
  <SectionHeading id="projects" title="器作" index="贰" note="WORKS" mode="chapter" />
  <ol class="project-preview mt-6 list-none p-0" data-reveal-group data-reveal-variant="exhibit">
    {
      projects.map((project, index) => (
        <li
          class:list={['project-preview__item', `project-preview__item--${index + 1}`]}
          data-number={String(index + 1).padStart(2, '0')}
        >
          <span class="project-preview__folio" aria-hidden="true">
            展品 {String(index + 1).padStart(2, '0')}
          </span>
          <a
            class="project-preview__image media-reveal"
            href={withBase(`/projects/${project.id}/`)}
            tabindex="-1"
            style={`view-transition-name: project-${project.id};`}
          >
            <Image
              src={project.data.cover}
              alt={project.data.coverAlt}
              widths={[480, 760, 1080]}
              sizes="(min-width: 768px) 58vw, 100vw"
              quality={82}
            />
          </a>
          <div class="project-preview__copy">
            <p class="project-preview__meta">
              <span>{project.data.year}</span>
              <span>{project.data.status}</span>
            </p>
            <h3>
              <a class="ink-link" href={withBase(`/projects/${project.id}/`)}>
                {project.data.title}
              </a>
            </h3>
            <p>{project.data.summary}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 mb-0 text-right font-sans text-sm">
    <a class="ink-link" href={withBase('/projects/')}>查看全部器作</a>
  </p>
</section>

<style>
  .home-projects {
    position: relative;
    overflow: clip;
  }

  .project-preview {
    position: relative;
    left: 50%;
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    /* 展墙宽度不超过 section 裁切边界（stage 内容宽 84rem）再留贴边余量：
       按 100vw 定宽会超出 overflow:clip 的父级，右侧展签与摘要被裁 */
    width: min(calc(100vw - 1rem), 82rem);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    align-items: start;
    margin-top: 0;
    transform: translateX(-50%);
  }

  .project-preview__item {
    position: relative;
    isolation: isolate;
    margin: 0;
  }

  .project-preview__item::before {
    content: attr(data-number);
    position: absolute;
    z-index: -1;
    top: -0.5em;
    right: -0.12em;
    color: color-mix(in oklab, var(--ink) 8%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-glyph-chapter);
    line-height: 1;
    pointer-events: none;
    transition: color 250ms var(--ease-ink);
  }

  .project-preview__folio {
    position: absolute;
    z-index: 3;
    top: 1rem;
    right: -1.5rem;
    padding: 0.55rem 0.45rem;
    border-block: 1px solid var(--line);
    background: var(--paper);
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    writing-mode: vertical-rl;
    transition:
      color 250ms var(--ease-ink),
      transform 250ms var(--ease-ink);
  }

  .project-preview__item--1 {
    grid-row: 1;
    grid-column: 1 / span 7;
  }

  .project-preview__item--2 {
    grid-row: 1;
    grid-column: 8 / span 3;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .project-preview__item--3 {
    grid-row: 1;
    grid-column: 11 / -1;
    margin-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .project-preview__item--2::before {
    top: -0.35em;
    right: auto;
    left: -0.22em;
  }

  .project-preview__item--2 .project-preview__folio {
    right: auto;
    left: -1.25rem;
  }

  .project-preview__item--3 .project-preview__folio {
    right: -0.75rem;
  }

  .project-preview__image {
    display: block;
    overflow: hidden;
    background: var(--paper-deep);
    box-shadow: var(--shadow-md);
    transition:
      box-shadow 250ms var(--ease-ink),
      transform 250ms var(--ease-ink);
  }

  .project-preview__image :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 250ms var(--ease-ink);
  }

  .project-preview__item--1 .project-preview__image :global(img) {
    aspect-ratio: 16 / 6.5;
  }

  .project-preview__item--2 .project-preview__image :global(img) {
    aspect-ratio: 4 / 3;
  }

  .project-preview__item--3 .project-preview__image :global(img) {
    aspect-ratio: 4 / 3;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-preview__image:hover :global(img) {
      transform: scale(1.04);
    }

    /* 展墙接管构图时，作品向前，贴边展签向外退让。 */
    .project-preview__item:hover .project-preview__image,
    .project-preview__item:focus-within .project-preview__image {
      box-shadow: var(--shadow-lg);
      transform: translateY(-0.35rem);
    }

    .project-preview__item:hover .project-preview__folio,
    .project-preview__item:focus-within .project-preview__folio {
      color: var(--cinnabar);
      transform: translateX(0.8rem);
    }

    .project-preview__item--2:hover .project-preview__folio,
    .project-preview__item--2:focus-within .project-preview__folio {
      transform: translateX(-0.8rem);
    }

    .project-preview__item:hover::before,
    .project-preview__item:focus-within::before {
      color: color-mix(in oklab, var(--cinnabar) 14%, transparent);
    }
  }

  .project-preview__copy {
    position: relative;
    z-index: 2;
    width: calc(100% - clamp(1rem, 3vw, 2.5rem));
    max-width: 36rem;
    margin: clamp(-2rem, -2vw, -1.25rem) 0 0 clamp(1rem, 3vw, 2.5rem);
    padding: 1rem clamp(1rem, 2vw, 1.75rem);
    border-left: 2px solid var(--ink);
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .project-preview__item--2 .project-preview__copy {
    width: calc(100% + 0.75rem);
    margin-top: -0.75rem;
    margin-left: -0.75rem;
    padding-inline: 1rem;
  }

  .project-preview__item--3 .project-preview__copy {
    width: calc(100% + 0.75rem);
    max-width: none;
    margin-top: -0.75rem;
    margin-left: 0;
    padding-inline: 1rem;
  }

  .project-preview__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.72rem;
  }

  /* 状态小签：描边铭牌样式，与笺录的纯文本 meta 拉开 */
  .project-preview__meta span:last-child {
    padding: 0.08rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    letter-spacing: 0.1em;
  }

  .project-preview h3 {
    margin: 0.5rem 0 0;
    font-size: var(--type-title-card);
    font-weight: 400;
  }

  .project-preview__copy > p:last-child {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
  }

  @media (max-width: 767px) {
    .project-preview {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: 2.5rem 1rem;
      margin-top: 0;
    }

    .project-preview__item--1 {
      grid-row: auto;
      grid-column: 1 / -1;
    }

    .project-preview__item--2,
    .project-preview__item--3 {
      grid-row: auto;
      grid-column: auto;
      margin-top: 0;
    }

    .project-preview__folio {
      top: 0.75rem;
      right: -0.25rem;
      left: auto;
      bottom: auto;
      writing-mode: vertical-rl;
    }

    .project-preview__item::before {
      top: -0.55em;
      right: -0.05em;
      left: auto;
      font-size: var(--type-glyph-chapter);
    }

    .project-preview__copy,
    .project-preview__item--1 .project-preview__copy {
      width: calc(100% - 1.25rem);
      margin: -1.2rem 0 0 1.25rem;
      padding: 1.25rem;
    }

    .project-preview__item--2 .project-preview__copy,
    .project-preview__item--3 .project-preview__copy {
      width: 100%;
      margin: 0.75rem 0 0;
      padding: 0;
      border-left: 0;
      background: transparent;
      box-shadow: none;
    }

    .project-preview__item--2 .project-preview__copy > p:last-child,
    .project-preview__item--3 .project-preview__copy > p:last-child {
      display: none;
    }

    .project-preview__item--2 .project-preview__image :global(img),
    .project-preview__item--3 .project-preview__image :global(img) {
      aspect-ratio: 4 / 3;
    }

    .project-preview__item--1 .project-preview__image :global(img) {
      aspect-ratio: 3 / 2;
    }

    .project-preview__item--2 .project-preview__folio,
    .project-preview__item--3 .project-preview__folio {
      right: -0.25rem;
      left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-preview__image,
    .project-preview__folio,
    .project-preview__image :global(img) {
      transition: none;
    }
  }
</style>
