---
// 占位数据，后续阶段替换为真实内容
const projects = [
  {
    name: 'mojian',
    description: '这个网站本身——一处现代东方水墨书卷气质的个人数字空间。',
    tags: 'Astro Tailwind CSS',
    href: '#',
  },
  {
    name: '拾字集',
    description: '日常摘句与短记的极简收集器，只留文字与日期。',
    tags: 'Astro Markdown',
    href: '#',
  },
  {
    name: '观山历',
    description: '一页式节气日历，以山水墨色的深浅标记四时流转。',
    tags: 'TypeScript CSS',
    href: '#',
  },
];
---

<section class="mx-auto max-w-content px-5 py-16 md:px-8 md:py-24" aria-labelledby="projects">
  <h2 id="projects">器作</h2>
  <ul class="mt-10 list-none p-0 md:mt-12">
    {
      projects.map((project) => (
        <li class="border-t border-line py-8 first:border-t-0 first:pt-0 md:py-10">
          <h3 class="text-xl">{project.name}</h3>
          <p class="mt-3 mb-0 text-ink-soft">{project.description}</p>
          <p class="mt-3 mb-0 font-sans text-sm text-ink-soft">{project.tags}</p>
          <p class="mt-4 mb-0">
            <a href={project.href}>查看</a>
          </p>
        </li>
      ))
    }
  </ul>
</section>
