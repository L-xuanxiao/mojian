---
import SectionHeading from '../SectionHeading.astro';
import { siteMilestones } from './site-timeline.data';

// 卷尾年谱（站点史）维护于 ./site-timeline.data.ts，与 About 行年（人的经历）各自独立
---

<section class="timeline-folio" aria-labelledby="timeline-heading" data-home-chapter="陆">
  <div class="timeline-folio__inner mx-auto max-w-stage px-5 py-14 md:px-8 md:py-20 lg:px-10">
    <SectionHeading
      id="timeline-heading"
      title="卷尾年谱"
      index="陆"
      note="COLOPHON"
      mode="quiet"
    />

    <div class="timeline-folio__grid">
      <div class="timeline-folio__intro">
        <p class="folio-label">一路所记</p>
        <p>时间不是履历表，更像纸上逐年留下的墨色。浓淡不同，却都成为这一卷的一部分。</p>
        <span aria-hidden="true">未完待续</span>
      </div>

      <ol class="timeline-folio__list" data-reveal-group data-reveal-variant="stagger">
        {
          siteMilestones.map(({ year, event }, index) => (
            <li>
              <span class="timeline-folio__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <time datetime={year}>{year}</time>
              <p>{event}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline-folio {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper-deep) 24%, transparent);
  }

  .timeline-folio__inner {
    position: relative;
  }

  .timeline-folio__inner::after {
    content: '';
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(2rem, 4vw, 3.5rem);
    width: clamp(4rem, 9vw, 8rem);
    height: 1px;
    background: var(--cinnabar);
    transform: rotate(-1.5deg);
  }

  .timeline-folio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block: 1px solid var(--line);
  }

  .timeline-folio__intro {
    grid-column: 1 / span 4;
  }

  .timeline-folio__intro > .folio-label {
    margin: 0 0 1.5rem;
  }

  .timeline-folio__intro > p:not(.folio-label) {
    max-width: 22rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .timeline-folio__intro > span {
    display: block;
    margin-top: 1.75rem;
    color: color-mix(in oklab, var(--ink) 22%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    letter-spacing: 0.1em;
    transform: rotate(-1deg);
  }

  .timeline-folio__list {
    grid-column: 5 / -1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-folio__list li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(4rem, 6rem) minmax(0, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: baseline;
    min-height: 0;
    padding-block: 1.5rem;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .timeline-folio__list li:only-child {
    min-height: 0;
  }

  .timeline-folio__index {
    position: static;
    color: color-mix(in oklab, var(--ink) 16%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.45rem;
  }

  .timeline-folio__list time {
    color: var(--cinnabar);
    font-family: var(--font-noto-sans);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }

  .timeline-folio__list p {
    max-width: 32rem;
    margin: 0;
  }

  @media (max-width: 767px) {
    .timeline-folio__grid {
      display: block;
    }

    .timeline-folio__intro {
      margin-bottom: 3rem;
    }

    /* 移动端堆叠时「未完待续」会先于年谱条目出现，叙事倒置，故隐藏（桌面端保留为左列收束闲笔） */
    .timeline-folio__intro > span {
      display: none;
    }

    .timeline-folio__list {
      display: block;
    }

    .timeline-folio__list li {
      grid-template-columns: 2rem 4rem minmax(0, 1fr);
      gap: 0.75rem;
      padding-block: 1.25rem;
    }

    .timeline-folio__inner::after {
      bottom: 1.5rem;
    }
  }

  @media (max-width: 479px) {
    .timeline-folio__list li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .timeline-folio__list p {
      grid-column: 2;
    }
  }
</style>
