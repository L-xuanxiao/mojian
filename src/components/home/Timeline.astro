---
import SectionHeading from '../SectionHeading.astro';
import { siteMilestones } from './site-timeline.data';

// 卷尾年谱（站点史）维护于 ./site-timeline.data.ts，与 About 行年（人的经历）各自独立
---

<section class="timeline-folio" aria-labelledby="timeline-heading">
  <div class="mx-auto max-w-stage px-5 py-16 md:px-8 md:py-24 lg:px-10">
    <SectionHeading id="timeline-heading" title="卷尾年谱" index="陆" note="COLOPHON" />

    <div class="timeline-folio__grid">
      <div class="timeline-folio__intro">
        <p class="folio-label">一路所记</p>
        <p>时间不是履历表，更像纸上逐年留下的墨色。浓淡不同，却都成为这一卷的一部分。</p>
        <span aria-hidden="true">未完待续</span>
      </div>

      <ol class="timeline-folio__list" data-reveal-group data-reveal-variant="stagger">
        {
          siteMilestones.map(({ year, event }, index) => (
            <li>
              <span class="timeline-folio__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <time datetime={year}>{year}</time>
              <p>{event}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline-folio {
    background: color-mix(in oklab, var(--paper-deep) 36%, transparent);
  }

  .timeline-folio :global(.section-heading h2) {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
  }

  .timeline-folio__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 3fr) minmax(0, 8fr);
    gap: clamp(4rem, 9vw, 9rem);
  }

  .timeline-folio__intro > .folio-label {
    margin: 0 0 1.5rem;
  }

  .timeline-folio__intro > p:not(.folio-label) {
    max-width: 24rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .timeline-folio__intro > span {
    display: block;
    margin-top: 3rem;
    color: color-mix(in oklab, var(--ink) 22%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: 0.1em;
    transform: rotate(-2deg);
  }

  .timeline-folio__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    list-style: none;
  }

  .timeline-folio__list li {
    position: relative;
    min-height: 12rem;
    padding: 1.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .timeline-folio__list li:only-child {
    grid-column: 1 / -1;
    min-height: 15rem;
    border-right: 0;
  }

  .timeline-folio__list li:only-child .timeline-folio__index {
    top: -0.16em;
    right: 0.2em;
    color: color-mix(in oklab, var(--ink) 8%, transparent);
    font-size: clamp(7rem, 15vw, 13rem);
  }

  .timeline-folio__list li:nth-child(even) {
    border-right: 0;
  }

  .timeline-folio__index {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: color-mix(in oklab, var(--ink) 16%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: 2.4rem;
  }

  .timeline-folio__list time {
    color: var(--cinnabar);
    font-family: var(--font-noto-sans);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }

  .timeline-folio__list p {
    max-width: 19rem;
    margin: 2.5rem 0 0;
  }

  @media (max-width: 767px) {
    .timeline-folio__grid {
      display: block;
    }

    .timeline-folio__intro {
      margin-bottom: 4rem;
    }

    /* 移动端堆叠时「未完待续」会先于年谱条目出现，叙事倒置，故隐藏（桌面端保留为左列收束闲笔） */
    .timeline-folio__intro > span {
      display: none;
    }

    .timeline-folio__list {
      display: block;
    }

    .timeline-folio__list li,
    .timeline-folio__list li:nth-child(even) {
      min-height: 0;
      border-right: 0;
    }
  }
</style>
