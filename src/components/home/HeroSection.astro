---
// 首页首屏：水墨远山 + 题签文案 + 新札卡。样式自 index.astro 平移（scoped）。
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import inkMountains from '../../assets/ink-mountains.png';
import { homeContent } from '../../config/homeContent';
import { formatDate } from '../../lib/posts';

interface Props {
  /** 最新已发布文章；无文章时新札卡不渲染 */
  latestPost?: CollectionEntry<'blog'> | undefined;
}

const { latestPost } = Astro.props;
const { hero } = homeContent;
const BASE = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-content">
      <p class="hero-eyebrow" data-font-role="hand">{hero.eyebrow}</p>
      <h1 class="hero-title" id="hero-title" data-font-role="cal">{hero.title}<span class="accent-dot">{hero.titleAccent}</span></h1>
      <p class="hero-subtitle">{hero.subtitle}</p>
      <div class="hero-intro">
        {hero.intro.map((line) => <>{line}<br /></>)}
      </div>
      <div class="hero-actions" aria-label="页面入口">
        <a class="action-primary" href="#articles">{hero.actions.primary}</a>
        <a class="action-secondary" href="#about">{hero.actions.secondary}</a>
      </div>
    </div>

    <div class="hero-side">
      <div class="hero-vertical-copy" aria-hidden="true" data-font-role="hand">{hero.verticalCopy}</div>
      {latestPost && (
        <aside class="hero-note" aria-label="最新文章">
          <div class="hero-note-head">
            <strong data-font-role="cal">{hero.noteBadge}</strong>
            <time datetime={latestPost.data.pubDate.toISOString()}>{formatDate(latestPost.data.pubDate)}</time>
          </div>
          <a class="hero-note-post" href={`${BASE}posts/${latestPost.id}/`}>{latestPost.data.title}</a>
          <p class="hero-note-meta">{latestPost.data.category} · {hero.noteSuffix}</p>
        </aside>
      )}
    </div>
  </div>

  <div class="hero-landscape" aria-hidden="true">
    <Image
      src={inkMountains}
      alt=""
      widths={[960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="scroll-hint" aria-hidden="true" data-font-role="hand">{hero.scrollHint}</div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    height: clamp(560px, 62svh, 660px);
    display: grid;
    align-items: center;
    padding: 108px 0 64px;
    isolation: isolate;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -3;
    background: linear-gradient(90deg, rgba(250, 248, 242, 0.88) 0%, rgba(250, 248, 242, 0.7) 43%, rgba(250, 248, 242, 0.3) 72%, rgba(250, 248, 242, 0.5) 100%);
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(180deg, rgba(247, 244, 235, 0.08), transparent 55%, rgba(242, 238, 227, 0.72));
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    align-items: center;
    gap: clamp(42px, 7vw, 110px);
  }

  .hero-content {
    max-width: 760px;
    padding-top: 18px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    margin: 0 0 24px;
    color: var(--moss);
    font-size: 0.95rem;
    letter-spacing: 0.28em;
  }

  .hero-eyebrow::before {
    content: "";
    width: 42px;
    height: 1px;
    background: currentColor;
    opacity: 0.58;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(4.2rem, 7.4vw, 6.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0.11em;
    text-wrap: balance;
  }

  .hero-title .accent-dot {
    color: var(--cinnabar);
    font-size: 0.42em;
    vertical-align: 0.14em;
    margin-left: 0.08em;
  }

  .hero-subtitle {
    margin: 28px 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.12rem, 2vw, 1.48rem);
    letter-spacing: 0.12em;
  }

  .hero-intro {
    max-width: 580px;
    margin-top: 34px;
    padding-left: 22px;
    border-left: 1px solid rgba(164, 68, 52, 0.48);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 2.05;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 42px;
  }

  .action-primary,
  .action-secondary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    letter-spacing: 0.12em;
    transition: color 230ms ease, transform 230ms var(--ease), border-color 230ms ease;
  }

  .action-primary {
    min-width: 126px;
    padding: 8px 20px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .action-primary:hover {
      transform: translateY(-2px);
      color: var(--paper-light);
      background: var(--ink);
      border-color: var(--ink);
    }
  }

  .action-primary:active {
    transform: scale(0.97);
  }

  .action-secondary {
    padding: 8px 0 6px;
    border-bottom: 1px solid var(--line-strong);
  }

  .action-secondary::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--cinnabar);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 260ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .action-secondary:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .hero-side {
    position: relative;
    align-self: stretch;
    min-height: 350px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .hero-vertical-copy {
    position: absolute;
    right: 4px;
    top: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: rgba(48, 50, 46, 0.68);
    font-size: 0.9rem;
    letter-spacing: 0.28em;
    writing-mode: vertical-rl;
  }

  .hero-vertical-copy::before {
    content: "";
    width: 1px;
    height: 64px;
    margin: 0 auto 12px;
    background: linear-gradient(var(--moss), transparent);
    opacity: 0.38;
  }

  .hero-note {
    position: relative;
    width: 286px;
    margin-right: 76px;
    padding: 28px 28px 26px;
    color: var(--ink-soft);
    background: rgba(249, 247, 240, 0.72);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .hero-note::before {
    content: "";
    position: absolute;
    left: -30px;
    top: 20px;
    width: 52px;
    height: 74px;
    background:
      radial-gradient(ellipse at 40% 55%, rgba(63, 72, 65, 0.22), transparent 58%),
      radial-gradient(ellipse at 70% 35%, rgba(63, 72, 65, 0.12), transparent 48%);
    filter: blur(3px);
    transform: rotate(-14deg);
  }

  .hero-note-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--ink);
  }

  .hero-note-head strong {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.18em;
  }

  .hero-note-head time {
    color: var(--ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .hero-note-post {
    display: block;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.7;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .hero-note-post:hover {
    color: var(--moss-deep);
  }

  .hero-note-meta {
    margin: 8px 0 0;
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }

  .hero-landscape {
    position: absolute;
    inset: 0;
    z-index: -4;
    pointer-events: none;
  }

  .hero-landscape img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 56%;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 5;
    display: grid;
    justify-items: center;
    gap: 8px;
    color: var(--ink-faint);
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    transform: translateX(-50%);
  }

  .scroll-hint::after {
    content: "";
    width: 1px;
    height: 34px;
    background: linear-gradient(var(--cinnabar), transparent);
    animation: cueDrop 1.9s ease-in-out infinite;
  }

  @keyframes cueDrop {
    0% { transform: scaleY(0); transform-origin: top; }
    55% { transform: scaleY(1); transform-origin: top; }
    56% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* ============ 夜色覆盖 ============ */
  :global(html[data-theme='night']) .hero::before {
    background: linear-gradient(90deg, rgba(22, 23, 19, 0.9) 0%, rgba(22, 23, 19, 0.72) 43%, rgba(22, 23, 19, 0.35) 72%, rgba(22, 23, 19, 0.55) 100%);
  }

  :global(html[data-theme='night']) .hero::after {
    background: linear-gradient(180deg, rgba(20, 21, 17, 0.08), transparent 55%, rgba(25, 26, 22, 0.78));
  }

  :global(html[data-theme='night']) .hero-landscape img {
    filter: brightness(0.55) contrast(1.06) sepia(0.14);
  }

  :global(html[data-theme='night']) .hero-vertical-copy {
    color: rgba(233, 226, 208, 0.5);
  }

  :global(html[data-theme='night']) .hero-note {
    background: rgba(33, 34, 29, 0.72);
  }

  :global(html[data-theme='night']) .hero-note::before {
    background:
      radial-gradient(ellipse at 40% 55%, rgba(233, 226, 208, 0.14), transparent 58%),
      radial-gradient(ellipse at 70% 35%, rgba(233, 226, 208, 0.08), transparent 48%);
  }

  /* ============ 动画 ============ */
  /* 首载 loader 谢幕后 hero 接力入场；Swup 回访（body 无 .loaded）直接显示 */
  :global(body.loaded) .hero-content {
    animation: hero-in 600ms 120ms var(--ease) both;
  }

  :global(body.loaded) .hero-note {
    animation: note-in 600ms 300ms var(--ease) both;
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes note-in {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* ============ 响应式 ============ */
  @media (max-width: 1080px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 270px;
      gap: 48px;
    }

    .hero-note {
      width: 250px;
      margin-right: 64px;
      padding: 24px;
    }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 620px;
      height: auto;
      padding: 126px 0 82px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-content {
      max-width: 680px;
    }

    .hero-side {
      display: none;
    }

    .hero-vertical-copy {
      display: none;
    }

    .hero-note {
      width: min(100%, 430px);
      margin: 10px 0 0 auto;
    }

    .hero-landscape {
      height: 100%;
    }
  }

  @media (max-width: 620px) {
    .hero {
      min-height: 570px;
      padding: 104px 0 62px;
    }

    .hero-title {
      font-size: clamp(3.4rem, 18vw, 5.4rem);
      letter-spacing: 0.07em;
    }

    .hero-subtitle {
      margin-top: 22px;
      font-size: 1rem;
      letter-spacing: 0.08em;
    }

    .hero-intro {
      margin-top: 26px;
      font-size: 0.92rem;
    }

    .hero-actions {
      gap: 22px;
      margin-top: 32px;
    }

    .action-primary {
      min-width: 112px;
      padding-inline: 16px;
    }

    .hero-note {
      padding: 22px 20px;
    }

    .hero-landscape {
      height: 100%;
      min-height: 0;
    }

    .scroll-hint {
      display: none;
    }
  }
</style>
