---
// 首页「案头近况」：深墨过渡区，此刻状态 + 一页小记。
// 状态条目与小记来自「此刻」集合（src/content/now/），文案走 homeContent；无数据时区块不渲染。
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import { homeContent } from '../../config/homeContent';
import { formatDateShort } from '../../lib/posts';
import deskCranes from '../../assets/desk-cranes.png';

const { desk } = homeContent;
const now = await getEntry('now', 'now');
const Content = now ? (await render(now)).Content : null;
---

{now && Content && (
<section class="section desk" aria-labelledby="desk-title">
  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker" data-font-role="hand">{desk.kicker}</p>
        <h2 class="section-title" id="desk-title" data-font-role="cal">{desk.title}</h2>
      </div>
      <p class="section-note">{desk.note}</p>
    </div>

    <div class="desk-grid">
      <article class="now-panel reveal">
        <div class="panel-mark" aria-hidden="true" data-font-role="cal">今</div>
        <div class="now-head">
          <span>{desk.nowTitle}</span>
          <time datetime={now.data.date.toISOString()}>{formatDateShort(now.data.date)}</time>
        </div>
        <div class="now-list">
          {now.data.items.map((item) => (
            <div class="now-row">
              <span class="now-label" data-font-role="hand">{item.label}</span>
              <strong>{item.text}</strong>
              <span class="now-state">{item.state}</span>
            </div>
          ))}
        </div>
      </article>

      <article class="fragment-panel reveal">
        <div class="fragment-art" aria-hidden="true">
          <Image
            src={deskCranes}
            alt=""
            widths={[480, 720, 960]}
            sizes="(max-width: 620px) 100vw, (max-width: 1080px) 40vw, 480px"
            loading="lazy"
          />
        </div>
        <div class="fragment-copy">
          <p class="fragment-label">{desk.fragmentLabel}</p>
          <blockquote><Content /></blockquote>
          <p class="fragment-source">{desk.fragmentSource}</p>
        </div>
      </article>
    </div>
  </div>
</section>
)}

<style>
  .desk {
    position: relative;
    color: rgba(248, 246, 239, 0.92);
    background:
      radial-gradient(ellipse at 18% 38%, rgba(255,255,255,0.045), transparent 33%),
      radial-gradient(ellipse at 80% 12%, rgba(164,68,52,0.08), transparent 22%),
      linear-gradient(135deg, #3d4540, #303531 60%, #3a403b);
    overflow: hidden;
  }

  .desk::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='d'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.46' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23d)' opacity='.6'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .desk::after {
    content: "";
    position: absolute;
    right: -7%;
    bottom: -22%;
    width: min(50vw, 760px);
    aspect-ratio: 1.4;
    border-radius: 50%;
    border: 1px solid rgba(235, 232, 222, 0.08);
    box-shadow:
      0 0 0 34px rgba(235,232,222,0.025),
      0 0 0 82px rgba(235,232,222,0.015);
    transform: rotate(-8deg);
  }

  .desk .section-kicker {
    color: #ce8b7e;
  }

  .desk .section-title {
    color: #f1eee6;
  }

  .desk .section-note {
    color: rgba(242, 239, 230, 0.64);
  }

  .desk-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.8fr);
    gap: clamp(32px, 5vw, 70px);
  }

  .now-panel,
  .fragment-panel {
    position: relative;
    min-width: 0;
    border-top: 1px solid rgba(240, 236, 226, 0.2);
    border-bottom: 1px solid rgba(240, 236, 226, 0.1);
    background: rgba(255,255,255,0.02);
  }

  .now-panel {
    padding: 30px 34px 18px;
  }

  .panel-mark {
    position: absolute;
    right: 26px;
    top: -20px;
    width: 42px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: rgba(248, 238, 229, 0.94);
    background: var(--cinnabar);
    border: 1px solid rgba(118, 42, 33, 0.8);
    transform: rotate(4deg);
  }

  .now-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 20px;
    color: rgba(247,244,235,0.9);
  }

  .now-head span {
    font-size: 1.1rem;
    letter-spacing: 0.15em;
  }

  .now-head time {
    color: rgba(247,244,235,0.45);
    font-size: 0.78rem;
  }

  .now-list {
    border-top: 1px solid rgba(240, 236, 226, 0.12);
  }

  .now-row {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr) 64px;
    gap: 20px;
    align-items: center;
    min-height: 92px;
    border-bottom: 1px solid rgba(240, 236, 226, 0.08);
  }

  .now-label {
    color: #d79a8d;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .now-row strong {
    color: rgba(248,246,239,0.88);
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.7;
  }

  .now-state {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    justify-self: end;
    color: rgba(248,246,239,0.43);
    font-size: 0.74rem;
  }

  .now-state::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #d79a8d;
    opacity: 0.7;
  }

  .fragment-panel {
    display: grid;
    grid-template-rows: 210px 1fr;
    overflow: hidden;
  }

  .fragment-art {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(240,236,226,0.12);
  }

  .fragment-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fragment-copy {
    padding: 26px 30px 30px;
  }

  .fragment-label {
    margin: 0 0 12px;
    color: #d79a8d;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
  }

  .fragment-copy blockquote {
    margin: 0;
    color: rgba(248,246,239,0.88);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.9;
  }

  /* 小记正文由 <Content /> 渲染，scoped 样式需 :global 命中其 <p> */
  .fragment-copy blockquote :global(p) {
    margin: 0;
  }

  .fragment-source {
    margin: 18px 0 0;
    color: rgba(248,246,239,0.4);
    font-size: 0.78rem;
    text-align: right;
  }

  /* ≥821px：home-layout 网格语境下的归属与覆盖 */
  @media (min-width: 821px) {
    :global(.home-layout) > .desk {
      grid-area: desk;
    }
  }

  @media (min-width: 1440px) {
    :global(.home-layout) .desk .section-heading,
    :global(.home-layout) .desk-grid {
      grid-template-columns: 1fr;
    }

    :global(.home-layout) .desk .section-heading {
      gap: 16px;
      margin-bottom: 30px;
    }

    :global(.home-layout) .desk-grid {
      gap: 24px;
    }

    :global(.home-layout) .desk .section-title {
      font-size: clamp(2rem, 2.8vw, 2.65rem);
    }

    :global(.home-layout) .desk .now-panel {
      padding: 24px 20px 14px;
    }

    :global(.home-layout) .desk .now-row {
      grid-template-columns: 1fr;
      gap: 5px;
      padding: 15px 0;
    }

    :global(.home-layout) .desk .now-state {
      justify-self: start;
    }

    :global(.home-layout) .desk .fragment-panel {
      grid-template-rows: 140px 1fr;
    }

    :global(.home-layout) .desk .fragment-copy {
      padding: 20px;
    }
  }

  /* ============ 响应式 ============ */
  @media (max-width: 1080px) {
    .desk-grid {
      grid-template-columns: 1fr;
    }

    .fragment-panel {
      grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .fragment-art {
      min-height: 300px;
      border-right: 1px solid rgba(240,236,226,0.12);
      border-bottom: 0;
    }
  }

  @media (max-width: 620px) {
    .now-panel {
      padding: 26px 18px 12px;
    }

    .now-row {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px;
      padding: 18px 0;
    }

    .now-state {
      grid-column: 2;
      justify-self: start;
    }

    .fragment-panel {
      grid-template-columns: 1fr;
    }

    .fragment-art {
      min-height: 220px;
      border-right: 0;
      border-bottom: 1px solid rgba(240,236,226,0.12);
    }

    .fragment-copy {
      padding: 24px 20px 28px;
    }
  }
</style>
