---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import { withBase } from '../../site.config';

const works = (await getCollection('gallery', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<section
  class="darkroom home-gallery"
  aria-labelledby="gallery"
  data-home-chapter="伍"
  data-ink-scene="darkroom"
>
  <span class="mist mist--a home-gallery__mist" aria-hidden="true"></span>
  <div class="home-gallery__inner mx-auto max-w-stage px-5 py-12 md:px-8 md:py-10 lg:px-10">
    <span class="home-gallery__stage-mark" aria-hidden="true">影</span>
    <SectionHeading id="gallery" title="光影集" index="伍" note="GALLERY" mode="chapter" />
    <p class="mt-3 max-w-[32rem] text-ink-soft">以光为墨，收存纸张、山水与四时一瞬。</p>
    <ol
      class="gallery-preview mt-6 list-none p-0"
      data-reveal-group
      data-reveal-variant="contact-sheet"
    >
      {
        works.map((work, index) => (
          <li class:list={['gallery-preview__item', `gallery-preview__item--${index + 1}`]}>
            <span class="gallery-preview__folio" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <a
              href={withBase('/gallery/')}
              class="gallery-preview__image media-reveal"
              data-gallery-parallax
            >
              <Image
                src={work.data.image}
                alt={work.data.alt}
                widths={[420, 720, 1080]}
                sizes="(min-width: 768px) 48vw, 100vw"
                quality={80}
              />
            </a>
            <p>
              <span>{work.data.title}</span>
              <span>{work.data.year}</span>
            </p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 mb-0 text-right font-sans text-sm">
      <a class="ink-link" href={withBase('/gallery/')}>展开全部光影</a>
    </p>
  </div>
</section>

<style>
  /* 暗室内内容压在云气之上 */
  .home-gallery__inner {
    position: relative;
    z-index: 1;
    isolation: isolate;
  }

  .home-gallery__inner::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 19%;
    right: -4%;
    width: 56%;
    height: 46%;
    border: 1px solid var(--line);
    transform: rotate(3deg);
    pointer-events: none;
  }

  .home-gallery__stage-mark {
    position: absolute;
    z-index: -1;
    top: clamp(11rem, 16vw, 17rem);
    right: -0.12em;
    color: color-mix(in oklab, var(--ink) 7%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-glyph-chapter);
    line-height: 0.8;
    pointer-events: none;
    transform: rotate(5deg);
  }

  /* 云气在暗室里呈淡白微光，如暗室浮尘 */
  .home-gallery__mist {
    top: 8%;
    right: -6%;
    width: 34rem;
    height: 24rem;
  }

  .gallery-preview {
    position: relative;
    left: 50%;
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    width: min(calc(100vw - 1rem), 84rem);
    gap: clamp(1rem, 2vw, 1.75rem) clamp(0.75rem, 1.5vw, 1.5rem);
    align-items: start;
    transform: translateX(-50%);
  }

  .gallery-preview__item--1 {
    position: relative;
    z-index: 1;
    grid-row: 1 / span 2;
    grid-column: 1 / span 10;
  }

  .gallery-preview__item--2 {
    position: relative;
    z-index: 2;
    grid-row: 1;
    grid-column: 11 / span 3;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    transform: rotate(1.7deg);
  }

  .gallery-preview__item--3 {
    position: relative;
    grid-row: 1;
    grid-column: 14 / -1;
    margin-top: 0;
    transform: rotate(-1.2deg);
  }

  .gallery-preview__item--4 {
    position: relative;
    grid-row: 2;
    grid-column: 11 / -1;
    margin-top: 0;
    transform: rotate(0.7deg);
  }

  .gallery-preview__image {
    display: block;
    overflow: hidden;
    background: var(--paper-deep);
    box-shadow: var(--shadow-md);
  }

  .gallery-preview__item:not(.gallery-preview__item--1) .gallery-preview__image {
    padding: clamp(0.25rem, 0.55vw, 0.5rem);
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink) 9%, transparent);
  }

  .gallery-preview__folio {
    position: absolute;
    top: -1.55rem;
    left: 0;
    color: var(--bronze);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1rem;
  }

  .gallery-preview__image :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 250ms var(--ease-ink);
  }

  .gallery-preview__item--1 .gallery-preview__image :global(img) {
    aspect-ratio: 16 / 5;
  }

  .gallery-preview__item--2 .gallery-preview__image :global(img) {
    aspect-ratio: 3 / 2;
  }

  .gallery-preview__item--3 .gallery-preview__image :global(img) {
    aspect-ratio: 3 / 2;
  }

  .gallery-preview__item--4 .gallery-preview__image :global(img) {
    aspect-ratio: 16 / 6;
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery-preview__image:hover :global(img) {
      transform: scale(1.035);
    }

    .gallery-preview__item--1 .gallery-preview__image:hover :global(img) {
      transform: scale(1.02);
    }
  }

  .gallery-preview__item > p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .gallery-preview__item--1 > p span:first-child {
    color: var(--ink);
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-title-card);
  }

  .gallery-preview__item > p span:last-child {
    font-family: var(--font-noto-sans);
    font-size: 0.72rem;
  }

  @media (max-width: 767px) {
    .home-gallery__inner::before {
      top: 30%;
      right: -10%;
      width: 70%;
      height: 24%;
    }

    .home-gallery__stage-mark {
      top: 11rem;
      font-size: var(--type-glyph-chapter);
    }

    .gallery-preview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: 2rem 1rem;
    }

    .gallery-preview__item--1,
    .gallery-preview__item--2,
    .gallery-preview__item--3,
    .gallery-preview__item--4 {
      grid-column: auto;
      grid-row: auto;
      margin-top: 0;
      transform: none;
    }

    .gallery-preview__item--1 {
      grid-column: 1 / -1;
    }

    .gallery-preview__item--4 {
      grid-column: 1 / -1;
    }

    .gallery-preview__item--4 .gallery-preview__image :global(img) {
      aspect-ratio: 16 / 7;
    }

    .gallery-preview__item--1 .gallery-preview__image :global(img) {
      aspect-ratio: 16 / 8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-preview__image :global(img) {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, onDesktopViewport } from '../../scripts/scroll';

  // 暗室视差与首页其余动效同策略：跨 768 断点时重建或清理，避免移动布局残留位移
  onDesktopViewport(() => {
    const teardowns: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>('[data-gallery-parallax]').forEach((media, index) => {
      const tween = gsap.fromTo(
        media,
        { yPercent: index % 2 === 0 ? 2 : -2 },
        {
          yPercent: index % 2 === 0 ? -3 : 3,
          ease: 'none',
          scrollTrigger: { trigger: media, start: 'top bottom', end: 'bottom top', scrub: true },
        },
      );
      teardowns.push(() => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(media, { clearProps: 'transform' });
      });
    });
    return () => teardowns.forEach((teardown) => teardown());
  });
</script>
