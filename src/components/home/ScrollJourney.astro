---
// 占位数据，后续阶段替换为真实内容
const intro = ['长卷将于第四阶段随滚动展开，此处先立其位。'];

// 第四阶段在此接 GSAP ScrollTrigger 滚动叙事：
// 届时下方占位山水替换为真实画卷素材，随滚动横向展开
---

<section class="bg-paper-deep" aria-labelledby="scroll-journey">
  <div class="mx-auto max-w-wide px-5 py-24 md:px-8 md:py-32">
    <h2 id="scroll-journey" class="mb-6">山水长卷</h2>
    {intro.map((paragraph) => <p class="max-w-content text-ink-soft">{paragraph}</p>)}

    {/* 占位山水：第四阶段在此接 GSAP ScrollTrigger 滚动叙事 */}
    <div
      aria-hidden="true"
      class="relative mt-12 h-[40vh] overflow-hidden rounded-sm border border-line md:mt-16"
    >
      <div class="ridge ridge--far"></div>
      <div class="ridge ridge--mid"></div>
      <div class="ridge ridge--near"></div>
    </div>
  </div>
</section>

<style>
  /*
   * 三层远山剪影：纯 CSS 叠形，不用图片与 JS。
   * 越远越淡、越近越浓，取水墨空气透视之意；颜色走运行时变量，昼夜自动切换。
   */
  .ridge {
    position: absolute;
    inset: 0;
  }

  .ridge--far {
    background: color-mix(in oklab, var(--pine) 16%, transparent);
    clip-path: polygon(
      0% 58%,
      10% 44%,
      22% 56%,
      36% 34%,
      50% 52%,
      64% 38%,
      78% 54%,
      90% 42%,
      100% 54%,
      100% 100%,
      0% 100%
    );
  }

  .ridge--mid {
    background: color-mix(in oklab, var(--ink) 10%, transparent);
    clip-path: polygon(
      0% 72%,
      8% 56%,
      20% 68%,
      32% 48%,
      46% 66%,
      60% 46%,
      74% 64%,
      86% 54%,
      100% 68%,
      100% 100%,
      0% 100%
    );
  }

  .ridge--near {
    background: color-mix(in oklab, var(--ink) 18%, transparent);
    clip-path: polygon(
      0% 86%,
      14% 70%,
      28% 82%,
      44% 62%,
      58% 80%,
      72% 66%,
      86% 80%,
      100% 72%,
      100% 100%,
      0% 100%
    );
  }
</style>
