---
// 首页「关于此间」：页尾全宽收尾区块。左名片列（头像+署名+社链+统计），右文字列（介绍/主题/签名/墨环竹影）。
// 文案走 homeContent，统计数字由 index.astro 从文章数据派生传入。
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../../assets/touxiang.jpg';
import { homeContent } from '../../config/homeContent';

interface Props {
  /** 站点统计：文章数、分类数、最早文章年份（数据派生，不手维护） */
  stats: { posts: number; categories: number; sinceYear: number };
}

const { stats } = Astro.props;
const { about, profile } = homeContent;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker" data-font-role="hand">{about.kicker}</p>
        <h2 class="section-title" id="about-title" data-font-role="cal">{about.title}</h2>
      </div>
    </div>

    <div class="about-grid">
      <aside class="profile-card reveal" aria-label="主人名片">
        <div class="profile-head">
          <Image
            class="avatar"
            src={avatar}
            alt={`${profile.name}的头像`}
            width={184}
            height={184}
            format="webp"
          />
          <div class="profile-id">
            <div class="profile-name" data-font-role="cal">{profile.name}</div>
            <p class="profile-one">{profile.oneLiner}</p>
          </div>
        </div>

        <div class="profile-socials">
          <a href={profile.github} target="_blank" rel="noopener noreferrer">
            <Icon name="lucide:github" />GitHub
          </a>
          {profile.emails.map((m) => (
            <a href={`mailto:${m.address}`}>
              <Icon name="lucide:mail" />{m.label}
            </a>
          ))}
        </div>

        <div class="profile-stats">
          <div><b data-font-role="cal">{String(stats.posts).padStart(2, '0')}</b><span>{profile.statsLabels.posts}</span></div>
          <div><b data-font-role="cal">{String(stats.categories).padStart(2, '0')}</b><span>{profile.statsLabels.categories}</span></div>
          <div><b data-font-role="cal">{stats.sinceYear}</b><span>{profile.statsLabels.since}</span></div>
        </div>
      </aside>

      <div class="about-main">
        <div class="about-text reveal">
          {about.intro.map((line) => <p>{line}</p>)}
        </div>
        <div class="about-topics reveal" aria-label="长期记录主题">
          {about.topics.map((topic) => <span>{topic}</span>)}
        </div>
        <div class="about-foot reveal">
          <p class="about-signature">{about.signature}</p>
          <div class="about-seal" aria-hidden="true" data-font-role="cal">{about.seal[0]}<br />{about.seal[1]}</div>
          <div class="ink-orbit" aria-hidden="true">
            <div class="ink-circle"></div>
            <svg class="bamboo" viewBox="0 0 340 340" xmlns="http://www.w3.org/2000/svg">
              <g fill="none" stroke="#586258" stroke-linecap="round">
                <path d="M108 294C131 236 151 177 173 78" stroke-width="5" opacity=".72" />
                <path d="M170 93C204 111 228 135 250 168" stroke-width="2.7" opacity=".58" />
                <path d="M148 170C114 153 90 132 70 101" stroke-width="2.5" opacity=".5" />
                <path d="M129 226C160 218 187 221 215 236" stroke-width="2.4" opacity=".5" />
                <path d="M116 267C92 254 74 237 59 214" stroke-width="2.1" opacity=".42" />
              </g>
              <g fill="#586258">
                <ellipse cx="218" cy="125" rx="9" ry="32" transform="rotate(-42 218 125)" opacity=".44" />
                <ellipse cx="246" cy="160" rx="8" ry="28" transform="rotate(-30 246 160)" opacity=".37" />
                <ellipse cx="98" cy="132" rx="9" ry="33" transform="rotate(43 98 132)" opacity=".39" />
                <ellipse cx="70" cy="101" rx="8" ry="28" transform="rotate(38 70 101)" opacity=".31" />
                <ellipse cx="181" cy="224" rx="9" ry="33" transform="rotate(-74 181 224)" opacity=".39" />
                <ellipse cx="212" cy="235" rx="8" ry="28" transform="rotate(-63 212 235)" opacity=".32" />
                <ellipse cx="87" cy="252" rx="8" ry="28" transform="rotate(51 87 252)" opacity=".32" />
                <ellipse cx="59" cy="215" rx="7" ry="25" transform="rotate(42 59 215)" opacity=".26" />
              </g>
              <g stroke="#f2eee3" stroke-width="1.6" opacity=".42">
                <path d="M148 169l14 4" />
                <path d="M160 126l14 4" />
                <path d="M132 219l13 4" />
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.28), transparent 48%),
      var(--paper);
    border-top: 1px solid var(--line);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
  }

  /* ============ 名片列 ============ */
  .profile-card {
    position: sticky;
    top: 96px;
    padding: 30px 28px 26px;
    background: rgb(251 249 243 / 66%);
    border-top: 2px solid var(--ink);
    border-left: 3px solid var(--cinnabar);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 18px 40px -22px var(--shadow);
  }

  /* 底部淡墨晕染 */
  .profile-card::after {
    content: "";
    position: absolute;
    right: -12%;
    bottom: -18%;
    width: 70%;
    aspect-ratio: 1.6;
    background: radial-gradient(ellipse at center, rgb(63 72 65 / 8%), transparent 65%);
    filter: blur(6px);
    pointer-events: none;
  }

  :global(html[data-theme='night']) .profile-card {
    background: rgb(233 226 208 / 5%);
  }

  .profile-head {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .avatar {
    width: 92px;
    aspect-ratio: 1;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--line-strong), 0 0 0 5px rgb(251 249 243 / 60%);
  }

  .profile-name {
    font-size: 2rem;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .profile-one {
    margin: 6px 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    line-height: 1.7;
  }

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .profile-socials a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 5px 13px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 230ms ease, background 230ms ease, transform 230ms var(--ease);
  }

  .profile-socials a :global(svg) {
    width: 15px;
    height: 15px;
  }

  @media (hover: hover) and (pointer: fine) {
    .profile-socials a:hover {
      color: var(--paper-light);
      background: var(--ink);
      transform: translateY(-2px);
    }
  }

  .profile-socials a:active {
    transform: scale(0.97);
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .profile-stats b {
    display: block;
    color: var(--cinnabar);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .profile-stats span {
    color: var(--ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  /* ============ 文字列 ============ */
  .about-text {
    max-width: 650px;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 2.15;
  }

  .about-text p {
    margin: 0 0 14px;
  }

  .about-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .about-topics span {
    padding: 4px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--moss-deep);
    font-size: 0.88rem;
    letter-spacing: 0.12em;
  }

  /* 签名、印章、墨环竹影同排收束右列 */
  .about-foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 44px);
    margin-top: 38px;
  }

  .about-signature {
    display: inline-block;
    margin: 0;
    padding: 7px 0;
    border-bottom: 1px solid rgba(164,68,52,0.45);
    color: var(--moss-deep);
    letter-spacing: 0.16em;
  }

  .about-seal {
    width: 58px;
    aspect-ratio: 1;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    color: #f8eee4;
    background: rgba(164,68,52,0.9);
    border: 1px solid var(--cinnabar-deep);
    font-size: 0.72rem;
    line-height: 1.45;
    text-align: center;
    transform: rotate(4deg);
    box-shadow: inset 0 0 0 4px rgba(255,255,255,0.13);
  }

  /* 墨环竹影：缩小为伴章,不再独占大区块 */
  .ink-orbit {
    position: relative;
    margin-left: auto;
    width: 220px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .ink-circle {
    position: absolute;
    width: min(100%, 220px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 12px solid transparent;
    background:
      radial-gradient(circle at 51% 49%, var(--paper) 0 57%, transparent 58%),
      conic-gradient(from 12deg,
        rgba(44,48,44,0.82),
        rgba(63,70,64,0.4) 12%,
        rgba(44,48,44,0.78) 22%,
        rgba(63,70,64,0.22) 36%,
        rgba(44,48,44,0.72) 52%,
        rgba(63,70,64,0.28) 66%,
        rgba(44,48,44,0.84) 82%,
        rgba(63,70,64,0.3));
    filter: blur(0.35px);
    opacity: 0.72;
    transform: rotate(-12deg) scaleX(1.02);
    -webkit-mask: radial-gradient(circle, transparent 0 56%, #000 57% 66%, transparent 67%);
    mask: radial-gradient(circle, transparent 0 56%, #000 57% 66%, transparent 67%);
  }

  .ink-circle::before,
  .ink-circle::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    background: rgba(46, 51, 47, 0.16);
    filter: blur(4px);
  }

  .ink-circle::before {
    width: 42px;
    height: 20px;
    left: -6px;
    top: 52%;
    transform: rotate(-20deg);
  }

  .ink-circle::after {
    width: 30px;
    height: 14px;
    right: 8px;
    bottom: 20%;
    transform: rotate(18deg);
  }

  .bamboo {
    position: relative;
    z-index: 2;
    width: 82%;
    overflow: visible;
  }

  /* ============ 夜色覆盖 ============ */
  :global(html[data-theme='night']) .about {
    background:
      linear-gradient(180deg, rgba(233, 226, 208, 0.05), transparent 48%),
      var(--paper);
  }

  :global(html[data-theme='night']) .ink-circle {
    background:
      radial-gradient(circle at 51% 49%, var(--paper) 0 57%, transparent 58%),
      conic-gradient(from 12deg,
        rgba(233, 226, 208, 0.7),
        rgba(163, 155, 133, 0.35) 12%,
        rgba(233, 226, 208, 0.66) 22%,
        rgba(163, 155, 133, 0.2) 36%,
        rgba(233, 226, 208, 0.62) 52%,
        rgba(163, 155, 133, 0.24) 66%,
        rgba(233, 226, 208, 0.72) 82%,
        rgba(163, 155, 133, 0.26));
  }

  :global(html[data-theme='night']) .ink-circle::before,
  :global(html[data-theme='night']) .ink-circle::after {
    background: rgba(233, 226, 208, 0.14);
  }

  :global(html[data-theme='night']) .bamboo {
    filter: brightness(1.65);
  }

  :global(html[data-theme='night']) .about-topics span {
    color: var(--moss);
  }

  /* ============ 响应式 ============ */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .profile-card {
      position: static;
      max-width: 460px;
    }

    .ink-orbit {
      margin-left: 0;
    }
  }

  @media (max-width: 620px) {
    .profile-card {
      padding: 24px 20px 20px;
    }

    .profile-name {
      font-size: 1.7rem;
    }

    .about-foot {
      gap: 18px;
    }

    .ink-orbit {
      width: 180px;
    }
  }
</style>
