---
// 首页「关于此间」：页尾全宽收尾区块。左名片列（头像+署名+社链+统计，右缘题签装饰），右文字列（介绍/主题/签名/印章）。
// 背景层为竹林水墨画（.about-grove，绝对定位不占高、multiply 透纸色）。文案走 homeContent，统计数字由 index.astro 从文章数据派生传入。
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../../assets/touxiang.jpg';
import aboutBamboo from '../../assets/about-bamboo.png';
import { homeContent } from '../../config/homeContent';

interface Props {
  /** 站点统计：文章数、分类数、最早文章年份（数据派生，不手维护） */
  stats: { posts: number; categories: number; sinceYear: number };
}

const { stats } = Astro.props;
const { about, profile } = homeContent;
---

<section class="section about" id="about" aria-labelledby="about-title">
  {/* 竹林水墨背景层：铺满板块、绝对定位不占高；blend-mode 透纸色，低透明度不抢正文 */}
  <div class="about-grove" aria-hidden="true">
    <Image
      src={aboutBamboo}
      alt=""
      widths={[960, 1440, 1672]}
      sizes="100vw"
      loading="lazy"
    />
  </div>
  {/* 纸色纱罩：左实右虚，文字区归于留白，画意让给右侧；var(--paper) 随主题自适应 */}
  <div class="about-veil" aria-hidden="true"></div>

  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker" data-font-role="hand">{about.kicker}</p>
        <h2 class="section-title" id="about-title" data-font-role="cal">{about.title}</h2>
      </div>
    </div>

    <div class="about-grid">
      <aside class="profile-card reveal" aria-label="主人名片">
        {/* 右缘竖排题签：线装书式点缀，字出 homeContent */}
        <span class="card-label" aria-hidden="true" data-font-role="cal">{profile.cardLabel}</span>
        <div class="profile-head">
          <Image
            class="avatar"
            src={avatar}
            alt={`${profile.name}的头像`}
            width={184}
            height={184}
            format="webp"
          />
          <div class="profile-id">
            <div class="profile-name" data-font-role="cal">{profile.name}</div>
            <p class="profile-one">{profile.oneLiner}</p>
          </div>
        </div>

        <div class="profile-socials">
          <a href={profile.github} target="_blank" rel="noopener noreferrer">
            <Icon name="lucide:github" />GitHub
          </a>
          {profile.emails.map((m) => (
            <a href={`mailto:${m.address}`}>
              <Icon name="lucide:mail" />{m.label}
            </a>
          ))}
        </div>

        <div class="profile-stats">
          <div><b data-font-role="cal">{String(stats.posts).padStart(2, '0')}</b><span>{profile.statsLabels.posts}</span></div>
          <div><b data-font-role="cal">{String(stats.categories).padStart(2, '0')}</b><span>{profile.statsLabels.categories}</span></div>
          <div><b data-font-role="cal">{stats.sinceYear}</b><span>{profile.statsLabels.since}</span></div>
        </div>
      </aside>

      <div class="about-main">
        <div class="about-text reveal">
          {about.intro.map((line) => <p>{line}</p>)}
        </div>
        <div class="about-topics reveal" aria-label="长期记录主题">
          {about.topics.map((topic) => <span>{topic}</span>)}
        </div>
        <div class="about-foot reveal">
          <p class="about-signature">{about.signature}</p>
          <div class="about-seal" aria-hidden="true" data-font-role="cal">{about.seal[0]}<br />{about.seal[1]}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    overflow: hidden;
    padding-block: clamp(56px, 6vw, 84px);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.28), transparent 48%),
      var(--paper);
    border-top: 1px solid var(--line);
  }

  /* 竹林水墨背景层：铺在内容之下，multiply 透纸色（白处见纸、墨处沉色） */
  .about-grove {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .about-grove img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 纸色纱罩：左实右虚，护住文字区 */
  .about-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, var(--paper) 22%, transparent 58%);
    pointer-events: none;
  }

  .about .shell {
    position: relative;
    z-index: 1;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
  }

  /* ============ 名片列 ============ */
  .profile-card {
    position: sticky;
    top: 96px;
    padding: 30px 28px 26px;
    background: rgb(251 249 243 / 66%);
    border-top: 2px solid var(--ink);
    border-left: 3px solid var(--cinnabar);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 18px 40px -22px var(--shadow);
  }

  /* 底部淡墨晕染 */
  .profile-card::after {
    content: "";
    position: absolute;
    right: -12%;
    bottom: -18%;
    width: 70%;
    aspect-ratio: 1.6;
    background: radial-gradient(ellipse at center, rgb(63 72 65 / 8%), transparent 65%);
    filter: blur(6px);
    pointer-events: none;
  }

  :global(html[data-theme='night']) .profile-card {
    background: rgb(233 226 208 / 5%);
  }

  /* 题签：右缘竖排小签，半挂在卡外，如线装书题签 */
  .card-label {
    position: absolute;
    top: 30px;
    right: -13px;
    padding: 10px 3px;
    border: 1px solid var(--cinnabar);
    color: var(--cinnabar);
    background: var(--paper-light);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-align: center;
    writing-mode: vertical-rl;
    box-shadow: 0 4px 10px -6px var(--shadow);
  }

  :global(html[data-theme='night']) .card-label {
    background: #2a2d29;
  }

  .profile-head {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .avatar {
    width: 92px;
    aspect-ratio: 1;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--line-strong), 0 0 0 5px rgb(251 249 243 / 60%);
  }

  .profile-name {
    font-size: 2rem;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .profile-one {
    margin: 6px 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    line-height: 1.7;
  }

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .profile-socials a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 5px 13px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 230ms ease, background 230ms ease, transform 230ms var(--ease);
  }

  .profile-socials a :global(svg) {
    width: 15px;
    height: 15px;
  }

  @media (hover: hover) and (pointer: fine) {
    .profile-socials a:hover {
      color: var(--paper-light);
      background: var(--ink);
      transform: translateY(-2px);
    }
  }

  .profile-socials a:active {
    transform: scale(0.97);
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .profile-stats b {
    display: block;
    color: var(--cinnabar);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .profile-stats span {
    color: var(--ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  /* ============ 文字列 ============ */
  .about-text {
    max-width: 650px;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 2.15;
  }

  .about-text p {
    margin: 0 0 14px;
  }

  .about-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .about-topics span {
    padding: 4px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--moss-deep);
    font-size: 0.88rem;
    letter-spacing: 0.12em;
  }

  /* 签名与印章同排收束右列 */
  .about-foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 44px);
    margin-top: 24px;
  }

  .about-signature {
    display: inline-block;
    margin: 0;
    padding: 7px 0;
    border-bottom: 1px solid rgba(164,68,52,0.45);
    color: var(--moss-deep);
    letter-spacing: 0.16em;
  }

  .about-seal {
    width: 58px;
    aspect-ratio: 1;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    color: #f8eee4;
    background: rgba(164,68,52,0.9);
    border: 1px solid var(--cinnabar-deep);
    font-size: 0.72rem;
    line-height: 1.45;
    text-align: center;
    transform: rotate(4deg);
    box-shadow: inset 0 0 0 4px rgba(255,255,255,0.13);
  }

  /* ============ 夜色覆盖 ============ */
  :global(html[data-theme='night']) .about {
    background:
      linear-gradient(180deg, rgba(233, 226, 208, 0.05), transparent 48%),
      var(--paper);
  }

  :global(html[data-theme='night']) .about-grove {
    opacity: 0.16;
    /* 反色后以 screen 叠印：墨竹化作月白竹影浮在暗纸上，multiply 在暗底会隐没 */
    mix-blend-mode: screen;
    filter: invert(0.94) brightness(0.85);
  }

  :global(html[data-theme='night']) .about-topics span {
    color: var(--moss);
  }

  /* ============ 响应式 ============ */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .profile-card {
      position: static;
      max-width: 460px;
    }
  }

  @media (max-width: 620px) {
    .profile-card {
      padding: 24px 20px 20px;
    }

    .profile-name {
      font-size: 1.7rem;
    }

    .about-foot {
      gap: 18px;
    }

    /* 移动端主体偏右：保住右侧立竹 */
    .about-grove img {
      object-position: 68% center;
    }
  }
</style>
