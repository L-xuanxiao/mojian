---
import { Image } from 'astro:assets';
import InscriptionTip from '../InscriptionTip';
import heroArtwork from '../../assets/art/hero-paper-mountains.webp';
import heroFar from '../../assets/art/layers/hero-mountain-far.webp';
import heroMid from '../../assets/art/layers/hero-mountain-mid.webp';
import heroNear from '../../assets/art/layers/hero-mountain-near.webp';
import { withBase } from '../../site.config';

const heroArtStyle = `--hero-art: url("${heroArtwork.src}")`;
---

<section
  class="hero"
  aria-label="站点卷首"
  data-hero
  data-home-chapter="卷"
  data-home-chapter-title="卷首"
  data-ink-scene="hero"
>
  <div class="hero__hold">
    <span class="mist mist--a hero__mist-a" aria-hidden="true"></span>
    <span class="mist mist--b hero__mist-b" aria-hidden="true"></span>
    <span class="hero__under-sheet" data-hero-sheet aria-hidden="true"></span>
    <svg class="hero__ink-bloom" viewBox="0 0 320 320" aria-hidden="true">
      <path
        data-hero-ink-spot
        d="M151 38c25 4 35 34 56 45 25 13 63 7 74 34 12 29-20 54-23 82-3 31 24 62 4 85-21 24-56 2-84 7-31 6-57 34-82 17-24-16-11-51-22-77-11-27-44-44-38-73 6-30 43-38 64-58 20-18 29-57 57-52Z"
      ></path>
      <path
        data-hero-ink-spot
        d="M134 67c22-17 49 7 68 20 22 15 56 20 61 47 5 26-25 44-33 68-8 26 2 60-22 74-25 14-50-11-77-15-28-4-63 10-80-13-17-23 8-51 10-79 3-26-14-57 7-75 20-17 48 0 66-17Z"
      ></path>
      <path
        data-hero-ink-spot
        d="M164 89c20 0 31 25 48 35 18 11 48 11 54 32 6 22-18 39-24 60-7 22 1 51-19 63-21 12-43-10-66-13-24-3-52 11-68-7-15-19 5-43 8-66 3-22-11-49 7-63 18-15 40 1 57-11 16-11 24-37 44-37Z"
      ></path>
    </svg>

    <div class="hero__folio" aria-hidden="true">
      <span>MOJIAN · 2026</span>
      <span>个人数字书卷</span>
      <span>卷一 · 夺卷入画</span>
    </div>

    <div class="hero__stage mx-auto max-w-stage px-5 md:px-8 lg:px-10">
      <figure class="hero__art" data-hero-art>
        <img
          class="hero__fallback"
          src={heroArtwork.src}
          alt="层叠宣纸与墨色构成的抽象山形"
          width={heroArtwork.width}
          height={heroArtwork.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="hero__layers" aria-hidden="true">
          <div class="hero__layer hero__layer--far" data-hero-layer="far">
            <Image
              src={heroFar}
              alt=""
              widths={[720, 1080, 1536]}
              sizes="(min-width: 1024px) 72vw, 100vw"
              quality={86}
              loading="eager"
            />
          </div>
          <span class="hero__layer-mist" aria-hidden="true"></span>
          <div class="hero__layer hero__layer--mid" data-hero-layer="mid">
            <Image
              src={heroMid}
              alt=""
              widths={[720, 1080, 1536]}
              sizes="(min-width: 1024px) 72vw, 100vw"
              quality={86}
              loading="eager"
            />
          </div>
          <div class="hero__layer hero__layer--near" data-hero-layer="near">
            <Image
              src={heroNear}
              alt=""
              widths={[720, 1080, 1536]}
              sizes="(min-width: 1024px) 72vw, 100vw"
              quality={88}
              loading="eager"
            />
          </div>
        </div>
        <figcaption aria-hidden="true">纸山 · 卷首</figcaption>
      </figure>

      <div class="hero__copy" data-ink-avoid>
        <p class="folio-label hero__eyebrow">纸上留白 · 墨分五色</p>
        <h1 class="hero__title font-display" aria-label="墨笺" style={heroArtStyle}>
          <span class="hero-title-mask hero-title-mask--ink">
            <span class="hero-title-line hero-title-line--ink">墨</span>
            <svg
              class="hero-title-brush hero-title-brush--ink"
              data-hero-brush="ink"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <mask id="hero-brush-mask-ink" maskUnits="userSpaceOnUse">
                  <g class="hero-brush-paths">
                    <path d="M20 17 80 17"></path>
                    <path d="M25 18 24 54"></path>
                    <path d="M76 18 76 54"></path>
                    <path d="M24 35 76 35"></path>
                    <path d="M50 18 50 55"></path>
                    <path d="M23 54 78 54"></path>
                    <path d="M50 57 50 88"></path>
                    <path d="M25 70 76 70"></path>
                    <path d="M19 89 82 89"></path>
                  </g>
                </mask>
              </defs>
              <text x="50" y="88" text-anchor="middle" mask="url(#hero-brush-mask-ink)"> 墨 </text>
            </svg>
          </span>
          <span class="hero-title-mask hero-title-mask--paper">
            <span class="hero-title-line hero-title-line--paper">笺</span>
            <svg
              class="hero-title-brush hero-title-brush--paper"
              data-hero-brush="paper"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <mask id="hero-brush-mask-paper" maskUnits="userSpaceOnUse">
                  <g class="hero-brush-paths">
                    <path d="M25 13 14 32"></path>
                    <path d="M20 22 46 22"></path>
                    <path d="M52 13 43 33"></path>
                    <path d="M48 22 80 22"></path>
                    <path d="M17 42 76 39"></path>
                    <path d="M24 57 77 52"></path>
                    <path d="M31 36 39 82"></path>
                    <path d="M61 34 71 76"></path>
                    <path d="M22 85 82 78"></path>
                  </g>
                </mask>
              </defs>
              <text x="50" y="88" text-anchor="middle" mask="url(#hero-brush-mask-paper)">
                笺
              </text>
            </svg>
          </span>
        </h1>
        <div class="hero__statement">
          <p>写字、造物、看光影。让数字世界也保留纸张的呼吸。</p>
          <nav class="hero__links" aria-label="卷首入口">
            <a class="ink-link" href={withBase('/journal/')}>读笺录</a>
            <a class="ink-link" href={withBase('/projects/')}>看器作</a>
          </nav>
          {/* 移动端卷首钤印：竖排 colophon 被收起后，落款仪式移入 statement 卡角 */}
          <span class="seal-block hero__seal hero__seal--inset" aria-hidden="true">墨</span>
        </div>
      </div>

      <div class="hero__colophon">
        <span aria-hidden="true">入画</span>
        <InscriptionTip text="卷首钤印 · 墨" client:idle>
          <span class="seal-block hero__seal" data-hero-seal aria-hidden="true">墨</span>
        </InscriptionTip>
        <span aria-hidden="true">展卷</span>
      </div>

      <p class="hero__scroll" aria-hidden="true">
        <span>向下夺卷</span>
        <span class="hero__scroll-line"></span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 桌面卷首约七成半屏：首屏底部露出近况章头，与全站编辑流密度一致；移动端保持近满屏 */
    min-height: min(75svh, 46rem);
    overflow: clip;
  }
  .hero__hold {
    position: relative;
    isolation: isolate;
    min-height: inherit;
    overflow: clip;
  }

  .hero__ink-bloom {
    position: absolute;
    top: 50%;
    left: 18%;
    z-index: 4;
    width: clamp(18rem, 36vw, 36rem);
    color: color-mix(in oklab, var(--ink) 30%, transparent);
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .hero__ink-bloom path {
    fill: currentColor;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero__under-sheet {
    position: absolute;
    z-index: -1;
    top: clamp(4rem, 10vh, 7rem);
    right: -8vw;
    bottom: clamp(2rem, 7vh, 5rem);
    left: clamp(12vw, 18vw, 22rem);
    border-block: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 94%, var(--paper-deep));
    box-shadow: -1.5rem 1.5rem 4rem var(--shadow-color);
    transform: rotate(-0.8deg);
    transform-origin: left center;
  }
  .hero__under-sheet::before,
  .hero__under-sheet::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--line) 16% 84%, transparent);
  }
  .hero__under-sheet::before {
    left: clamp(1.5rem, 4vw, 4rem);
  }
  .hero__under-sheet::after {
    right: clamp(1.5rem, 4vw, 4rem);
  }

  .hero__folio {
    position: absolute;
    top: clamp(1.1rem, 3vw, 2.25rem);
    right: clamp(1.25rem, 4vw, 3.5rem);
    left: clamp(1.25rem, 4vw, 3.5rem);
    z-index: 7;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
  }
  .hero__folio span:nth-child(2) {
    justify-self: center;
  }
  .hero__folio span:last-child {
    justify-self: end;
  }

  .hero__stage {
    position: relative;
    display: grid;
    min-height: inherit;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr;
    align-items: center;
    padding-block: clamp(3.75rem, 7vh, 5.5rem) clamp(2.75rem, 5vh, 4rem);
  }
  .hero__art {
    position: relative;
    isolation: isolate;
    z-index: 2;
    grid-row: 1;
    grid-column: 4 / -1;
    width: calc(100% + clamp(4rem, 10vw, 10rem));
    margin-right: clamp(-10rem, -10vw, -4rem);
    border-block: 1px solid color-mix(in oklab, var(--ink) 24%, transparent);
    background: var(--paper-deep);
    box-shadow: var(--shadow-lg);
    transform: rotate(0.65deg);
  }
  .hero__art::before {
    content: '';
    position: absolute;
    z-index: 7;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--paper) 86%, transparent),
      transparent 22% 82%,
      color-mix(in oklab, var(--paper-deep) 54%, transparent)
    );
    pointer-events: none;
  }
  .hero__art :global(img) {
    display: block;
    width: 100%;
    /* 固定高而非 min-height：宽视口下自然比例（3:2）会把图撑过 75svh 上限 */
    height: min(48vh, 36rem);
    object-fit: cover;
  }
  .hero__fallback {
    position: relative;
    z-index: 0;
  }
  .hero__layers {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  :global(html.js) .hero__layers {
    display: block;
  }
  :global(html.js) .hero__fallback {
    opacity: 0;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero__layer :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    will-change: transform;
  }
  .hero__layer--far {
    z-index: 1;
    opacity: 0.82;
  }
  .hero__layer-mist {
    position: absolute;
    z-index: 2;
    right: 4%;
    bottom: 12%;
    width: 70%;
    height: 52%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--paper) 70%, transparent),
      transparent 72%
    );
    opacity: 0.44;
  }
  .hero__layer--mid {
    z-index: 3;
  }
  .hero__layer--near {
    z-index: 4;
  }
  .hero__art figcaption {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    z-index: 9;
    padding: 0.2rem 0.5rem;
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
  }

  .hero__copy {
    position: relative;
    z-index: 5;
    grid-row: 1;
    grid-column: 1 / -1;
    min-height: min(48vh, 36rem);
    pointer-events: none;
  }
  .hero__eyebrow {
    position: absolute;
    top: 8%;
    left: 0;
    margin: 0;
    writing-mode: vertical-rl;
  }
  .hero__title {
    position: absolute;
    inset: 0;
    margin: 0;
    font-weight: 400;
    line-height: 0.7;
    letter-spacing: -0.04em;
    pointer-events: none;
  }
  .hero-title-mask {
    position: absolute;
    display: block;
    overflow: visible;
    padding: 0.12em 0.05em 0.2em;
    margin: -0.12em -0.05em -0.2em;
  }
  .hero-title-mask--ink {
    top: 50%;
    left: -6%;
    transform: translateY(-52%);
  }
  .hero-title-mask--paper {
    right: -2%;
    bottom: -4%;
  }
  .hero-title-line {
    position: relative;
    z-index: 1;
    display: block;
    line-height: 0.94;
  }

  .hero-title-brush {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
  }

  .hero-title-brush text {
    fill: currentColor;
    font-family: var(--font-ma-shan-zheng);
    font-size: 94px;
    font-weight: 400;
  }

  .hero-title-brush--ink {
    color: color-mix(in oklab, var(--ink) 82%, transparent);
  }

  .hero-title-brush--paper {
    color: var(--cinnabar);
  }

  .hero-brush-paths {
    fill: none;
    stroke: white;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 17;
  }
  .hero-title-line--ink {
    background-image:
      linear-gradient(
        color-mix(in oklab, var(--ink) 82%, transparent),
        color-mix(in oklab, var(--ink) 52%, transparent)
      ),
      var(--hero-art);
    background-blend-mode: multiply;
    background-position: 52% center;
    background-size: cover;
    color: transparent;
    font-size: var(--type-hero-primary);
    -webkit-background-clip: text;
    background-clip: text;
    filter: contrast(1.12) saturate(0.66);
    -webkit-text-stroke: 1px color-mix(in oklab, var(--ink) 34%, transparent);
    text-shadow: 0 0 1px color-mix(in oklab, var(--ink) 42%, transparent);
  }
  .hero-title-line--paper {
    color: var(--cinnabar);
    font-size: var(--type-hero-secondary);
    text-shadow:
      0.045em 0.055em 0 var(--paper),
      0.055em 0.065em 0 var(--line);
  }

  .hero__statement {
    position: absolute;
    bottom: 2%;
    left: clamp(1.5rem, 8vw, 7rem);
    display: grid;
    width: min(38rem, 64vw);
    grid-template-columns: minmax(15rem, 29rem) auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: 1.1rem 1.25rem;
    border-top: 1px solid var(--ink);
    /* 纸底已 88% 不透明，可承托文字；全站玻璃拟态仅页眉一处，此处不再 blur */
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    pointer-events: auto;
  }
  .hero__statement > p {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.9;
  }
  .hero__links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-noto-sans);
    font-size: 0.82rem;
  }
  .hero__links a {
    color: var(--ink);
    /* 常驻淡墨下划线：首屏入口不依赖 hover 即可被识别为链接 */
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--ink) 38%, transparent);
    text-underline-offset: 0.4em;
    transition: text-decoration-color 150ms var(--ease-ink);
  }

  .hero__links a:hover {
    text-decoration-color: var(--ink);
  }

  .hero__colophon {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    writing-mode: vertical-rl;
    transform: translateY(-50%);
    color: var(--ink);
    font-size: 0.72rem;
    letter-spacing: 0.35em;
  }
  .hero__seal {
    position: relative;
    width: 2.6rem;
    height: 2.6rem;
    box-shadow:
      0 0 0 0.3rem var(--paper),
      0 0 0 calc(0.3rem + 1px) var(--cinnabar);
    font-size: 1.5rem;
    letter-spacing: 0;
  }
  .hero__seal::after {
    content: '';
    position: absolute;
    inset: -0.55rem;
    border: 1.5px solid var(--cinnabar);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }
  .hero__mist-a {
    top: 4%;
    right: -2%;
    width: 38rem;
    height: 30rem;
  }
  .hero__mist-b {
    bottom: 0;
    left: -10%;
    width: 34rem;
    height: 26rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero[data-hero-intro='full']:not(.hero--intro-complete) .hero__seal::after {
      animation: seal-halo 0.7s var(--ease-ink) 0.84s 1 both;
    }
    :global(html.js) .hero[data-hero-intro='light']:not(.hero--intro-complete) .hero__seal::after {
      animation: seal-halo 0.44s var(--ease-ink) 0.22s 1 both;
    }
    :global(html.js) .hero-title-line,
    :global(html.js) .hero__eyebrow,
    :global(html.js) .hero__statement,
    :global(html.js) .hero__colophon,
    :global(html.js) .hero__scroll {
      opacity: 0;
    }
  }
  @keyframes seal-halo {
    from {
      opacity: 0.55;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 0;
    left: 2.5rem;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    width: 1px;
    height: 3.5rem;
    background: var(--line);
    transform-origin: top center;
    animation: scroll-breath 2.4s ease-in-out infinite;
  }
  @keyframes scroll-breath {
    0%,
    100% {
      transform: scaleY(0.45);
      opacity: 0.45;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .hero__seal--inset {
    display: none;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: calc(100svh - 5rem);
    }
    .hero__hold {
      position: relative;
      top: auto;
      min-height: inherit;
    }
    .hero__under-sheet {
      top: 4.75rem;
      right: -6rem;
      bottom: 3rem;
      left: 31%;
      transform: rotate(-1.2deg);
    }
    .hero__ink-bloom {
      top: 43%;
      left: 20%;
      width: min(82vw, 24rem);
    }
    .hero__folio {
      top: 1.25rem;
      grid-template-columns: 1fr auto;
    }
    .hero__folio span:nth-child(2) {
      display: none;
    }
    .hero__stage {
      display: grid;
      min-height: inherit;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      padding-block: 4.5rem 3.5rem;
    }
    .hero__copy {
      grid-row: 1;
      grid-column: 1;
      min-height: min(66svh, 32rem);
    }
    .hero__eyebrow {
      top: 2.5rem;
      left: 0;
    }
    .hero-title-mask--ink {
      top: 42%;
      left: -16%;
    }
    .hero-title-mask--paper {
      right: -3%;
      bottom: 1rem;
    }
    .hero-title-line--ink {
      font-size: var(--type-hero-primary);
    }
    .hero-title-line--paper {
      font-size: var(--type-hero-secondary);
    }
    .hero__statement {
      bottom: 0;
      left: 0;
      display: block;
      width: min(92%, 24rem);
      padding: 0.9rem 0;
      background: color-mix(in oklab, var(--paper) 92%, transparent);
      backdrop-filter: none;
    }

    /* 落款仪式入卡角：小印浮于 statement 上缘右侧，恢复移动端朱砂钤印 */
    .hero__seal--inset {
      position: absolute;
      top: -1.15rem;
      right: 0.8rem;
      width: 2.2rem;
      height: 2.2rem;
      font-size: 1.15rem;
      box-shadow: 0 0 0 0.22rem var(--paper);
    }
    .hero__links {
      margin-top: 1rem;
    }
    .hero__links a {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
      padding-inline: 0.25rem;
    }
    .hero__art {
      grid-row: 1;
      grid-column: 1;
      align-self: center;
      width: calc(100% + 3rem);
      margin: 0 -3rem 0 16%;
      transform: rotate(0.8deg);
    }
    .hero__art :global(img) {
      height: min(52svh, 27rem);
      min-height: 0;
      aspect-ratio: auto;
    }
    .hero__layer--mid,
    .hero__colophon {
      display: none;
    }
    .hero__scroll {
      right: 1.25rem;
      bottom: 0;
      left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line,
    .hero__seal::after {
      animation: none;
    }
  }
</style>

<script>
  import {
    gsap,
    prefersReducedMotion,
    onDesktopViewport,
    attachSealMagnet,
  } from '../../scripts/scroll';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !prefersReducedMotion) {
    const sessionKey = 'mojian:hero-intro:v1';
    let isFirstSession = false;
    try {
      isFirstSession = sessionStorage.getItem(sessionKey) !== '1';
      if (isFirstSession) sessionStorage.setItem(sessionKey, '1');
    } catch {
      // 隐私模式或存储被禁用时采用短版，不让一次性开场退化为每次重播。
      isFirstSession = false;
    }

    const introMode = isFirstSession
      ? window.matchMedia('(min-width: 768px)').matches
        ? 'full'
        : 'light'
      : 'short';
    hero.dataset.heroIntro = introMode;

    const titleLines = hero.querySelectorAll<HTMLElement>('.hero-title-line');
    const details = hero.querySelectorAll<HTMLElement>(
      '.hero__eyebrow, .hero__statement, .hero__colophon, .hero__scroll',
    );
    const inkSpots = hero.querySelectorAll<SVGPathElement>('[data-hero-ink-spot]');
    const brushSvgs = hero.querySelectorAll<SVGSVGElement>('[data-hero-brush]');
    const inkStrokes = hero.querySelectorAll<SVGPathElement>(
      '[data-hero-brush="ink"] .hero-brush-paths path',
    );
    const paperStrokes = hero.querySelectorAll<SVGPathElement>(
      '[data-hero-brush="paper"] .hero-brush-paths path',
    );
    const brushStrokes = [...inkStrokes, ...paperStrokes];
    const sheet = hero.querySelector<HTMLElement>('[data-hero-sheet]');
    const art = hero.querySelector<HTMLElement>('[data-hero-art]');
    const paperTitle = hero.querySelector<HTMLElement>('.hero-title-mask--paper');
    const seal = hero.querySelector<HTMLElement>('[data-hero-seal]');
    const layers = [
      { element: hero.querySelector<HTMLElement>('[data-hero-layer="far"]'), yPercent: 2 },
      { element: hero.querySelector<HTMLElement>('[data-hero-layer="mid"]'), yPercent: 5 },
      { element: hero.querySelector<HTMLElement>('[data-hero-layer="near"]'), yPercent: 8 },
    ].filter((layer): layer is { element: HTMLElement; yPercent: number } =>
      Boolean(layer.element),
    );

    brushStrokes.forEach((stroke) => {
      const length = stroke.getTotalLength();
      gsap.set(stroke, { strokeDasharray: length, strokeDashoffset: length });
    });

    let entranceComplete = false;
    const removeSkipListeners = () => {
      window.removeEventListener('wheel', skipEntrance);
      window.removeEventListener('touchstart', skipEntrance);
      window.removeEventListener('keydown', skipEntrance);
      window.removeEventListener('pointerdown', skipEntrance);
      window.removeEventListener('click', skipEntrance);
    };
    const finishEntrance = () => {
      if (entranceComplete) return;
      entranceComplete = true;
      removeSkipListeners();
      hero.classList.add('hero--intro-complete');
      gsap.set(inkSpots, { opacity: 0 });
      gsap.set(brushSvgs, { opacity: 0 });
      gsap.set(titleLines, { opacity: 1, clearProps: 'transform' });
      gsap.set(details, { opacity: 1, clearProps: 'transform' });
      if (sheet) gsap.set(sheet, { clipPath: 'inset(0 0% 0 0)', clearProps: 'transform' });
      if (art) gsap.set(art, { clipPath: 'inset(0 0% 0 0)', clearProps: 'transform' });
      if (seal) gsap.set(seal, { clearProps: 'transform' });
    };
    const entrance = gsap.timeline({ defaults: { ease: 'expo.out' }, onComplete: finishEntrance });
    function skipEntrance() {
      entrance.progress(1, false);
      finishEntrance();
    }

    if (introMode === 'full' || introMode === 'light') {
      const full = introMode === 'full';
      gsap.set(brushSvgs, { opacity: 1 });
      gsap.set(titleLines, { yPercent: 0, opacity: 0 });
      inkSpots.forEach((spot, index) =>
        entrance.fromTo(
          spot,
          { scale: 0.08, opacity: 0 },
          { scale: 1, opacity: full ? 0.28 : 0.2, duration: full ? 0.33 : 0.2 },
          index * (full ? 0.06 : 0.035),
        ),
      );
      entrance.to(
        inkSpots,
        { opacity: 0, duration: full ? 0.18 : 0.12, stagger: 0.02 },
        full ? 0.4 : 0.23,
      );
      if (sheet)
        entrance.fromTo(
          sheet,
          { clipPath: 'inset(0 100% 0 0)' },
          { clipPath: 'inset(0 0% 0 0)', duration: full ? 0.72 : 0.42 },
          0,
        );
      if (art)
        entrance.fromTo(
          art,
          { clipPath: 'inset(0 100% 0 0)', xPercent: 4 },
          { clipPath: 'inset(0 0% 0 0)', xPercent: 0, duration: full ? 0.82 : 0.52 },
          full ? 0.1 : 0.04,
        );
      entrance
        .to(
          inkStrokes,
          {
            strokeDashoffset: 0,
            duration: full ? 0.28 : 0.12,
            stagger: full ? 0.07 : 0.035,
            ease: 'power2.out',
          },
          full ? 0.28 : 0.12,
        )
        .to(
          paperStrokes,
          {
            strokeDashoffset: 0,
            duration: full ? 0.26 : 0.12,
            stagger: full ? 0.07 : 0.035,
            ease: 'power2.out',
          },
          full ? 0.52 : 0.2,
        )
        .to(titleLines, { opacity: 1, duration: full ? 0.12 : 0.1 }, full ? 1.22 : 0.57)
        .to(brushSvgs, { opacity: 0, duration: full ? 0.12 : 0.1 }, full ? 1.22 : 0.57)
        .fromTo(
          details,
          { y: 8, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: full ? 0.52 : 0.3,
            stagger: full ? 0.06 : 0.04,
          },
          full ? 0.56 : 0.25,
        );
      if (seal)
        entrance.fromTo(
          seal,
          { scale: 1.36, rotate: -7 },
          {
            scale: 1,
            rotate: 0,
            duration: full ? 0.38 : 0.26,
            ease: 'back.out(2.4)',
          },
          full ? 1.16 : 0.42,
        );
    } else {
      if (sheet)
        entrance.fromTo(
          sheet,
          { clipPath: 'inset(0 42% 0 0)' },
          { clipPath: 'inset(0 0% 0 0)', duration: 0.32 },
          0,
        );
      if (art)
        entrance.fromTo(
          art,
          { clipPath: 'inset(0 36% 0 0)', xPercent: 2 },
          { clipPath: 'inset(0 0% 0 0)', xPercent: 0, duration: 0.4 },
          0.03,
        );
      entrance
        .fromTo(
          titleLines,
          { yPercent: 18, opacity: 0 },
          { yPercent: 0, opacity: 1, duration: 0.36, stagger: 0.04 },
          0.05,
        )
        .fromTo(
          details,
          { y: 8, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.24, stagger: 0.025 },
          0.14,
        );
      if (seal)
        entrance.fromTo(
          seal,
          { scale: 1.18, rotate: -4 },
          { scale: 1, rotate: 0, duration: 0.2, ease: 'back.out(2)' },
          0.24,
        );
    }

    window.addEventListener('wheel', skipEntrance, { passive: true });
    window.addEventListener('touchstart', skipEntrance, { passive: true });
    window.addEventListener('keydown', skipEntrance);
    window.addEventListener('pointerdown', skipEntrance, { passive: true });
    window.addEventListener('click', skipEntrance);

    // 桌面滚动视差跟随 768 断点重建或清理：避免旋转屏后残留位移或转桌面后缺少视差
    onDesktopViewport(() => {
      const handoff = gsap.timeline({
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });
      if (sheet) handoff.to(sheet, { xPercent: -7, ease: 'none' }, 0);
      if (art) handoff.to(art, { xPercent: 9, ease: 'none' }, 0);
      if (paperTitle) handoff.to(paperTitle, { xPercent: 16, ease: 'none' }, 0);
      layers.forEach((layer) =>
        handoff.to(layer.element, { yPercent: layer.yPercent, ease: 'none' }, 0),
      );

      return () => {
        handoff.scrollTrigger?.kill();
        handoff.kill();
        const parallaxTargets = [sheet, art, paperTitle, ...layers.map((layer) => layer.element)];
        gsap.set(
          parallaxTargets.filter((target): target is HTMLElement => Boolean(target)),
          {
            clearProps: 'transform',
          },
        );
      };
    });

    // 印泥磁吸：细指针下卷首钤印被指尖轻带、弹性回位（印泥有黏性）
    if (seal) {
      const colophon = hero.querySelector<HTMLElement>('.hero__colophon');
      if (colophon) attachSealMagnet(seal, colophon);
    }
  }
</script>
