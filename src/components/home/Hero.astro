---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import coverArtwork from '../../assets/art/sketchbook/cover-unified.png';
import journalArtwork from '../../assets/art/sketchbook/journal-unified.png';
import projectsArtwork from '../../assets/art/sketchbook/projects-unified.png';
import galleryArtwork from '../../assets/art/sketchbook/gallery-unified.png';
import aboutArtwork from '../../assets/art/sketchbook/about-unified.png';
import guestbookArtwork from '../../assets/art/sketchbook/guestbook-unified.png';
import heroArtwork from '../../assets/art/hero-paper-mountains.webp';
import { site, withBase } from '../../site.config';
import { formatYearMonth } from '../../utils/date';
import { getJournalPosts } from '../../utils/journal';

const [journalEntries, projectEntries, galleryEntries, optimizedArtwork] = await Promise.all([
  getJournalPosts(),
  getCollection('projects', ({ data }) => !data.draft),
  getCollection('gallery', ({ data }) => !data.draft),
  Promise.all(
    [
      coverArtwork,
      journalArtwork,
      projectsArtwork,
      galleryArtwork,
      aboutArtwork,
      guestbookArtwork,
    ].map((src) => getImage({ src, width: 1536, format: 'webp', quality: 84 })),
  ),
]);

const featuredFirst = <T extends { data: { featured: boolean; order: number } }>(entries: T[]) =>
  [...entries].sort(
    (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
  )[0];

const latestPost = journalEntries[0];
const featuredProject = featuredFirst(projectEntries);
const featuredGallery = featuredFirst(galleryEntries);
const contentCounts = `${journalEntries.length} 篇笺录 · ${projectEntries.length} 件器作 · ${galleryEntries.length} 帧光影`;
const profileDetails = [site.profile.role, ...site.profile.focus].filter(Boolean).join(' · ');
const guestbookReady = Boolean(
  site.giscus.repo && site.giscus.repoId && site.giscus.category && site.giscus.categoryId,
);

const pages = [
  {
    chapter: '卷首',
    kicker: 'MOJIAN · DIGITAL FOLIO',
    title: '墨笺',
    summary: '写字、造物、看光影。让数字世界也保留纸张的呼吸。',
    meta: contentCounts,
    href: withBase('/'),
    seal: '启卷',
    image: optimizedArtwork[0].src,
    alt: '宣纸册页上绘有远山、松林与一枝淡墨竹叶',
  },
  {
    chapter: '笺录',
    kicker: latestPost ? `最近装订 · ${formatYearMonth(latestPost.data.pubDate)}` : '文字册页',
    title: latestPost?.data.title ?? '尚待装订',
    summary: latestPost?.data.description ?? '新的文字尚在案头，待落墨后收入笺录。',
    meta: `${journalEntries.length} 篇公开笺录`,
    href: withBase('/journal/'),
    seal: '阅笺',
    image: optimizedArtwork[1].src,
    alt: '宣纸册页上绘有毛笔、砚台与空白纸笺',
  },
  {
    chapter: '器作',
    kicker: featuredProject?.data.featured ? '案上精选' : '器物册页',
    title: featuredProject?.data.title ?? '尚待装订',
    summary: featuredProject?.data.summary ?? '新的器物仍在制作，完成后会在此收录。',
    meta: `${projectEntries.length} 件公开器作`,
    href: withBase('/projects/'),
    seal: '观器',
    image: optimizedArtwork[2].src,
    alt: '宣纸册页上绘有木作榫卯、纸模型与黄铜圆规',
  },
  {
    chapter: '光影',
    kicker: featuredGallery?.data.featured ? '光影精选' : '影像册页',
    title: featuredGallery?.data.title ?? '尚待装订',
    summary: featuredGallery?.data.description ?? '新的光影仍在显影，待整理后收入此卷。',
    meta: `${galleryEntries.length} 帧公开光影`,
    href: withBase('/gallery/'),
    seal: '看影',
    image: optimizedArtwork[3].src,
    alt: '宣纸册页上绘有空白相纸、接触印样、放大镜与窗格投影',
  },
  {
    chapter: '此间',
    kicker: '作者与此间',
    title: site.profile.displayName || '此间有迹',
    summary: profileDetails || '署名与身份尚待主人自题，先以站内公开内容作记。',
    meta: site.profile.focus.length ? site.profile.focus.join(' · ') : contentCounts,
    href: withBase('/about/'),
    seal: '到访',
    image: optimizedArtwork[4].src,
    alt: '宣纸册页上绘有青瓷茶盏、木托、无字折图与淡彩梅枝',
  },
  {
    chapter: '留墨',
    kicker: '公开题写 · 经 GitHub 账号',
    title: guestbookReady ? '请君留墨' : '尚待开卷',
    summary: guestbookReady
      ? '路过此间，不妨题字一行；题写公开可见。'
      : '留言墙待仓库接入 giscus 后启用，题写规则与入口已经备妥。',
    meta: '不留私人信息 · 公开可见',
    href: withBase('/guestbook/'),
    seal: '留墨',
    image: optimizedArtwork[5].src,
    alt: '宣纸册页上绘有花鸟、空白留言笺、毛笔与无字印石',
  },
] as const;

const heroStyle = `--hero-paper: url("${heroArtwork.src}")`;
---

<section
  class="hero"
  aria-label="站点卷首"
  data-hero
  data-home-chapter="卷"
  data-home-chapter-title="卷首"
  data-ink-scene="hero"
  style={heroStyle}
>
  <div class="hero__folio" aria-hidden="true">
    <span>MOJIAN · 2026</span>
    <span>六卷素描本</span>
    <span>拖页 · 阅卷</span>
  </div>

  <div class="hero__inner mx-auto max-w-stage px-5 md:px-8 lg:px-10">
    <header class="hero__heading">
      <p class="folio-label">纸上留白 · 墨分五色</p>
      <p>六卷公开内容，装订成一册可以亲手翻阅的数字素描本。</p>
    </header>

    <div class="sketchbook" data-sketchbook>
      <button class="sketchbook__arrow" type="button" aria-label="上一卷">
        <span aria-hidden="true">‹</span>
      </button>

      <div class="sketchbook__frame" data-sketchbook-frame>
        <span class="sketchbook__desk-shadow" aria-hidden="true"></span>
        <div class="sketchbook__book-wrap" data-sketchbook-book-wrap>
          <div
            class="sketchbook__book"
            data-sketchbook-book
            role="group"
            aria-label="可翻页素描本"
            aria-describedby="sketchbook-instructions"
            tabindex="0"
          >
            <div class="sketchbook__surface" data-sketchbook-surface aria-hidden="true">
              <div class="sketchbook__spread" style={`background-image: url("${pages[0].image}")`}>
              </div>
            </div>

            <div class="sketchbook__copy" data-sketchbook-copy>
              <div class="sketchbook__copy-left">
                <p class="sketchbook__kicker" data-sketchbook-kicker>{pages[0].kicker}</p>
                <h1 class="sketchbook__title" data-sketchbook-title>{pages[0].title}</h1>
                <p class="sketchbook__meta" data-sketchbook-meta>{pages[0].meta}</p>
              </div>
              <div class="sketchbook__copy-right">
                <p class="sketchbook__chapter" data-sketchbook-chapter>{pages[0].chapter}</p>
                <p class="sketchbook__summary" data-sketchbook-summary>{pages[0].summary}</p>
                <a
                  class="sketchbook__seal"
                  data-sketchbook-seal
                  href={pages[0].href}
                  aria-label={`进入${pages[0].chapter}`}
                >
                  <span data-sketchbook-seal-text>{pages[0].seal}</span>
                </a>
              </div>
            </div>
            <p class="sr-only" data-sketchbook-alt>{pages[0].alt}</p>
          </div>
        </div>
      </div>

      <button class="sketchbook__arrow" type="button" aria-label="下一卷">
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <div class="sketchbook__footer">
      <p class="sketchbook__current" role="status" aria-label="当前卷" aria-live="polite">
        <span data-sketchbook-current>{pages[0].chapter}</span>
        <span data-sketchbook-count>01 / 06</span>
      </p>
      <p id="sketchbook-instructions" class="sketchbook__instructions">
        拖动页角、点击左右半页，或使用方向键翻卷
      </p>
      <div class="sketchbook__zoom" aria-label="素描本缩放控制">
        <button type="button" aria-label="缩小素描本" data-sketchbook-zoom-out>−</button>
        <button type="button" aria-label="恢复原始尺寸" data-sketchbook-zoom-reset>复位</button>
        <span role="status" aria-label="素描本缩放" data-sketchbook-zoom-status>100%</span>
        <button type="button" aria-label="放大素描本" data-sketchbook-zoom-in>＋</button>
      </div>
    </div>
  </div>

  {
    pages.map((page) => (
      <template
        data-sketchbook-page
        data-chapter={page.chapter}
        data-kicker={page.kicker}
        data-title={page.title}
        data-summary={page.summary}
        data-meta={page.meta}
        data-href={page.href}
        data-seal={page.seal}
        data-image={page.image}
        data-alt={page.alt}
      />
    ))
  }

  <noscript>
    <nav class="sketchbook__noscript" aria-label="六卷入口">
      {pages.map((page) => <a href={page.href}>{page.chapter}</a>)}
    </nav>
  </noscript>
</section>

<style is:global>
  .hero {
    position: relative;
    min-height: min(74svh, 47rem);
    overflow: clip;
    background:
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--paper) 89%, transparent),
        transparent 32% 68%,
        color-mix(in oklab, var(--paper) 89%, transparent)
      ),
      var(--hero-paper) center 43% / cover;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in oklab, var(--paper) 76%, transparent);
    pointer-events: none;
  }
  .hero__folio {
    position: absolute;
    top: 1rem;
    right: clamp(1.25rem, 4vw, 3.5rem);
    left: clamp(1.25rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
  }
  .hero__folio span:nth-child(2) {
    justify-self: center;
  }
  .hero__folio span:last-child {
    justify-self: end;
  }
  .hero__inner {
    display: grid;
    min-height: inherit;
    align-content: center;
    gap: clamp(0.7rem, 1.5vw, 1.1rem);
    padding-block: 3.5rem 2.2rem;
  }
  .hero__heading {
    display: flex;
    width: min(58vw, 46rem);
    margin-inline: auto;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
  }
  .hero__heading p {
    margin: 0;
  }
  .hero__heading > p:last-child {
    max-width: 23rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
    text-align: right;
  }
  .sketchbook {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, auto) 2.75rem;
    align-items: center;
    justify-content: center;
    gap: clamp(0.35rem, 1vw, 0.9rem);
  }
  .sketchbook__frame {
    position: relative;
    width: min(58vw, 46rem);
    aspect-ratio: 1760 / 1240;
    perspective: 1750px;
    perspective-origin: 50% 46%;
  }
  .sketchbook__desk-shadow {
    position: absolute;
    inset: 72% 7% -3%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--ink) 28%, transparent),
      transparent 72%
    );
    filter: blur(1.1rem);
    opacity: calc(0.34 + var(--turn-lift, 0) * 0.18);
    pointer-events: none;
  }
  .sketchbook__book-wrap {
    position: absolute;
    inset: 0;
    transform: scale(var(--book-scale, 1)) rotateX(var(--book-tilt-x, 0deg))
      rotateY(var(--book-tilt-y, 0deg));
    transform-style: preserve-3d;
    will-change: transform;
  }
  .sketchbook__book {
    position: absolute;
    inset: 0;
    color: #252622;
    cursor: grab;
    outline: none;
    touch-action: pan-y;
    transform-style: preserve-3d;
    user-select: none;
  }
  .sketchbook__book:active {
    cursor: grabbing;
  }
  .sketchbook__book:focus-visible {
    outline: 2px solid var(--cinnabar);
    outline-offset: 0.45rem;
  }
  .sketchbook__surface,
  .sketchbook__spread,
  .sketchbook__half,
  .sketchbook__curl,
  .sketchbook__strip,
  .sketchbook__face {
    position: absolute;
    inset-block: 0;
    transform-style: preserve-3d;
  }
  .sketchbook__surface,
  .sketchbook__spread {
    inset-inline: 0;
  }
  .sketchbook__spread {
    background-position: center;
    background-size: 100% auto;
  }
  .sketchbook__spread,
  .sketchbook__half,
  .sketchbook__face {
    background-position-y: center;
    background-repeat: no-repeat;
  }
  .sketchbook__half {
    width: 50%;
    overflow: hidden;
  }
  .sketchbook__half--left {
    left: 0;
    border-radius: clamp(0.7rem, 1.6vw, 1.3rem) 0 0 clamp(0.7rem, 1.6vw, 1.3rem);
  }
  .sketchbook__half--right {
    left: 50%;
    border-radius: 0 clamp(0.7rem, 1.6vw, 1.3rem) clamp(0.7rem, 1.6vw, 1.3rem) 0;
  }
  .sketchbook__gutter {
    position: absolute;
    inset-block: 21.8%;
    left: 50%;
    z-index: 4;
    width: 6%;
    background: radial-gradient(
      ellipse,
      rgb(49 39 25 / calc(0.19 + var(--turn-lift, 0) * 0.24)),
      transparent 69%
    );
    filter: blur(0.45rem);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .sketchbook__curl {
    z-index: 5;
    width: 44.9%;
  }
  .sketchbook__curl--next {
    left: 50%;
    transform-origin: left center;
  }
  .sketchbook__curl--prev {
    right: 50%;
    transform-origin: right center;
  }
  .sketchbook__strip {
    top: 0;
    width: calc(100% / 18);
    height: 100%;
  }
  .sketchbook__curl--next .sketchbook__strip {
    left: 0;
    transform-origin: left center;
  }
  .sketchbook__curl--prev .sketchbook__strip {
    right: 0;
    transform-origin: right center;
  }
  .sketchbook__curl--next .sketchbook__strip .sketchbook__strip {
    left: 100%;
  }
  .sketchbook__curl--prev .sketchbook__strip .sketchbook__strip {
    right: 100%;
  }
  .sketchbook__face {
    inset: 0 -1px 0 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .sketchbook__face--back {
    transform: rotateY(180deg);
  }
  .sketchbook__face::after {
    content: '';
    position: absolute;
    inset: 21.8% 0;
    background:
      linear-gradient(90deg, rgb(54 39 21 / var(--shade-a, 0)), rgb(54 39 21 / var(--shade-b, 0))),
      linear-gradient(100deg, transparent 30%, rgb(255 252 237 / var(--glint, 0)) 72%, transparent);
    pointer-events: none;
  }
  .sketchbook__turn-shadow {
    position: absolute;
    top: 21.8%;
    bottom: 21.8%;
    left: 50%;
    z-index: 3;
    width: 38%;
    background: linear-gradient(90deg, rgb(42 31 20 / 0.3), transparent 72%);
    filter: blur(0.55rem);
    opacity: 0;
    transform-origin: left center;
    pointer-events: none;
  }
  .sketchbook__copy {
    position: absolute;
    inset: 21.8% 5%;
    z-index: 8;
    display: grid;
    grid-template-columns: 1fr 1fr;
    pointer-events: none;
  }
  .sketchbook__copy-left,
  .sketchbook__copy-right {
    position: relative;
    min-width: 0;
    padding: 14% 11% 10%;
  }
  .sketchbook__kicker,
  .sketchbook__meta,
  .sketchbook__chapter,
  .sketchbook__summary {
    margin: 0;
  }
  .sketchbook__kicker,
  .sketchbook__meta {
    color: #65635c;
    font-family: var(--font-noto-sans);
    font-size: clamp(0.54rem, 0.65vw, 0.65rem);
    letter-spacing: 0.13em;
  }
  .sketchbook__title {
    max-width: 14rem;
    margin: clamp(0.45rem, 1vw, 0.8rem) 0 0;
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(1.65rem, 3.15vw, 2.85rem);
    font-weight: 400;
    line-height: 1.08;
    text-wrap: balance;
  }
  .sketchbook__meta {
    position: absolute;
    bottom: 13%;
    left: 11%;
  }
  .sketchbook__chapter {
    color: #9c3029;
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(1.2rem, 1.8vw, 1.65rem);
    letter-spacing: 0.12em;
  }
  .sketchbook__summary {
    max-width: 15rem;
    margin-top: clamp(0.65rem, 1.5vw, 1.2rem);
    color: #4f5049;
    font-size: clamp(0.68rem, 0.88vw, 0.84rem);
    line-height: 1.8;
  }
  .sketchbook__seal {
    position: absolute;
    right: 12%;
    bottom: 13%;
    display: grid;
    width: clamp(2.35rem, 4vw, 3.1rem);
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid #a33b31;
    color: #a33b31;
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(0.9rem, 1.4vw, 1.15rem);
    line-height: 1;
    pointer-events: auto;
    text-decoration: none;
    transform: rotate(-2deg);
  }
  .sketchbook__seal::before {
    content: '';
    position: absolute;
    inset: 0.2rem;
    border: 1px solid currentColor;
    opacity: 0.55;
  }
  .sketchbook__seal[aria-disabled='true'] {
    opacity: 0.28;
    pointer-events: none;
  }
  .sketchbook__arrow,
  .sketchbook__zoom button {
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .sketchbook__arrow {
    display: grid;
    width: 2.75rem;
    min-height: 4rem;
    place-items: center;
    font-family: serif;
    font-size: 2.5rem;
    transition:
      color 150ms var(--ease-ink),
      transform 150ms var(--ease-ink);
  }
  .sketchbook__arrow:hover:not(:disabled) {
    color: var(--ink);
    transform: scale(1.08);
  }
  .sketchbook__arrow:disabled,
  .sketchbook__zoom button:disabled {
    cursor: default;
    opacity: 0.25;
  }
  .sketchbook__footer {
    display: grid;
    width: min(58vw, 46rem);
    margin-inline: auto;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
  }
  .sketchbook__current,
  .sketchbook__instructions {
    margin: 0;
  }
  .sketchbook__current {
    display: flex;
    gap: 0.7rem;
    color: var(--ink);
    letter-spacing: 0.16em;
  }
  .sketchbook__instructions {
    text-align: center;
  }
  .sketchbook__zoom {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 0.35rem;
    border-block: 1px solid var(--line);
  }
  .sketchbook__zoom button,
  .sketchbook__zoom span {
    min-width: 2rem;
    min-height: 2rem;
    padding: 0.35rem;
    font-size: 0.68rem;
    text-align: center;
  }
  .sketchbook__noscript {
    display: flex;
    width: min(58vw, 46rem);
    margin: 0.5rem auto 1.5rem;
    justify-content: center;
    gap: 1.2rem;
    font-size: 0.78rem;
  }
  .sketchbook__noscript a {
    color: var(--ink);
    text-underline-offset: 0.3em;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: calc(100svh - 5rem);
    }
    .hero__folio {
      grid-template-columns: 1fr auto;
    }
    .hero__folio span:nth-child(2) {
      display: none;
    }
    .hero__inner {
      padding-block: 4rem 2rem;
    }
    .hero__heading,
    .sketchbook__frame,
    .sketchbook__footer,
    .sketchbook__noscript {
      width: calc(100vw - 3rem);
    }
    .hero__heading > p:last-child {
      display: none;
    }
    .sketchbook {
      position: relative;
      display: block;
      margin-inline: 0;
    }
    .sketchbook__frame {
      margin-inline: auto;
    }
    .sketchbook__arrow {
      position: absolute;
      top: 50%;
      z-index: 10;
      width: 2.75rem;
      min-height: 2.75rem;
      font-size: 1.8rem;
      transform: translateY(-50%);
    }
    .sketchbook__arrow:first-child {
      left: calc(50% - (100vw - 3rem) / 2);
    }
    .sketchbook__arrow:last-child {
      right: calc(50% - (100vw - 3rem) / 2);
    }
    .sketchbook__arrow:hover:not(:disabled) {
      transform: translateY(-50%);
    }
    .sketchbook__copy-left,
    .sketchbook__copy-right {
      padding: 12% 10% 8%;
    }
    .sketchbook__kicker,
    .sketchbook__meta {
      font-size: 0.46rem;
      letter-spacing: 0.07em;
    }
    .sketchbook__title {
      max-width: 8.5rem;
      margin-top: 0.25rem;
      font-size: clamp(1.1rem, 6vw, 1.5rem);
    }
    .sketchbook__chapter {
      font-size: 1rem;
    }
    .sketchbook__summary {
      display: -webkit-box;
      max-width: 8rem;
      margin-top: 0.35rem;
      overflow: hidden;
      font-size: 0.54rem;
      line-height: 1.55;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }
