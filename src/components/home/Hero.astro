---
import { Image } from 'astro:assets';
import InscriptionTip from '../InscriptionTip';
import heroArtwork from '../../assets/art/hero-paper-mountains.webp';
import heroFar from '../../assets/art/layers/hero-mountain-far.webp';
import heroMid from '../../assets/art/layers/hero-mountain-mid.webp';
import heroNear from '../../assets/art/layers/hero-mountain-near.webp';
import { withBase } from '../../site.config';

const heroArtStyle = `--hero-art: url("${heroArtwork.src}")`;
---

<section
  class="hero"
  aria-label="站点卷首"
  data-hero
  data-home-chapter="卷"
  data-home-chapter-title="卷首"
  data-ink-scene="hero"
>
  <div class="hero__hold">
    <span class="mist mist--a hero__mist-a" aria-hidden="true"></span>
    <span class="mist mist--b hero__mist-b" aria-hidden="true"></span>
    <span class="hero__under-sheet" data-hero-sheet aria-hidden="true"></span>

    <div class="hero__folio" aria-hidden="true">
      <span>MOJIAN · 2026</span>
      <span>个人数字书卷</span>
      <span>卷一 · 夺卷入画</span>
    </div>

    <div class="hero__stage mx-auto max-w-stage px-5 md:px-8 lg:px-10">
      <figure class="hero__art" data-hero-art>
        <img
          class="hero__fallback"
          src={heroArtwork.src}
          alt="层叠宣纸与墨色构成的抽象山形"
          width={heroArtwork.width}
          height={heroArtwork.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="hero__layers" aria-hidden="true">
          <div class="hero__layer hero__layer--far" data-hero-layer="far">
            <Image
              src={heroFar}
              alt=""
              widths={[720, 1080, 1536]}
              sizes="(min-width: 1024px) 72vw, 100vw"
              quality={86}
              loading="eager"
            />
          </div>
          <span class="hero__layer-mist" aria-hidden="true"></span>
          <div class="hero__layer hero__layer--mid" data-hero-layer="mid">
            <Image
              src={heroMid}
              alt=""
              widths={[720, 1080, 1536]}
              sizes="(min-width: 1024px) 72vw, 100vw"
              quality={86}
              loading="eager"
            />
          </div>
          <div class="hero__layer hero__layer--near" data-hero-layer="near">
            <Image
              src={heroNear}
              alt=""
              widths={[720, 1080, 1536]}
              sizes="(min-width: 1024px) 72vw, 100vw"
              quality={88}
              loading="eager"
            />
          </div>
        </div>
        <figcaption aria-hidden="true">纸山 · 卷首</figcaption>
      </figure>

      <div class="hero__copy" data-ink-avoid>
        <p class="folio-label hero__eyebrow">纸上留白 · 墨分五色</p>
        <h1 class="hero__title font-display" aria-label="墨笺" style={heroArtStyle}>
          <span class="hero-title-mask hero-title-mask--ink"
            ><span class="hero-title-line hero-title-line--ink">墨</span></span
          >
          <span class="hero-title-mask hero-title-mask--paper"
            ><span class="hero-title-line hero-title-line--paper">笺</span></span
          >
        </h1>
        <div class="hero__statement">
          <p>写字、造物、看光影。让数字世界也保留纸张的呼吸。</p>
          <nav class="hero__links" aria-label="卷首入口">
            <a class="ink-link" href={withBase('/journal/')}>读笺录</a>
            <a class="ink-link" href={withBase('/projects/')}>看器作</a>
          </nav>
          {/* 移动端卷首钤印：竖排 colophon 被收起后，落款仪式移入 statement 卡角 */}
          <span class="hero__seal hero__seal--inset" aria-hidden="true">墨</span>
        </div>
      </div>

      <div class="hero__colophon">
        <span aria-hidden="true">入画</span>
        <InscriptionTip text="卷首钤印 · 墨" client:idle>
          <span class="hero__seal" data-hero-seal aria-hidden="true">墨</span>
        </InscriptionTip>
        <span aria-hidden="true">展卷</span>
      </div>

      <p class="hero__scroll" aria-hidden="true">
        <span>向下夺卷</span>
        <span class="hero__scroll-line"></span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 桌面卷首约七成半屏：首屏底部露出近况章头，与全站编辑流密度一致；移动端保持近满屏 */
    min-height: min(75svh, 46rem);
    overflow: clip;
  }
  .hero__hold {
    position: relative;
    isolation: isolate;
    min-height: inherit;
    overflow: clip;
  }

  .hero__under-sheet {
    position: absolute;
    z-index: -1;
    top: clamp(4rem, 10vh, 7rem);
    right: -8vw;
    bottom: clamp(2rem, 7vh, 5rem);
    left: clamp(12vw, 18vw, 22rem);
    border-block: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 94%, var(--paper-deep));
    box-shadow: -1.5rem 1.5rem 4rem var(--shadow-color);
    transform: rotate(-0.8deg);
    transform-origin: left center;
  }
  .hero__under-sheet::before,
  .hero__under-sheet::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--line) 16% 84%, transparent);
  }
  .hero__under-sheet::before {
    left: clamp(1.5rem, 4vw, 4rem);
  }
  .hero__under-sheet::after {
    right: clamp(1.5rem, 4vw, 4rem);
  }

  .hero__folio {
    position: absolute;
    top: clamp(1.1rem, 3vw, 2.25rem);
    right: clamp(1.25rem, 4vw, 3.5rem);
    left: clamp(1.25rem, 4vw, 3.5rem);
    z-index: 7;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
  }
  .hero__folio span:nth-child(2) {
    justify-self: center;
  }
  .hero__folio span:last-child {
    justify-self: end;
  }

  .hero__stage {
    position: relative;
    display: grid;
    min-height: inherit;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr;
    align-items: center;
    padding-block: clamp(3.75rem, 7vh, 5.5rem) clamp(2.75rem, 5vh, 4rem);
  }
  .hero__art {
    position: relative;
    isolation: isolate;
    z-index: 2;
    grid-row: 1;
    grid-column: 4 / -1;
    width: calc(100% + clamp(4rem, 10vw, 10rem));
    margin-right: clamp(-10rem, -10vw, -4rem);
    border-block: 1px solid color-mix(in oklab, var(--ink) 24%, transparent);
    background: var(--paper-deep);
    box-shadow: var(--shadow-lg);
    transform: rotate(0.65deg);
  }
  .hero__art::before {
    content: '';
    position: absolute;
    z-index: 7;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--paper) 86%, transparent),
      transparent 22% 82%,
      color-mix(in oklab, var(--paper-deep) 54%, transparent)
    );
    pointer-events: none;
  }
  .hero__art :global(img) {
    display: block;
    width: 100%;
    /* 固定高而非 min-height：宽视口下自然比例（3:2）会把图撑过 75svh 上限 */
    height: min(48vh, 36rem);
    object-fit: cover;
  }
  .hero__fallback {
    position: relative;
    z-index: 0;
  }
  .hero__layers {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  :global(html.js) .hero__layers {
    display: block;
  }
  :global(html.js) .hero__fallback {
    opacity: 0;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero__layer :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    will-change: transform;
  }
  .hero__layer--far {
    z-index: 1;
    opacity: 0.82;
  }
  .hero__layer-mist {
    position: absolute;
    z-index: 2;
    right: 4%;
    bottom: 12%;
    width: 70%;
    height: 52%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--paper) 70%, transparent),
      transparent 72%
    );
    opacity: 0.44;
  }
  .hero__layer--mid {
    z-index: 3;
  }
  .hero__layer--near {
    z-index: 4;
  }
  .hero__art figcaption {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    z-index: 9;
    padding: 0.2rem 0.5rem;
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
  }

  .hero__copy {
    position: relative;
    z-index: 5;
    grid-row: 1;
    grid-column: 1 / -1;
    min-height: min(48vh, 36rem);
    pointer-events: none;
  }
  .hero__eyebrow {
    position: absolute;
    top: 8%;
    left: 0;
    margin: 0;
    writing-mode: vertical-rl;
  }
  .hero__title {
    position: absolute;
    inset: 0;
    margin: 0;
    font-weight: 400;
    line-height: 0.7;
    letter-spacing: -0.04em;
    pointer-events: none;
  }
  .hero-title-mask {
    position: absolute;
    display: block;
    overflow: visible;
    padding: 0.12em 0.05em 0.2em;
    margin: -0.12em -0.05em -0.2em;
  }
  .hero-title-mask--ink {
    top: 50%;
    left: -6%;
    transform: translateY(-52%);
  }
  .hero-title-mask--paper {
    right: -2%;
    bottom: -4%;
  }
  .hero-title-line {
    display: block;
    line-height: 0.94;
  }
  .hero-title-line--ink {
    background-image:
      linear-gradient(
        color-mix(in oklab, var(--ink) 82%, transparent),
        color-mix(in oklab, var(--ink) 52%, transparent)
      ),
      var(--hero-art);
    background-blend-mode: multiply;
    background-position: 52% center;
    background-size: cover;
    color: transparent;
    font-size: var(--type-hero-primary);
    -webkit-background-clip: text;
    background-clip: text;
    filter: contrast(1.12) saturate(0.66);
    -webkit-text-stroke: 1px color-mix(in oklab, var(--ink) 34%, transparent);
    text-shadow: 0 0 1px color-mix(in oklab, var(--ink) 42%, transparent);
  }
  .hero-title-line--paper {
    color: var(--cinnabar);
    font-size: var(--type-hero-secondary);
    text-shadow:
      0.045em 0.055em 0 var(--paper),
      0.055em 0.065em 0 var(--line);
  }

  .hero__statement {
    position: absolute;
    bottom: 2%;
    left: clamp(1.5rem, 8vw, 7rem);
    display: grid;
    width: min(38rem, 64vw);
    grid-template-columns: minmax(15rem, 29rem) auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: 1.1rem 1.25rem;
    border-top: 1px solid var(--ink);
    /* 纸底已 88% 不透明，可承托文字；全站玻璃拟态仅页眉一处，此处不再 blur */
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    pointer-events: auto;
  }
  .hero__statement > p {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.9;
  }
  .hero__links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-noto-sans);
    font-size: 0.82rem;
  }
  .hero__links a {
    color: var(--ink);
    /* 常驻淡墨下划线：首屏入口不依赖 hover 即可被识别为链接 */
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--ink) 38%, transparent);
    text-underline-offset: 0.4em;
    transition: text-decoration-color 150ms var(--ease-ink);
  }

  .hero__links a:hover {
    text-decoration-color: var(--ink);
  }

  .hero__colophon {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    writing-mode: vertical-rl;
    transform: translateY(-50%);
    color: var(--ink);
    font-size: 0.72rem;
    letter-spacing: 0.35em;
  }
  .hero__seal {
    position: relative;
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    align-items: center;
    justify-content: center;
    background: var(--cinnabar);
    box-shadow:
      0 0 0 0.3rem var(--paper),
      0 0 0 calc(0.3rem + 1px) var(--cinnabar);
    color: var(--paper);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.5rem;
    letter-spacing: 0;
  }
  .hero__seal::after {
    content: '';
    position: absolute;
    inset: -0.55rem;
    border: 1.5px solid var(--cinnabar);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }
  .hero__mist-a {
    top: 4%;
    right: -2%;
    width: 38rem;
    height: 30rem;
  }
  .hero__mist-b {
    bottom: 0;
    left: -10%;
    width: 34rem;
    height: 26rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__seal::after {
      animation: seal-halo 0.85s var(--ease-ink) 1.55s 1 both;
    }
    :global(html.js) .hero-title-line,
    :global(html.js) .hero__eyebrow,
    :global(html.js) .hero__statement,
    :global(html.js) .hero__colophon,
    :global(html.js) .hero__scroll {
      opacity: 0;
    }
  }
  @keyframes seal-halo {
    from {
      opacity: 0.55;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 0;
    left: 2.5rem;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    width: 1px;
    height: 3.5rem;
    background: var(--line);
    transform-origin: top center;
    animation: scroll-breath 2.4s ease-in-out infinite;
  }
  @keyframes scroll-breath {
    0%,
    100% {
      transform: scaleY(0.45);
      opacity: 0.45;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .hero__seal--inset {
    display: none;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: calc(100svh - 5rem);
    }
    .hero__hold {
      position: relative;
      top: auto;
      min-height: inherit;
    }
    .hero__under-sheet {
      top: 4.75rem;
      right: -6rem;
      bottom: 3rem;
      left: 31%;
      transform: rotate(-1.2deg);
    }
    .hero__folio {
      top: 1.25rem;
      grid-template-columns: 1fr auto;
    }
    .hero__folio span:nth-child(2) {
      display: none;
    }
    .hero__stage {
      display: grid;
      min-height: inherit;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      padding-block: 4.5rem 3.5rem;
    }
    .hero__copy {
      grid-row: 1;
      grid-column: 1;
      min-height: min(66svh, 32rem);
    }
    .hero__eyebrow {
      top: 2.5rem;
      left: 0;
    }
    .hero-title-mask--ink {
      top: 42%;
      left: -16%;
    }
    .hero-title-mask--paper {
      right: -3%;
      bottom: 1rem;
    }
    .hero-title-line--ink {
      font-size: var(--type-hero-primary);
    }
    .hero-title-line--paper {
      font-size: var(--type-hero-secondary);
    }
    .hero__statement {
      bottom: 0;
      left: 0;
      display: block;
      width: min(92%, 24rem);
      padding: 0.9rem 0;
      background: color-mix(in oklab, var(--paper) 92%, transparent);
      backdrop-filter: none;
    }

    /* 落款仪式入卡角：小印浮于 statement 上缘右侧，恢复移动端朱砂钤印 */
    .hero__seal--inset {
      position: absolute;
      top: -1.15rem;
      right: 0.8rem;
      display: inline-flex;
      width: 2.2rem;
      height: 2.2rem;
      font-size: 1.15rem;
      box-shadow: 0 0 0 0.22rem var(--paper);
    }
    .hero__links {
      margin-top: 1rem;
    }
    .hero__links a {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
      padding-inline: 0.25rem;
    }
    .hero__art {
      grid-row: 1;
      grid-column: 1;
      align-self: center;
      width: calc(100% + 3rem);
      margin: 0 -3rem 0 16%;
      transform: rotate(0.8deg);
    }
    .hero__art :global(img) {
      height: min(52svh, 27rem);
      min-height: 0;
      aspect-ratio: auto;
    }
    .hero__layer--mid,
    .hero__colophon {
      display: none;
    }
    .hero__scroll {
      right: 1.25rem;
      bottom: 0;
      left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line,
    .hero__seal::after {
      animation: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/scroll';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !prefersReducedMotion) {
    const titleLines = hero.querySelectorAll<HTMLElement>('.hero-title-line');
    const details = hero.querySelectorAll<HTMLElement>(
      '.hero__eyebrow, .hero__statement, .hero__colophon, .hero__scroll',
    );
    const sheet = hero.querySelector<HTMLElement>('[data-hero-sheet]');
    const art = hero.querySelector<HTMLElement>('[data-hero-art]');
    const paperTitle = hero.querySelector<HTMLElement>('.hero-title-mask--paper');
    const layers = [
      { element: hero.querySelector<HTMLElement>('[data-hero-layer="far"]'), yPercent: 2 },
      { element: hero.querySelector<HTMLElement>('[data-hero-layer="mid"]'), yPercent: 5 },
      { element: hero.querySelector<HTMLElement>('[data-hero-layer="near"]'), yPercent: 8 },
    ].filter((layer): layer is { element: HTMLElement; yPercent: number } =>
      Boolean(layer.element),
    );

    const entrance = gsap.timeline({ defaults: { ease: 'expo.out' } });
    if (sheet)
      entrance.fromTo(
        sheet,
        { clipPath: 'inset(0 100% 0 0)' },
        { clipPath: 'inset(0 0% 0 0)', duration: 0.75 },
        0,
      );
    if (art)
      entrance.fromTo(
        art,
        { clipPath: 'inset(0 100% 0 0)', xPercent: 4 },
        { clipPath: 'inset(0 0% 0 0)', xPercent: 0, duration: 0.9 },
        0.12,
      );
    entrance
      .fromTo(
        titleLines,
        { yPercent: 100 },
        { yPercent: 0, opacity: 1, duration: 1.05, stagger: 0.14 },
        0.18,
      )
      .to(details, { opacity: 1, duration: 0.65, stagger: 0.07 }, 0.58);

    const seal = hero.querySelector<HTMLElement>('[data-hero-seal]');
    if (seal)
      entrance.fromTo(
        seal,
        { scale: 1.4, rotate: -7 },
        { scale: 1, rotate: 0, duration: 0.5, ease: 'back.out(2.4)' },
        1.45,
      );

    /*
     * 桌面滚动视差跟随 768 断点重建或清理：
     * 视口判定只在加载时读一次的话，旋转屏后要么残留移动布局上的 transform，
     * 要么转桌面后缺少视差；与长卷时间线保持同一救济策略。
     */
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    let teardownHandoff: (() => void) | null = null;

    const setupHandoff = () => {
      const handoff = gsap.timeline({
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });
      if (sheet) handoff.to(sheet, { xPercent: -7, ease: 'none' }, 0);
      if (art) handoff.to(art, { xPercent: 9, ease: 'none' }, 0);
      if (paperTitle) handoff.to(paperTitle, { xPercent: 16, ease: 'none' }, 0);
      layers.forEach((layer) =>
        handoff.to(layer.element, { yPercent: layer.yPercent, ease: 'none' }, 0),
      );

      teardownHandoff = () => {
        handoff.scrollTrigger?.kill();
        handoff.kill();
        const parallaxTargets = [sheet, art, paperTitle, ...layers.map((layer) => layer.element)];
        gsap.set(
          parallaxTargets.filter((target): target is HTMLElement => Boolean(target)),
          { clearProps: 'transform' },
        );
        teardownHandoff = null;
      };
    };

    if (desktopQuery.matches) setupHandoff();

    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) {
        setupHandoff();
      } else {
        teardownHandoff?.();
      }
    });

    /*
     * 印泥磁吸：细指针下卷首钤印被指尖轻带、弹性回位（印泥有黏性）。
     * 与入场动画同由 GSAP 统一管理 transform；触屏不启用。
     */
    const sealEl = hero.querySelector<HTMLElement>('[data-hero-seal]');
    const colophon = hero.querySelector<HTMLElement>('.hero__colophon');
    if (sealEl && colophon && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const sealX = gsap.quickTo(sealEl, 'x', { duration: 0.45, ease: 'power3.out' });
      const sealY = gsap.quickTo(sealEl, 'y', { duration: 0.45, ease: 'power3.out' });
      colophon.addEventListener('pointermove', (event) => {
        const rect = colophon.getBoundingClientRect();
        sealX(gsap.utils.clamp(-3, 3, (event.clientX - (rect.left + rect.width / 2)) * 0.12));
        sealY(gsap.utils.clamp(-3, 3, (event.clientY - (rect.top + rect.height / 2)) * 0.12));
      });
      colophon.addEventListener('pointerleave', () => {
        sealX(0);
        sealY(0);
      });
    }
  }
</script>
