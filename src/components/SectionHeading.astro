---
// 章节标题：朱砂白文小印编号（可选）+ h2 + 英文侧注。
// 首页区块传 index（壹/贰/叁…）；独立页面页头省略 index，仅留标题与侧注
interface Props {
  id: string;
  title: string;
  /** 小印编号：壹/贰/叁…；省略时不渲染印章 */
  index?: string;
  /** 英文小字侧注，如 PROFILE */
  note?: string;
}

const { id, title, index, note } = Astro.props;
---

<div class="section-heading">
  {
    index && (
      <span class="index-seal" aria-hidden="true">
        {index}
      </span>
    )
  }
  <h2 id={id} data-reveal-title>{title}</h2>
  {
    note && (
      <span class="note" aria-hidden="true">
        {note}
      </span>
    )
  }
  <span class="section-rule" aria-hidden="true" data-reveal-line></span>
</div>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    margin-block-end: 2.5rem;
  }

  /* 白文小印：朱砂底、纸色字，与标题基线对齐 */
  .index-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4em;
    height: 1.4em;
    border-radius: var(--radius-sm);
    background: var(--cinnabar);
    color: var(--paper);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.1rem;
    line-height: 1;
    transform: translateY(0.12em);
  }

  .section-heading h2 {
    margin: 0;
  }

  /* 英文侧注：淡铜色、大写字距拉开，取现代书籍目录之意 */
  .note {
    font-family: var(--font-noto-sans);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .section-rule {
    grid-column: 1 / -1;
    width: 100%;
    height: 1px;
    margin-top: 0.1rem;
    background: linear-gradient(90deg, var(--ink), var(--line) 72%, transparent);
  }

  @media (max-width: 479px) {
    .note {
      letter-spacing: 0.2em;
    }
  }
</style>
