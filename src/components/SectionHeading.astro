---
// 章节标题：朱砂白文小印编号（可选）+ h2 + 英文侧注。
// 首页区块传 index（壹/贰/叁…）；独立页面页头省略 index，仅留标题与侧注
interface Props {
  id: string;
  title: string;
  /** 小印编号：壹/贰/叁…；省略时不渲染印章 */
  index?: string;
  /** 英文小字侧注，如 PROFILE */
  note?: string;
}

const { id, title, index, note } = Astro.props;
---

<div class="section-heading" data-reveal-variant="folio">
  {
    index && (
      <span class="index-seal" aria-hidden="true" data-reveal-detail>
        {index}
      </span>
    )
  }
  <h2 id={id} data-reveal-title>{title}</h2>
  {
    note && (
      <span class="note" aria-hidden="true" data-reveal-detail>
        {note}
      </span>
    )
  }
  <span class="section-rule" aria-hidden="true" data-reveal-line></span>
</div>

<style>
  .section-heading {
    position: relative;
    display: grid;
    grid-template-columns: clamp(2.8rem, 5vw, 4.75rem) minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.65rem clamp(1rem, 2.5vw, 2rem);
    margin-block-end: clamp(3rem, 6vw, 5.5rem);
  }

  /* 白文小印：朱砂底、纸色字，与标题基线对齐 */
  .index-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.6rem, 4.5vw, 3.5rem);
    height: clamp(2.6rem, 4.5vw, 3.5rem);
    border-radius: var(--radius-sm);
    background: var(--cinnabar);
    color: var(--paper);
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1;
    transform: rotate(-2deg);
  }

  .section-heading h2 {
    margin: 0;
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.035em;
  }

  /* 英文侧注：淡铜色、大写字距拉开，取现代书籍目录之意 */
  .note {
    align-self: center;
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bronze);
    writing-mode: vertical-rl;
  }

  .section-rule {
    grid-column: 2 / -1;
    width: 100%;
    height: 1px;
    margin-top: 0.45rem;
    background: linear-gradient(90deg, var(--ink), var(--line) 72%, transparent);
  }

  .section-heading::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.65rem;
    width: clamp(2rem, 7vw, 7rem);
    height: 1px;
    background: var(--cinnabar);
    opacity: 0.72;
    transform: rotate(-1.5deg);
    transform-origin: right center;
  }

  @media (max-width: 479px) {
    .section-heading {
      grid-template-columns: 2.6rem minmax(0, 1fr) auto;
      gap-inline: 0.85rem;
      margin-block-end: 3rem;
    }

    .index-seal {
      width: 2.35rem;
      height: 2.35rem;
      font-size: 1.15rem;
    }

    .section-heading h2 {
      font-size: clamp(2.65rem, 15vw, 4rem);
    }

    .note {
      font-size: 0.62rem;
      letter-spacing: 0.2em;
    }

    .section-rule {
      grid-column: 1 / -1;
    }
  }
</style>
