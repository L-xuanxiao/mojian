---
// 章节标题分为两档：chapter 是首页的跨栏章标，quiet 服务正文内的小节阅读。
interface Props {
  id: string;
  title: string;
  /** 小印编号：壹/贰/叁…；省略时不渲染印章 */
  index?: string;
  /** 英文小字侧注，如 PROFILE */
  note?: string;
  /** 首页叙事章标使用 chapter；内容页默认 quiet，保持既有调用兼容。 */
  mode?: 'chapter' | 'quiet';
}

const { id, title, index, note, mode = 'quiet' } = Astro.props;
---

<div
  class:list={['section-heading', `section-heading--${mode}`]}
  data-section-heading
  data-heading-mode={mode}
  data-heading-index={index}
  data-reveal-variant="folio"
>
  {
    mode === 'chapter' && index && (
      <span class="index-glyph" aria-hidden="true">
        {index}
      </span>
    )
  }
  {
    index && (
      <span class="index-seal" aria-hidden="true" data-reveal-detail>
        {index}
      </span>
    )
  }
  <h2 id={id} data-reveal-title>{title}</h2>
  {
    note && (
      <span class="note" aria-hidden="true" data-reveal-detail>
        {note}
      </span>
    )
  }
  <span class="section-rule" aria-hidden="true" data-reveal-line></span>
</div>

<style>
  .section-heading {
    position: relative;
    display: grid;
    grid-template-columns: clamp(2.8rem, 5vw, 4.75rem) minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.65rem clamp(1rem, 2.5vw, 2rem);
    margin-block-end: clamp(2rem, 3.5vw, 3rem);
  }

  .section-heading--chapter {
    isolation: isolate;
    overflow: clip;
    min-height: clamp(7rem, 9vw, 9rem);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: center;
    align-items: end;
    column-gap: clamp(0.5rem, 1.4vw, 1.25rem);
    margin-inline: calc(clamp(1.5rem, 4vw, 4rem) * -1);
    margin-block-end: clamp(1.5rem, 2.5vw, 2.5rem);
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }

  /* 章号不是装饰印章，而是整幅版面的纸上水印；裁边令它继续伸向视口之外。 */
  .index-glyph {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: clamp(-1.25rem, -1.5vw, -0.25rem);
    color: var(--ink);
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-glyph-chapter);
    line-height: 0.72;
    opacity: 0.1;
    transform: translateY(-50%) rotate(-3deg);
    pointer-events: none;
    user-select: none;
  }

  /* 白文小印：朱砂底、纸色字，与标题基线对齐 */
  .index-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.6rem, 4.5vw, 3.5rem);
    height: clamp(2.6rem, 4.5vw, 3.5rem);
    border-radius: var(--radius-sm);
    background: var(--cinnabar);
    color: var(--paper);
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1;
    transform: rotate(-2deg);
  }

  .section-heading--chapter .index-seal {
    z-index: 2;
    grid-column: 1 / 2;
    align-self: center;
    width: clamp(2.75rem, 4vw, 3.75rem);
    height: clamp(2.75rem, 4vw, 3.75rem);
    margin-inline-start: clamp(0rem, 1.2vw, 1rem);
    box-shadow: 0 0.35rem 1.2rem color-mix(in oklab, var(--cinnabar) 18%, transparent);
  }

  .section-heading h2 {
    margin: 0;
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-title-section);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.035em;
  }

  .section-heading--chapter h2 {
    z-index: 1;
    grid-column: 2 / 11;
    align-self: center;
    font-size: var(--type-title-chapter);
    line-height: 0.78;
    letter-spacing: -0.02em;
    text-wrap: nowrap;
  }

  /* 英文侧注：淡铜色、大写字距拉开，取现代书籍目录之意 */
  .note {
    align-self: center;
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bronze);
    writing-mode: vertical-rl;
  }

  /* 英文侧注在 chapter 模式中成为贴于卷边的展签，与巨幅题字形成尺度冲突。 */
  .section-heading--chapter .note {
    z-index: 2;
    grid-column: 10 / 13;
    align-self: end;
    justify-self: end;
    max-width: 14rem;
    padding: 0.55rem 0.85rem;
    border-block: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 84%, transparent);
    font-size: 0.62rem;
    line-height: 1.4;
    text-align: right;
    writing-mode: horizontal-tb;
    transform: rotate(1deg);
  }

  .section-rule {
    grid-column: 2 / -1;
    width: 100%;
    height: 1px;
    margin-top: 0.45rem;
    background: linear-gradient(90deg, var(--ink), var(--line) 72%, transparent);
  }

  .section-heading--chapter .section-rule {
    z-index: 1;
    grid-column: 2 / 13;
    align-self: end;
    margin-top: clamp(1rem, 2vw, 1.75rem);
    background: linear-gradient(
      90deg,
      var(--ink) 0 58%,
      var(--cinnabar) 58% 60%,
      var(--line) 60% 94%,
      transparent
    );
  }

  .section-heading::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.65rem;
    width: clamp(2rem, 7vw, 7rem);
    height: 1px;
    background: var(--cinnabar);
    opacity: 0.72;
    transform: rotate(-1.5deg);
    transform-origin: right center;
  }

  .section-heading--chapter::after {
    right: clamp(1.5rem, 4vw, 4rem);
    bottom: clamp(1.1rem, 2vw, 1.75rem);
    width: clamp(5rem, 16vw, 13rem);
  }

  @media (max-width: 767px) {
    .section-heading--chapter {
      min-height: clamp(5.5rem, 24vw, 7rem);
      grid-template-columns: repeat(8, minmax(0, 1fr));
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
    }

    .section-heading--chapter .index-glyph {
      left: -0.8rem;
      font-size: var(--type-glyph-chapter);
      opacity: 0.12;
    }

    .section-heading--chapter .index-seal {
      grid-column: 1 / 2;
      align-self: end;
      width: 2.4rem;
      height: 2.4rem;
      margin-inline-start: 0;
      font-size: 1.15rem;
    }

    .section-heading--chapter h2 {
      grid-column: 2 / 9;
      align-self: center;
      font-size: var(--type-title-chapter);
      line-height: 0.82;
    }

    .section-heading--chapter .note {
      grid-column: 5 / 9;
      padding: 0.4rem 0.6rem;
      font-size: 0.62rem;
      letter-spacing: 0.2em;
    }

    .section-heading--chapter .section-rule {
      grid-column: 2 / 9;
    }

    .section-heading--chapter::after {
      right: 1.25rem;
    }
  }

  @media (max-width: 479px) {
    .section-heading--quiet {
      grid-template-columns: 2.6rem minmax(0, 1fr) auto;
      gap-inline: 0.85rem;
      margin-block-end: 2.25rem;
    }

    .section-heading--quiet .index-seal {
      width: 2.35rem;
      height: 2.35rem;
      font-size: 1.15rem;
    }

    .section-heading--quiet h2 {
      font-size: var(--type-title-section);
    }

    .section-heading--quiet .note {
      font-size: 0.62rem;
      letter-spacing: 0.2em;
    }

    .section-heading--quiet .section-rule {
      grid-column: 1 / -1;
    }

    .section-heading--chapter {
      min-height: 5.75rem;
      margin-block-end: 2.25rem;
    }

    .section-heading--chapter h2 {
      font-size: var(--type-title-chapter);
    }

    .section-heading--chapter .note {
      grid-column: 4 / 9;
      max-width: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-glyph,
    .index-seal,
    .section-heading h2,
    .note,
    .section-rule,
    .section-heading::after {
      transition: none;
    }
  }
</style>
