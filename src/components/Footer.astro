---
// 占位数据，后续阶段替换为真实内容
// href 与 Header 导航保持一致；路由页面将在后续阶段创建
const navLinks = [
  { label: '笺录', href: '/journal/' },
  { label: '器作', href: '/projects/' },
  { label: '光影', href: '/gallery/' },
  { label: '此间', href: '/about/' },
  { label: '留墨', href: '/guestbook/' },
];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-content px-5 py-12 md:px-8">
    <div class="flex flex-col gap-8">
      <!-- 导航链接小字行 -->
      <nav aria-label="页脚导航">
        <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-sm">
          {
            navLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-ink-soft no-underline transition-colors ease-ink hover:text-ink"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- 联系入口行 -->
      <p class="m-0 text-sm text-ink-soft">
        留墨于此：
        <a
          href="https://github.com/L-xuanxiao/mojian"
          class="text-cinnabar no-underline transition-colors ease-ink hover:underline">GitHub</a
        >
        <span aria-hidden="true" class="mx-2">·</span>
        <a
          href="mailto:hi@mojian.example"
          class="text-cinnabar no-underline transition-colors ease-ink hover:underline">邮件</a
        >
      </p>

      <!-- 版权行 + 朱文方印与竖排落款 -->
      <div class="flex items-center justify-between">
        <p class="m-0 text-sm text-ink-soft">© 2026 墨笺</p>
        <div class="flex items-center gap-4">
          <!-- 竖排落款「墨笺藏本」：题跋式装饰，对辅助技术隐藏；移动端隐藏避免挤压版权行 -->
          <span
            aria-hidden="true"
            class="hidden font-display text-xs tracking-[0.3em] text-ink-soft select-none sm:block"
            style="writing-mode: vertical-rl">墨笺藏本</span
          >
          <!-- 朱文方印：外框朱砂 1.5px 描边，内嵌实底白文「墨笺」，双层嵌套仿印泥钤出的边框感。
               纯装饰，对辅助技术隐藏；data-seal 为钤印动画钩子，ring 承载落印淡墨扩散环 -->
          <span
            aria-hidden="true"
            class="relative flex h-[2.75em] w-[2.75em] items-center justify-center rounded-sm border-[1.5px] border-cinnabar p-[3px] select-none"
            data-seal
            ><!-- 淡墨环：落印瞬间扩散一次，仅 JS 动画时显示 -->
            <span
              class="pointer-events-none absolute inset-0 rounded-sm border border-ink opacity-0"
              data-seal-ring></span><span
              class="flex h-full w-full items-center justify-center rounded-[2px] bg-cinnabar font-display text-xs leading-none text-paper"
              >墨笺</span
            ></span
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/scroll';

  // reduced-motion：不创建任何动画，印章 CSS 默认完整可见
  if (!prefersReducedMotion) {
    const footer = document.querySelector<HTMLElement>('footer');
    const seal = footer?.querySelector('[data-seal]');
    const ring = footer?.querySelector('[data-seal-ring]');

    if (footer && seal && ring) {
      // 初始隐藏态只由 JS 设置：无 JS 时印章直达最终态
      gsap.set(seal, { opacity: 0, rotate: -8, scale: 1.4 });
      gsap.set(ring, { opacity: 0 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: footer, start: 'top 92%', once: true },
      });
      tl
        // 钤印：自 rotate(-8°) scale(1.4) 砸落回正，back.out 近似 ease-seal 回弹
        .to(seal, { opacity: 1, rotate: 0, scale: 1, duration: 0.5, ease: 'back.out(2)' })
        // 落印瞬间一圈淡墨扩散消隐，只播一次
        .fromTo(
          ring,
          { opacity: 0.5, scale: 0.6 },
          { opacity: 0, scale: 1.6, duration: 0.6, ease: 'power2.out' },
          '-=0.2',
        );
    }
  }
</script>
