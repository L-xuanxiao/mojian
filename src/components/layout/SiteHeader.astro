---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../../config/siteConfig';

const BASE = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isHome = pathname === BASE;

// 首页指向锚点，内页指向独立路由（无独立路由的项回落到首页锚点）；
// 无 homeAnchor 的项（如留墨）直接走独立路由
const navItems = siteConfig.nav
  .filter(
    (item) =>
      !item.path ||
      Boolean(siteConfig.pages[item.path.slice(0, -1) as keyof typeof siteConfig.pages]),
  )
  .map((item) => ({
    ...item,
    href:
      isHome && item.homeAnchor
        ? `#${item.homeAnchor}`
        : item.path
          ? `${BASE}${item.path}`
          : item.homeAnchor === 'top'
            ? BASE
            : `${BASE}#${item.homeAnchor}`,
  }));

const activeKey = isHome
  ? 'top'
  : pathname.startsWith(`${BASE}posts/`) || pathname.startsWith(`${BASE}category/`)
    ? 'articles'
    : pathname.startsWith(`${BASE}archive/`)
      ? 'archive'
      : pathname.startsWith(`${BASE}about/`)
        ? 'about'
        : pathname.startsWith(`${BASE}guestbook/`)
          ? 'guest'
          : 'top';
---

<header class="site-header" id="siteHeader" data-home={isHome ? 'true' : undefined}>
  <div class="nav-shell nav-inner">
    <a class="brand" href={isHome ? '#top' : BASE} aria-label={`${siteConfig.name}首页`}>
      <span>{siteConfig.name}</span>
      <span class="brand-seal" aria-hidden="true">{siteConfig.seal}</span>
    </a>

    <nav class="nav-desktop" aria-label="主导航">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              class="nav-link"
              href={item.href}
              aria-current={item.key === activeKey ? 'page' : undefined}
              aria-label={item.ariaLabel}
              data-no-swup={item.path === 'guestbook/' ? true : undefined}
            >
              <Icon class="nav-icon" name={item.icon} />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-font-role="cal"
      aria-label="切换昼夜主题"
      title="昼夜切换"
    >
      <span class="tt-day" aria-hidden="true">夜</span>
      <span class="tt-night" aria-hidden="true">昼</span>
    </button>

    <details class="nav-mobile" id="navMenu">
      <summary aria-label="展开导航">
        <Icon class="nav-icon" name="lucide:menu" />
      </summary>
      <nav class="nav-mobile-panel" aria-label="移动端导航">
        <ul class="nav-list">
          {navItems.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={item.key === activeKey ? 'page' : undefined}
                data-no-swup={item.path === 'guestbook/' ? true : undefined}
              >
                <Icon class="nav-icon" name={item.icon} />
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 30;
    top: 14px;
    left: 50%;
    width: min(calc(100% - 9vw), 1860px);
    transform: translateX(-50%);
    transition: top 240ms ease, width 240ms ease;
  }

  .site-header.is-scrolled {
    top: 8px;
    width: min(calc(100% - 7vw), 1820px);
  }

  .nav-shell {
    width: 100%;
    margin-inline: auto;
  }

  /* 镇尺式导航：宣纸条压文武双线，不用玻璃拟态 */
  .nav-inner {
    position: relative;
    display: flex;
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 22px;
    border-bottom: 1px solid var(--line);
    background-color: rgb(248 246 239 / 94%);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.52' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)' opacity='.15'/%3E%3C/svg%3E");
    background-size: 220px 220px;
    background-blend-mode: soft-light;
    transition: background-color 240ms ease, border-color 240ms ease;
  }

  /* 武线：文线（border）下隔 3px 再压一道粗的，合成古籍版框文武边 */
  .nav-inner::before {
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 2px;
    content: '';
    background: var(--line-strong);
    transition: background-color 240ms ease;
  }

  .site-header.is-scrolled .nav-inner {
    border-bottom-color: var(--line-strong);
    background-color: rgb(248 246 239 / 98%);
  }

  .site-header.is-scrolled .nav-inner::before {
    background: rgb(83 79 70 / 45%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex: 0 0 auto;
    padding-right: 22px;
    border-right: 1px solid var(--line);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  .brand-seal {
    position: relative;
    display: grid;
    width: 27px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--cinnabar-deep);
    color: #f8eee4;
    background: var(--cinnabar);
    font-size: 0.7rem;
    line-height: 1;
    transform: rotate(-4deg);
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 14%);
  }

  .brand-seal::after {
    position: absolute;
    inset: 3px;
    border: 1px solid rgb(255 255 255 / 38%);
    content: '';
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
    list-style: none;
  }

  .nav-desktop .nav-list > li {
    display: flex;
    align-items: center;
  }

  /* 朱丝栏：相邻链接间一道竖细线，如线装书界行 */
  .nav-desktop .nav-list > li + li::before {
    width: 1px;
    height: 14px;
    margin-inline: 4px;
    content: '';
    background: var(--line);
  }

  .nav-link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 200ms ease;
  }

  /* 悬停：字上一点朱砂圈点 */
  .nav-link::after {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    content: '';
    background: var(--cinnabar);
    transform: translateX(-50%) scale(0);
    transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after {
    transform: translateX(-50%) scale(1);
  }

  /* 当前页：一枚微斜朱砂小印盖在字后 */
  .nav-link::before {
    position: absolute;
    z-index: -1;
    inset: 7px;
    content: '';
    background: var(--cinnabar);
    border: 1px solid var(--cinnabar-deep);
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 14%);
    opacity: 0;
    transform: rotate(-3deg) scale(0.86);
    transition: opacity 220ms ease, transform 260ms var(--ease);
  }

  .nav-link[aria-current='page'] {
    color: var(--paper-light);
  }

  .nav-link[aria-current='page']::before {
    opacity: 1;
    transform: rotate(-3deg) scale(1);
  }

  .nav-link[aria-current='page']::after {
    content: none;
  }

  .nav-link[aria-current='page'] .nav-icon {
    color: var(--paper-light);
  }

  .nav-link:active {
    transform: scale(0.98);
  }

  .nav-icon {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
    color: var(--moss-deep);
  }

  .nav-mobile {
    position: relative;
    display: none;
  }

  .nav-mobile summary {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 6px;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile[open] summary {
    background: rgb(83 79 70 / 8%);
  }

  .nav-mobile-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: min(250px, calc(100vw - 36px));
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgb(248 246 239 / 98%);
    box-shadow: 0 14px 30px rgb(62 54 43 / 14%);
  }

  .nav-mobile-panel .nav-list {
    align-items: stretch;
    flex-direction: column;
  }

  /* 面板内界行改为横细线 */
  .nav-mobile-panel .nav-list > li + li {
    border-top: 1px solid var(--line);
  }

  .nav-mobile-panel .nav-link {
    width: 100%;
  }

  .nav-mobile-panel .nav-link::after {
    top: 50%;
    left: 6px;
    transform: translateY(-50%) scale(0);
  }

  .nav-mobile-panel .nav-link:hover::after {
    transform: translateY(-50%) scale(1);
  }

  /* 面板印章整行平盖，不斜 */
  .nav-mobile-panel .nav-link::before {
    inset: 5px 8px;
    transform: scale(0.92);
  }

  .nav-mobile-panel .nav-link[aria-current='page']::before {
    transform: scale(1);
  }

  /* ============ 昼夜切换按钮 ============ */
  .theme-toggle {
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
    flex: 0 0 auto;
    font-size: 1.05rem;
    line-height: 1;
    transition: background 300ms ease, color 300ms ease, transform 300ms var(--ease);
  }

  .theme-toggle:hover {
    color: var(--paper-light);
    background: var(--ink);
    transform: rotate(8deg);
  }

  .theme-toggle .tt-night {
    display: none;
  }

  :global(html[data-theme='night']) .theme-toggle .tt-day {
    display: none;
  }

  :global(html[data-theme='night']) .theme-toggle .tt-night {
    display: inline;
  }

  /* ============ 夜色覆盖 ============ */
  :global(html[data-theme='night']) .nav-inner {
    background-color: rgb(31 32 28 / 94%);
  }

  :global(html[data-theme='night']) .site-header.is-scrolled .nav-inner {
    background-color: rgb(31 32 28 / 98%);
  }

  :global(html[data-theme='night']) .site-header.is-scrolled .nav-inner::before {
    background: rgb(233 226 208 / 38%);
  }

  :global(html[data-theme='night']) .nav-mobile[open] summary {
    background: rgb(233 226 208 / 10%);
  }

  :global(html[data-theme='night']) .nav-mobile-panel {
    background: rgb(31 32 28 / 98%);
    box-shadow: 0 14px 30px rgb(0 0 0 / 50%);
  }

  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
    }

    .brand {
      padding-right: 0;
      border-right: 0;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      top: 10px;
      width: calc(100% - 20px);
    }

    .site-header.is-scrolled {
      top: 6px;
      width: calc(100% - 14px);
    }

    .nav-inner {
      min-height: 60px;
      gap: 14px;
      padding: 0 12px 0 16px;
    }

    .brand {
      gap: 7px;
      font-size: 1.05rem;
      letter-spacing: 0.08em;
    }

    .brand-seal {
      width: 22px;
      font-size: 0.6rem;
    }

    .nav-list {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav-inner,
    .site-header.is-scrolled .nav-inner,
    .nav-mobile-panel {
      background-color: rgb(248 246 239);
      background-image: none;
    }

    :global(html[data-theme='night']) .nav-inner,
    :global(html[data-theme='night']) .site-header.is-scrolled .nav-inner,
    :global(html[data-theme='night']) .nav-mobile-panel {
      background-color: rgb(31 32 28);
      background-image: none;
    }
  }

  @media (prefers-contrast: more) {
    .nav-inner,
    .nav-mobile-panel {
      border-color: rgb(41 42 39 / 55%);
      background: rgb(248 246 239);
    }

    :global(html[data-theme='night']) .nav-inner,
    :global(html[data-theme='night']) .nav-mobile-panel {
      border-color: rgb(233 226 208 / 55%);
      background: rgb(31 32 28);
    }
  }
</style>

<script>
  // 注意：Swup 换页会替换 #siteHeader 元素但不重跑本脚本，
  // 因此所有 DOM 查询都在回调内即时进行，监听器只挂在 window/document 上。
  const trackedIds = ['top', 'articles', 'archive', 'about'];
  let frameRequested = false;

  const updateNavigation = () => {
    const header = document.getElementById('siteHeader');
    if (!header) return;

    header.classList.toggle('is-scrolled', window.scrollY > 18);

    if (header.dataset.home === 'true') {
      const navLinks = [...header.querySelectorAll<HTMLAnchorElement>('.nav-link')];
      const readingLine = window.scrollY + Math.min(window.innerHeight * 0.35, 280);
      let currentId = 'top';

      trackedIds.forEach((id) => {
        const section = document.getElementById(id);
        if (section && section.getBoundingClientRect().top + window.scrollY <= readingLine) {
          currentId = id;
        }
      });

      navLinks.forEach((link) => {
        if (link.getAttribute('href') === `#${currentId}`) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    frameRequested = false;
  };

  const requestNavigationUpdate = () => {
    if (!frameRequested) {
      frameRequested = true;
      requestAnimationFrame(updateNavigation);
    }
  };

  updateNavigation();
  window.addEventListener('scroll', requestNavigationUpdate, { passive: true });
  document.addEventListener('swup:page:view', requestNavigationUpdate);

  // 移动端菜单：点击链接后收起（事件委托，兼容 Swup 替换 header）
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest?.('#navMenu .nav-link');
    if (link) {
      document.getElementById('navMenu')?.removeAttribute('open');
    }
  });
</script>
