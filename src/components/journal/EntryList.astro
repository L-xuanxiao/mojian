---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateISO } from '../../utils/date';
import { readingStats } from '../../utils/reading';
import { withBase } from '../../site.config';

interface Props {
  posts: CollectionEntry<'journal'>[];
  variant?: 'feature' | 'catalog' | 'compact';
  startIndex?: number;
}

const { posts, variant = 'catalog', startIndex = 0 } = Astro.props;
---

<ol class:list={['entry-list', `entry-list--${variant}`]} data-reveal-group>
  {
    posts.map((post, index) => (
      <li>
        <article>
          <span class="entry-index" aria-hidden="true">
            {String(startIndex + index + 1).padStart(2, '0')}
          </span>
          <div class="entry-body">
            <p class="entry-kicker">
              <time datetime={formatDateISO(post.data.pubDate)}>
                {formatDate(post.data.pubDate)}
              </time>
              <a href={withBase(`/journal/category/${post.data.category}/`)}>
                {post.data.category}
              </a>
              {variant !== 'compact' && (
                <span>约 {readingStats(post.body ?? '').minutes} 分钟</span>
              )}
            </p>
            <h3>
              <a class="ink-link" href={withBase(`/journal/${post.id}/`)}>
                {post.data.title}
              </a>
            </h3>
            <p class="entry-description">{post.data.description}</p>
          </div>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry-list > li {
    position: relative;
    border-top: 1px solid var(--line);
  }

  /* 案头翻阅底色：行内自左晕开的极淡纸色，平时收起 */
  .entry-list > li::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--paper-deep) 42%, transparent);
    opacity: 0;
    transform: scaleX(0.35);
    transform-origin: left center;
    transition:
      opacity 400ms var(--ease-ink),
      transform 550ms var(--ease-ink);
    pointer-events: none;
  }

  .entry-list > li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .entry-list article {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2rem;
  }

  .entry-index {
    color: color-mix(in oklab, var(--ink) 28%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.65rem;
    line-height: 1;
    transition: color 400ms var(--ease-ink);
  }

  .entry-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.72rem;
  }

  .entry-kicker a {
    color: var(--cinnabar);
    text-decoration: none;
  }

  .entry-list h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .entry-list h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry-description {
    max-width: 40rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
  }

  .entry-list--feature > li {
    border-top: 2px solid var(--ink);
  }

  .entry-list--feature article {
    grid-template-columns: minmax(3.5rem, 1fr) minmax(0, 7fr);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .entry-list--feature .entry-index {
    font-size: clamp(3.5rem, 8vw, 7rem);
  }

  .entry-list--feature h3 {
    max-width: 12em;
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(2.3rem, 6vw, 4.8rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .entry-list--feature .entry-description {
    max-width: 32rem;
    margin-top: 1.4rem;
    font-size: 1.02rem;
  }

  .entry-list--compact article {
    grid-template-columns: 3rem minmax(0, 1fr);
    padding-block: 1.35rem;
  }

  .entry-list--compact h3 {
    font-size: 1.12rem;
  }

  .entry-list--compact .entry-description {
    display: none;
  }

  /* 案头翻阅：hover / 键盘聚焦时纸色晕开、编号落朱砂；主稿编号大，朱砂调淡 */
  @media (hover: hover) and (pointer: fine) {
    .entry-list > li:hover::before,
    .entry-list > li:focus-within::before {
      opacity: 1;
      transform: scaleX(1);
    }

    .entry-list > li:hover .entry-index,
    .entry-list > li:focus-within .entry-index {
      color: var(--cinnabar);
    }

    .entry-list--feature > li:hover .entry-index,
    .entry-list--feature > li:focus-within .entry-index {
      color: color-mix(in oklab, var(--cinnabar) 55%, transparent);
    }
  }

  @media (max-width: 639px) {
    .entry-list article,
    .entry-list--feature article,
    .entry-list--compact article {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .entry-list--feature .entry-index {
      font-size: 2.2rem;
    }

    .entry-list--feature h3 {
      font-size: clamp(2.1rem, 12vw, 3.2rem);
    }

    .entry-description {
      font-size: 0.92rem;
    }
  }
</style>
