---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDateISO } from '../../utils/date';
import { readingStats } from '../../utils/reading';
import { withBase } from '../../site.config';

interface Props {
  posts: CollectionEntry<'journal'>[];
  variant?: 'feature' | 'catalog' | 'compact';
  startIndex?: number;
}

const { posts, variant = 'catalog', startIndex = 0 } = Astro.props;
---

<ol
  class:list={['entry-list', `entry-list--${variant}`]}
  data-reveal-group
  data-reveal-variant={variant === 'feature' ? 'spread' : 'stagger'}
>
  {
    posts.map((post, index) => (
      <li>
        <article>
          <span class="entry-index" aria-hidden="true">
            {String(startIndex + index + 1).padStart(2, '0')}
          </span>
          <div class="entry-body">
            <p class="entry-kicker">
              <time datetime={formatDateISO(post.data.pubDate)}>
                {formatDate(post.data.pubDate)}
              </time>
              <a href={withBase(`/journal/category/${post.data.category}/`)}>
                {post.data.category}
              </a>
              {variant !== 'compact' && (
                <span>约 {readingStats(post.body ?? '').minutes} 分钟</span>
              )}
            </p>
            <h3>
              <a class="ink-link" href={withBase(`/journal/${post.id}/`)}>
                {post.data.title}
              </a>
            </h3>
            <p class="entry-description">{post.data.description}</p>
          </div>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry-list > li {
    position: relative;
    border-top: 1px solid var(--line);
  }

  /* 案头翻阅底色：行内自左晕开的极淡纸色，平时收起 */
  .entry-list > li::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--paper-deep) 42%, transparent);
    opacity: 0;
    transform: scaleX(0.35);
    transform-origin: left center;
    transition:
      opacity 250ms var(--ease-ink),
      transform 250ms var(--ease-ink);
    pointer-events: none;
  }

  .entry-list > li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .entry-list article {
    position: relative;
    display: grid;
    grid-template-columns: clamp(3.5rem, 6vw, 5.5rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: 2rem;
  }

  .entry-index {
    color: color-mix(in oklab, var(--ink) 28%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.65rem;
    line-height: 1;
    transition: color 250ms var(--ease-ink);
  }

  .entry-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.72rem;
  }

  .entry-kicker a {
    color: var(--cinnabar);
    text-decoration: none;
  }

  .entry-list h3 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .entry-list h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry-description {
    max-width: 40rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
  }

  .entry-list--feature > li {
    border-top: 2px solid var(--ink);
  }

  .entry-list--feature article {
    display: block;
    min-height: clamp(16rem, 24vw, 24rem);
    padding: clamp(2.5rem, 4vw, 3.5rem) 0 clamp(2.5rem, 4vw, 3.5rem) clamp(2.5rem, 7vw, 6rem);
  }

  .entry-list--feature .entry-index {
    position: absolute;
    top: 0.18em;
    left: -0.03em;
    color: color-mix(in oklab, var(--cinnabar) 18%, transparent);
    font-size: var(--type-glyph-chapter);
    line-height: 0.9;
  }

  .entry-list--feature .entry-body {
    position: relative;
    z-index: 1;
  }

  .entry-list--feature h3 {
    max-width: 12em;
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-title-card);
    font-weight: 400;
    line-height: 1.15;
  }

  .entry-list--feature .entry-description {
    max-width: 32rem;
    margin-top: 1.4rem;
    font-size: 1.02rem;
  }

  .entry-list--compact article {
    grid-template-columns: 3rem minmax(0, 1fr);
    padding-block: 1.35rem;
  }

  .entry-list--compact h3 {
    font-size: 1.12rem;
  }

  .entry-list--compact .entry-description {
    display: none;
  }

  /* 案头翻阅：hover / 键盘聚焦时纸色晕开、编号落朱砂；主稿编号大，朱砂调淡 */
  @media (hover: hover) and (pointer: fine) {
    .entry-list > li:hover::before,
    .entry-list > li:focus-within::before {
      opacity: 1;
      transform: scaleX(1);
    }

    .entry-list > li:hover .entry-index,
    .entry-list > li:focus-within .entry-index {
      color: var(--cinnabar);
    }

    .entry-list--feature > li:hover .entry-index,
    .entry-list--feature > li:focus-within .entry-index {
      color: color-mix(in oklab, var(--cinnabar) 55%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-list > li::before {
      opacity: 0;
      transform: scaleX(1);
      transition: opacity 150ms var(--ease-ink);
    }

    .entry-list > li:hover::before,
    .entry-list > li:focus-within::before {
      opacity: 1;
      transform: scaleX(1);
    }

    .entry-index {
      transition: color 150ms var(--ease-ink);
    }
  }

  @media (max-width: 767px) {
    .entry-list--feature article {
      min-height: 0;
      padding: 3rem 0 2rem;
    }

    .entry-list--feature .entry-index {
      top: 0.2rem;
      font-size: 5.5rem;
    }

    .entry-list--feature h3 {
      font-size: var(--type-title-card);
    }
  }

  @media (max-width: 639px) {
    .entry-list article,
    .entry-list--feature article,
    .entry-list--compact article {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .entry-list--feature .entry-index {
      font-size: 2.2rem;
    }

    .entry-list--feature h3 {
      font-size: var(--type-title-card);
    }

    .entry-description {
      font-size: 0.92rem;
    }
  }
</style>
