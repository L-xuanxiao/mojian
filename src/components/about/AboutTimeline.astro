---
import SectionHeading from '../SectionHeading.astro';
import { aboutMilestones } from './about-timeline.data';

// 行年条目维护于 ./about-timeline.data.ts；为空时渲染空态，不渲染墨线列表
---

<section class="about-timeline" aria-labelledby="about-timeline-heading">
  <SectionHeading id="about-timeline-heading" title="行年" note="CHRONICLE" />

  <div class="about-timeline__grid">
    <div class="about-timeline__intro">
      <p class="folio-label">逐年所记</p>
      <p>年谱不是履历，是纸上逐年留下的墨痕。浓淡缓急，皆成此卷。</p>
    </div>

    {
      aboutMilestones.length > 0 ? (
        <ol class="about-timeline__list" data-reveal-group>
          <li class="about-timeline__line" aria-hidden="true" />
          {aboutMilestones.map(({ year, title, event }) => (
            <li class="about-timeline__item">
              <time datetime={year}>{year}</time>
              <div class="about-timeline__entry">
                <h3>{title}</h3>
                <p>{event}</p>
              </div>
            </li>
          ))}
          <li class="about-timeline__continued" aria-hidden="true">
            <span>未完待续</span>
          </li>
        </ol>
      ) : (
        <p class="about-timeline__empty">
          <span>行年待记</span>
        </p>
      )
    }
  </div>
</section>

<style>
  .about-timeline__grid {
    display: grid;
    grid-template-columns: minmax(13rem, 3fr) minmax(0, 8fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .about-timeline__intro > .folio-label {
    margin: 0 0 1.5rem;
  }

  .about-timeline__intro > p:not(.folio-label) {
    max-width: 20rem;
    margin: 0;
    color: var(--ink-soft);
  }

  /* 纵向墨线：与首页两列年谱网格相区别，取编年体自上而下之意 */
  .about-timeline__list {
    position: relative;
    margin: 0;
    padding: 0 0 0 2.5rem;
    list-style: none;
  }

  /* 墨线为独立元素：无 JS 时完整呈现，有 JS 时随滚动自顶向下「写」出 */
  .about-timeline__line {
    position: absolute;
    top: 0.4rem;
    bottom: 4.5rem;
    left: 0.45rem;
    width: 1px;
    background: linear-gradient(180deg, var(--ink), var(--line) 80%, transparent);
    transform-origin: top center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .about-timeline__line {
      transform: scaleY(0);
    }
  }

  .about-timeline__list li:not(.about-timeline__line) {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    padding-bottom: 2.75rem;
  }

  /* 墨点节点：默认空心；滚动入视口时 JS 加 .is-inked，填墨并晕开一圈朱砂 */
  .about-timeline__item::before,
  .about-timeline__item::after {
    content: '';
    position: absolute;
    top: 0.42rem;
    left: -2.5rem;
    width: 0.72rem;
    height: 0.72rem;
    margin-left: 0.09rem;
    border-radius: 50%;
  }

  .about-timeline__item::before {
    background: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--ink);
    transition: background 400ms var(--ease-ink);
  }

  .about-timeline__item::after {
    border: 1px solid var(--cinnabar);
    opacity: 0;
    pointer-events: none;
  }

  .about-timeline__item.is-inked::before {
    background: var(--ink);
  }

  .about-timeline__item.is-inked::after {
    animation: node-halo 700ms var(--ease-ink) forwards;
  }

  @keyframes node-halo {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  .about-timeline__list time {
    color: var(--bronze);
    font-family: var(--font-ma-shan-zheng);
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .about-timeline__entry h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .about-timeline__entry p {
    max-width: 30rem;
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .about-timeline__empty {
    margin: 0;
  }

  /* 「未完待续」与空态「行年待记」共用闲笔题字样 */
  .about-timeline__continued span,
  .about-timeline__empty span {
    display: inline-block;
    color: color-mix(in oklab, var(--ink) 24%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    letter-spacing: 0.12em;
    transform: rotate(-2deg);
  }

  @media (max-width: 767px) {
    .about-timeline__grid {
      display: block;
    }

    .about-timeline__intro {
      margin-bottom: 3rem;
    }

    .about-timeline__list li:not(.about-timeline__line) {
      grid-template-columns: 3.5rem 1fr;
      gap: 1rem;
      padding-bottom: 2.25rem;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/scroll';

  // 年谱叙事：墨线随滚动自顶向下写出；节点入视口时落墨（once，不回退）
  // reduced-motion 或无 JS 时保持静态完整呈现（墨线预置 scaleY(0) 仅在 html.js + no-preference 下生效）
  if (!prefersReducedMotion) {
    const list = document.querySelector<HTMLElement>('.about-timeline__list');
    if (list) {
      const line = list.querySelector<HTMLElement>('.about-timeline__line');
      if (line) {
        gsap.to(line, {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: { trigger: list, start: 'top 78%', end: 'bottom 62%', scrub: true },
        });
      }
      list.querySelectorAll<HTMLElement>('.about-timeline__item').forEach((item) => {
        ScrollTrigger.create({
          trigger: item,
          start: 'top 80%',
          once: true,
          onEnter: () => item.classList.add('is-inked'),
        });
      });
    }
  }
</script>
