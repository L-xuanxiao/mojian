---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = '墨笺', description = '融合东方美学、个人内容与现代网页体验的数字空间。' } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-noto-serif" preload />
    <Font cssVariable="--font-noto-sans" />
    <Font cssVariable="--font-ma-shan-zheng" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
