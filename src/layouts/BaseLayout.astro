---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = '墨笺', description = '融合东方美学、个人内容与现代网页体验的数字空间。' } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // 防 FOUC：渲染前恢复手动选择的主题；无存储时不设属性，交给媒体查询
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') {
        document.documentElement.dataset.theme = theme;
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-noto-serif" preload />
    <Font cssVariable="--font-noto-sans" />
    <Font cssVariable="--font-ma-shan-zheng" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      // 全站平滑滚动底座（prefers-reduced-motion 时内部自动跳过 Lenis）
      import '../scripts/scroll';
    </script>
  </body>
</html>
