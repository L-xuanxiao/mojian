---
import { getCollection } from 'astro:content';
import PageIntro from '../../../components/PageIntro.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../site.config';

const posts = await getCollection('journal', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="标签总览 · 笺录" description="全部文章标签。">
  <main class="mx-auto max-w-stage px-5 md:px-8 lg:px-10">
    <PageIntro
      id="tags"
      title="标签总览"
      note="INDEX OF MARKS"
      description="像翻一册印谱，从反复出现的主题重新进入文章。"
      variant="compact"
    >
      <p slot="meta" class="m-0">
        共 {tags.length} 枚 · <a class="page-backlink" href={withBase('/journal/')}>返回笺录</a>
      </p>
    </PageIntro>

    <ol class="tag-index" data-reveal-group data-reveal-variant="stagger">
      {
        tags.map(([tag, count], index) => (
          <li>
            <a href={withBase(`/journal/tags/${tag}/`)}>
              <span class="tag-index__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="tag-index__name">{tag}</span>
              <span class="tag-index__count">{String(count).padStart(2, '0')} 篇</span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .tag-index {
    display: block;
    margin: 0 0 clamp(6rem, 12vw, 10rem);
    padding: 0;
    border-top: 2px solid var(--ink);
    list-style: none;
  }

  .tag-index li {
    border-bottom: 1px solid var(--line);
  }

  .tag-index a {
    display: grid;
    grid-template-columns: minmax(4.5rem, 1fr) minmax(0, 7fr) minmax(4rem, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: baseline;
    padding-block: clamp(1.4rem, 3vw, 2.4rem);
    color: var(--ink);
    text-decoration: none;
    transition:
      color 150ms var(--ease-ink),
      transform 250ms var(--ease-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .tag-index a:hover {
      transform: translateX(0.35rem);
    }
  }

  .tag-index__number {
    color: color-mix(in oklab, var(--cinnabar) 48%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    line-height: 0.75;
  }

  .tag-index__name {
    font-family: var(--font-ma-shan-zheng);
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1;
  }

  .tag-index__count {
    color: var(--ink-soft);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
  }

  @media (max-width: 639px) {
    .tag-index {
      display: block;
    }

    .tag-index a {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 0.75rem;
      padding-block: 1.5rem;
    }

    .tag-index__number {
      font-size: 2.6rem;
    }

    .tag-index__name {
      font-size: clamp(1.9rem, 10vw, 3.2rem);
    }
  }
</style>
