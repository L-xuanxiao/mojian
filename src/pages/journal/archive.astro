---
// 年谱归档：文章按年份分组，取谱牒编年之意
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EntryList from '../../components/journal/EntryList.astro';
import { withBase } from '../../site.config';
import { getJournalPosts } from '../../utils/journal';

const posts = await getJournalPosts();

// 按年份倒序分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  const group = byYear.get(year);
  if (group) group.push(post);
  else byYear.set(year, [post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="年谱归档 · 笺录" description="全部文章按年份编年。">
  <main class="mx-auto max-w-stage px-5 md:px-8 lg:px-10">
    <PageIntro
      id="archive"
      title="年谱归档"
      glyph="年"
      note="CHRONICLE"
      description="按年份重新翻阅旧墨。每一篇都有它落纸的时节。"
      variant="compact"
      scene="reading"
      artTreatment="ink-glyph"
    >
      <p slot="meta" class="m-0">
        共 {posts.length} 篇 · <a class="ink-link" href={withBase('/journal/')}>返回笺录</a>
      </p>
    </PageIntro>

    <div class="archive-years" data-reveal-group data-reveal-variant="spread">
      {
        years.map((year) => (
          <section class="archive-year" aria-labelledby={`year-${year}`}>
            <div class="archive-year__title">
              <p class="folio-label">ANNO</p>
              <h2 id={`year-${year}`} data-reveal-title>
                {year}
              </h2>
            </div>
            <EntryList posts={byYear.get(year)!} variant="compact" />
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .archive-years {
    padding-block: 1rem clamp(4rem, 7vw, 6rem);
  }

  .archive-year {
    display: grid;
    grid-template-columns: minmax(13rem, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .archive-year:first-child {
    border-top-width: 2px;
    border-top-color: var(--ink);
  }

  .archive-year__title {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .archive-year__title > .folio-label {
    margin: 0 0 1rem;
  }

  .archive-year h2 {
    margin: 0;
    color: color-mix(in oklab, var(--ink) 34%, transparent);
    font-family: var(--font-ma-shan-zheng);
    font-size: var(--type-title-chapter);
    font-weight: 400;
    line-height: 0.72;
    letter-spacing: -0.06em;
  }

  @media (max-width: 767px) {
    .archive-year {
      display: block;
    }

    .archive-year__title {
      position: static;
      margin-bottom: 2.5rem;
    }

    .archive-year h2 {
      font-size: var(--type-title-chapter);
    }
  }
</style>
