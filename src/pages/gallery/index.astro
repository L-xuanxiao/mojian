---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import GalleryLightbox from '../../components/gallery/GalleryLightbox';
import { withBase } from '../../site.config';

const entries = (await getCollection('gallery', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const thumbWidth = Math.min(840, entry.data.image.width);
    const [thumb, full] = await Promise.all([
      getImage({ src: entry.data.image, width: thumbWidth, format: 'avif', quality: 76 }),
      getImage({ src: entry.data.image, format: 'avif', quality: 88 }),
    ]);
    return {
      id: entry.id,
      title: entry.data.title,
      description: entry.data.description,
      alt: entry.data.alt,
      thumb: thumb.src,
      src: full.src,
      width: entry.data.image.width,
      height: entry.data.image.height,
      year: entry.data.year,
      medium: entry.data.medium,
      orientation: entry.data.orientation,
      projectHref: entry.data.project ? withBase(`/projects/${entry.data.project.id}/`) : undefined,
    };
  }),
);
---

<BaseLayout title="光影 · 墨笺" description="摄影与概念影像：光、纸、山水与四时的视觉札记。">
  <main>
    <div class="darkroom gallery-folio" data-ink-scene="darkroom">
      <div class="mx-auto max-w-stage px-5 md:px-8 lg:px-10">
        <PageIntro
          id="gallery"
          title="光影"
          note="IMAGE FOLIO"
          description="以光为墨，收存纸张的肌理、山水的层次与四时一瞬。点击画面，可入暗室细看。"
          scene="darkroom"
        >
          <p slot="meta" class="m-0">共 {String(items.length).padStart(2, '0')} 幅 · 概念影像</p>
        </PageIntro>
      </div>

      <div class="gallery-stage mx-auto max-w-stage px-5 md:px-8 lg:px-10">
        <GalleryLightbox items={items} client:load />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .gallery-folio {
    margin-top: -1px;
  }

  .gallery-stage {
    padding-block: 2rem clamp(7rem, 14vw, 12rem);
  }
</style>
