---
import AboutSection from '../components/home/AboutSection.astro';
import DeskNotes from '../components/home/DeskNotes.astro';
import HeroSection from '../components/home/HeroSection.astro';
import RecentNotes from '../components/home/RecentNotes.astro';
import StudyIndex from '../components/home/StudyIndex.astro';
import { siteConfig } from '../config/siteConfig';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, siteConfig.postList.recentCount);
const latestPost = recentPosts[0];
// 书斋目录各分类篇数：随已发布文章自动变化，draft 不计
const categoryCounts = new Map(
  siteConfig.categories.map((cat) => [
    cat.key,
    allPosts.filter((post) => post.data.category === cat.key).length,
  ]),
);
// 站点统计（见 CONTEXT.md）：全部由文章数据派生，不手工维护
const stats = {
  posts: allPosts.length,
  categories: siteConfig.categories.length,
  sinceYear: allPosts.length
    ? Math.min(...allPosts.map((post) => post.data.pubDate.getFullYear()))
    : new Date().getFullYear(),
};
---

<style>
  /* 借鉴 Firefly 的侧栏骨架，按宽度渐进重排现有内容；
     区块 grid-area 归属与区块内覆盖随样式拆入各 home/ 组件，
     共享的 .section/.section-heading 组样式在 global.css。 */
  @media (min-width: 821px) {
    .home-layout {
      position: relative;
      z-index: 6;
      width: min(calc(100% - (var(--side-space) * 2)), 1220px);
      margin: 24px auto 0;
      display: grid;
      align-items: start;
      gap: 24px;
    }
  }

  @media (min-width: 821px) and (max-width: 1439px) {
    .home-layout {
      grid-template-columns: clamp(210px, 22vw, 280px) minmax(0, 1fr);
      grid-template-areas:
        "study latest"
        "desk desk";
    }
  }

  @media (min-width: 1440px) {
    .home-layout {
      width: min(calc(100% - (var(--side-space) * 2)), 1480px);
      grid-template-columns: clamp(240px, 18vw, 280px) minmax(620px, 1fr) clamp(260px, 19vw, 300px);
      grid-template-areas:
        "study latest desk";
    }
  }
</style>

<BaseLayout title="墨笺" description="墨笺，一处记录日常、山川、旧书与生活片段的个人博客。">
  <div id="top">
    <HeroSection latestPost={latestPost} />
    <div class="home-layout">
      <StudyIndex categories={siteConfig.categories} counts={categoryCounts} />
      <RecentNotes posts={recentPosts} />
      <DeskNotes />
    </div>
    <AboutSection stats={stats} />
  </div>
</BaseLayout>
