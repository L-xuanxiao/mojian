---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import lostArtwork from '../assets/art/hero-paper-mountains.webp';
import { withBase } from '../site.config';
---

<BaseLayout title="迷途 · 墨笺" description="此处无卷：你要寻的那一页，或已散佚，或从未写就。">
  <main class="mx-auto max-w-stage px-5 md:px-8 lg:px-10">
    <section class="lost" aria-labelledby="lost-heading">
      <div class="lost__copy" data-reveal-group>
        <p class="folio-label">404 / 迷途</p>
        <h1 id="lost-heading" class="font-display" data-reveal-title>此处无卷</h1>
        <p class="lost__note">你要寻的那一页，或已散佚，或从未写就。山水之间，不妨原路折返。</p>
        <nav class="lost__nav" aria-label="折返">
          <a class="btn" href={withBase('/')}>返回卷首</a>
          <a class="btn btn--ghost" href={withBase('/journal/')}>往笺录</a>
        </nav>
      </div>

      <figure class="lost__art media-reveal" aria-hidden="true">
        <Image
          src={lostArtwork}
          alt=""
          widths={[720, 1080]}
          sizes="(min-width: 1024px) 44vw, 100vw"
          quality={86}
          loading="eager"
        />
        <figcaption>纸山 · 迷途</figcaption>
      </figure>
    </section>
  </main>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    min-height: calc(100svh - 5rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .lost::before {
    position: absolute;
    inset: 9% 3% 13% 38%;
    border: 1px solid var(--line);
    content: '';
    pointer-events: none;
  }

  .lost__copy {
    z-index: 2;
    grid-column: 1 / span 7;
  }

  .lost__copy > .folio-label {
    margin: 0 0 1.5rem;
  }

  .lost__copy h1 {
    margin: 0;
    font-size: clamp(5rem, 12vw, 10rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.02em;
  }

  .lost__note {
    max-width: 26rem;
    margin: 1.75rem 0 0;
    color: var(--ink-soft);
  }

  .lost__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.75rem;
  }

  .lost__art {
    z-index: 1;
    grid-column: 6 / -1;
    grid-row: 1;
    width: calc(100% + clamp(1rem, 4vw, 4rem));
    margin: 0;
    overflow: hidden;
    padding: clamp(0.55rem, 1.2vw, 0.9rem);
    background: var(--paper-deep);
    box-shadow: var(--shadow-lg);
    transform: translateY(clamp(2rem, 7vw, 6rem));
  }

  .lost__art img {
    display: block;
    width: 100%;
  }

  .lost__art figcaption {
    padding-top: 0.7rem;
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-align: right;
  }

  @media (max-width: 767px) {
    .lost {
      display: block;
      min-height: 0;
      padding-block: 4rem 6rem;
    }

    .lost::before {
      inset: 2rem 0 auto 18%;
      height: 16rem;
    }

    .lost__copy {
      position: relative;
    }

    .lost__art {
      width: calc(100% + 1.25rem);
      margin-top: 3rem;
      transform: none;
    }
  }
</style>
