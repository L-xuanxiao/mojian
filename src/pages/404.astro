---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import lostArtwork from '../assets/art/hero-paper-mountains.webp';
import { withBase } from '../site.config';
---

<BaseLayout title="迷途 · 墨笺" description="此处无卷：你要寻的那一页，或已散佚，或从未写就。">
  <main class="mx-auto max-w-stage px-5 md:px-8 lg:px-10">
    <section class="lost" aria-labelledby="lost-heading">
      <div class="lost__copy" data-reveal-group>
        <p class="folio-label">404 / 迷途</p>
        <h1 id="lost-heading" class="font-display" data-reveal-title>此处无卷</h1>
        <p class="lost__note">你要寻的那一页，或已散佚，或从未写就。山水之间，不妨原路折返。</p>
        <nav class="lost__nav" aria-label="折返">
          <a class="btn" href={withBase('/')}>返回卷首</a>
          <a class="btn btn--ghost" href={withBase('/journal/')}>往笺录</a>
        </nav>
      </div>

      <figure class="lost__art media-reveal" aria-hidden="true">
        <Image
          src={lostArtwork}
          alt=""
          widths={[720, 1080]}
          sizes="(min-width: 1024px) 44vw, 100vw"
          quality={86}
          loading="eager"
        />
        <figcaption>纸山 · 迷途</figcaption>
      </figure>
    </section>
  </main>
</BaseLayout>

<style>
  .lost {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(5rem, 11vw, 10rem) clamp(7rem, 14vw, 12rem);
  }

  .lost__copy > .folio-label {
    margin: 0 0 1.5rem;
  }

  .lost__copy h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6.5rem);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .lost__note {
    max-width: 26rem;
    margin: 1.75rem 0 0;
    color: var(--ink-soft);
  }

  .lost__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.75rem;
  }

  .lost__art {
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--ink) 22%, transparent);
    padding: clamp(0.55rem, 1.2vw, 0.9rem);
    background: var(--paper);
    box-shadow: var(--shadow-lg);
  }

  .lost__art img {
    display: block;
    width: 100%;
  }

  .lost__art figcaption {
    padding-top: 0.7rem;
    color: var(--bronze);
    font-family: var(--font-noto-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-align: right;
  }

  @media (max-width: 767px) {
    .lost {
      display: block;
      padding-block: 4rem 6rem;
    }

    .lost__art {
      margin-top: 3rem;
    }
  }
</style>
