{
  "name": "mojian",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "test": "pnpm test:e2e",
    "test:e2e": "astro build && node scripts/run-e2e.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css,md,mdx}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.{ts,tsx}\" \"*.{json,mjs,md,ts,yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css,md,mdx}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.{ts,tsx}\" \"*.{json,mjs,md,ts,yaml,yml}\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.29.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pagefind": "^1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^6.0.3"
  }
}
